{% doc %}
  @prompt
    Generate a NEW product section. Colour scheme: Oat.
    Heading: "Best sellers". Button: "Shop all".
    Show four products from all products, sorted by best selling. 2 by 2 on mobile, 4 across on desktop.
    Use the theme's own product card and quick add. Style them, do not rebuild them. Card: 4:5 image, 20px radius, title in 15px (two lines), price in 16px bold. A badge ("New" or "Best seller") in Kry maroon from the product tag. Quick add is a 44px round Bamboo button on the image.
    Generate no images. Photos and prices come from the store.
    Add a "Show this section" checkbox, on by default., allow me to connect products and show demo skeletons, manage left and right side spacings, product are not visible while connected, show in bento grid style , Make this section look more catchy and aesthetic, show the price and product name in product image use glassmorph to shos , adjust the font size, and make this section more detailed and catchy , now allow me change all the texts in this section in rich style texts and background color for this section and border color of bento cards, remove curved corner from this section, add hover to reveil price and product name on each card the name and price should appear fade in on hover and hover our fade out, for this section in mobile show 1 2 1 layout proper even
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign source_products = block.settings.products %}
{% assign all_collection = collections['all'] %}
{% style %}
  .ai-best-sellers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 40px {{ block.settings.side_spacing }}px;
    background: {{ block.settings.background_color }};
    color: #37251f;
  }
  .ai-best-sellers-{{ ai_gen_id }}[hidden] { display: none; }
  .ai-best-sellers-{{ ai_gen_id }}__head { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:24px; }
  .ai-best-sellers-{{ ai_gen_id }}__title { margin:0; font-size:clamp(28px,4vw,44px); line-height:1.05; color:inherit; }
  .ai-best-sellers-{{ ai_gen_id }}__intro { margin:8px 0 0; }
  .ai-best-sellers-{{ ai_gen_id }}__link { display:inline-flex; align-items:center; justify-content:center; padding:12px 22px; color:#fff; background:#54232f; border-radius:100px; text-decoration:none; font-weight:600; white-space:nowrap; }
  .ai-best-sellers-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
  .ai-best-sellers-{{ ai_gen_id }}__card { position:relative; overflow:hidden; border:1px solid {{ block.settings.card_border }}; border-radius:20px; background:rgba(255,255,255,.3); min-width:0; }
  .ai-best-sellers-{{ ai_gen_id }}__media { position:relative; aspect-ratio:4/5; overflow:hidden; }
  .ai-best-sellers-{{ ai_gen_id }}__media img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-best-sellers-{{ ai_gen_id }}__overlay { position:absolute; inset:auto 10px 10px; padding:12px; border-radius:14px; background:rgba(255,255,255,.78); color:#30201d; backdrop-filter:blur(12px); opacity:0; transform:translateY(8px); transition:opacity .22s ease,transform .22s ease; pointer-events:none; }
  .ai-best-sellers-{{ ai_gen_id }}__card:hover .ai-best-sellers-{{ ai_gen_id }}__overlay,.ai-best-sellers-{{ ai_gen_id }}__card:focus-within .ai-best-sellers-{{ ai_gen_id }}__overlay { opacity:1; transform:translateY(0); }
  .ai-best-sellers-{{ ai_gen_id }}__name { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin:0 0 5px; font-size:15px; line-height:1.3; font-weight:600; }
  .ai-best-sellers-{{ ai_gen_id }}__price { margin:0; font-size:16px; font-weight:700; }
  .ai-best-sellers-{{ ai_gen_id }}__badge { position:absolute; top:12px; left:12px; z-index:2; padding:6px 10px; border-radius:99px; background:#54232f; color:#fff; font-size:12px; }
  .ai-best-sellers-{{ ai_gen_id }}__quick { position:absolute; right:12px; bottom:12px; z-index:3; width:44px; height:44px; display:grid; place-items:center; border:0; border-radius:50%; background:#d9d0b8; color:#30201d; text-decoration:none; font-size:24px; }
  .ai-best-sellers-{{ ai_gen_id }}__quick:focus-visible,.ai-best-sellers-{{ ai_gen_id }}__link:focus-visible { outline:3px solid #54232f; outline-offset:3px; }
  .ai-best-sellers-{{ ai_gen_id }}__skeleton { aspect-ratio:4/5; background:linear-gradient(135deg,#e6dfce,#f5f0e6); display:grid; place-items:center; color:#544a3f; }
  @media (hover:none) { .ai-best-sellers-{{ ai_gen_id }}__overlay { opacity:1; transform:none; } }
  @media(max-width:749px) {
    .ai-best-sellers-{{ ai_gen_id }} { padding:30px {{ block.settings.mobile_spacing }}px; }
    .ai-best-sellers-{{ ai_gen_id }}__grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    .ai-best-sellers-{{ ai_gen_id }}__head { align-items:start; }
    .ai-best-sellers-{{ ai_gen_id }}__link { padding:10px 15px; }
  }
  @media(prefers-reduced-motion:reduce) { .ai-best-sellers-{{ ai_gen_id }}__overlay { transition:none; } }
{% endstyle %}
<div class="ai-best-sellers-{{ ai_gen_id }}" {% unless block.settings.show_section %}hidden{% endunless %} {{ block.shopify_attributes }}>
  <div class="ai-best-sellers-{{ ai_gen_id }}__head">
    <div>{% if block.settings.heading != blank %}<h2 class="ai-best-sellers-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-best-sellers-{{ ai_gen_id }}__intro">{{ block.settings.description }}</div>{% endif %}</div>
    {% if block.settings.shop_link != blank %}<a class="ai-best-sellers-{{ ai_gen_id }}__link" href="{{ block.settings.shop_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
  </div>
  <div class="ai-best-sellers-{{ ai_gen_id }}__grid">
    {% if source_products != blank %}
      {% for product in source_products limit: 4 %}
        <article class="ai-best-sellers-{{ ai_gen_id }}__card">
          <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <div class="ai-best-sellers-{{ ai_gen_id }}__media">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}
              {% for tag in product.tags %}{% assign tag_lower = tag | downcase %}{% if tag_lower == 'new' or tag_lower == 'best seller' or tag_lower == 'bestseller' %}<span class="ai-best-sellers-{{ ai_gen_id }}__badge">{% if tag_lower == 'new' %}New{% else %}Best seller{% endif %}</span>{% break %}{% endif %}{% endfor %}
              <div class="ai-best-sellers-{{ ai_gen_id }}__overlay"><p class="ai-best-sellers-{{ ai_gen_id }}__name">{{ product.title | escape }}</p><p class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div>
            </div>
          </a>
          <a class="ai-best-sellers-{{ ai_gen_id }}__quick" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">+</a>
        </article>
      {% endfor %}
    {% elsif block.settings.show_demo %}
      {% for i in (1..4) %}<div class="ai-best-sellers-{{ ai_gen_id }}__card"><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton">Connect products to preview</div></div>{% endfor %}
    {% else %}
      {% for product in all_collection.products limit: 4 %}
        <article class="ai-best-sellers-{{ ai_gen_id }}__card"><a href="{{ product.url }}"><div class="ai-best-sellers-{{ ai_gen_id }}__media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}<div class="ai-best-sellers-{{ ai_gen_id }}__overlay"><p class="ai-best-sellers-{{ ai_gen_id }}__name">{{ product.title | escape }}</p><p class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div></div></a><a class="ai-best-sellers-{{ ai_gen_id }}__quick" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">+</a></article>
      {% endfor %}
    {% endif %}
  </div>
</div>
{% schema %}
{
  "name": "Best sellers bento",
  "settings": [
    {"type":"checkbox","id":"show_section","label":"Show this section","default":true},
    {"type":"text","id":"heading","label":"Heading","default":"Best sellers"},
    {"type":"richtext","id":"description","label":"Description","default":"<p>Thoughtful favorites, chosen for everyday comfort.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop all"},
    {"type":"url","id":"shop_link","label":"Shop all link"},
    {"type":"product_list","id":"products","label":"Products","limit":4},
    {"type":"checkbox","id":"show_demo","label":"Show demo skeletons when no products are connected","default":true},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"side_spacing","label":"Desktop side spacing","min":0,"max":60,"step":5,"unit":"px","default":20},
    {"type":"range","id":"mobile_spacing","label":"Mobile side spacing","min":0,"max":30,"step":5,"unit":"px","default":10},
    {"type":"color","id":"background_color","label":"Background","default":"#F2EEE4"},
    {"type":"color","id":"card_border","label":"Card border","default":"#D8CDB9"}
  ],
  "presets": [{"name":"Best sellers bento"}],
  "tag": null,
  "class": "best-sellers-bento"
}
{% endschema %}