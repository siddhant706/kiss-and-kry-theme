enefit 2 heading","default":"<p>Naturally breathable</p>"},{"type":"richtext","id":"feature_2_description","label":"Benefit 2 description","default":"<p>Airy fibres help keep little ones cool, calm and comfortable.</p>"},{"type":"select","id":"feature_3_icon","label":"Benefit 3 fallback icon","options":[{"value":"feather","label":"Feather"},{"value":"air","label":"Air"},{"value":"stretch","label":"Stretch"},{"value":"heart","label":"Heart"}],"default":"stretch"},{"type":"image_picker","id":"feature_3_icon_image","label":"Benefit 3 PNG icon"},{"type":"richtext","id":"feature_3_heading","label":"Benefit 3 heading","default":"<p>Stretch that moves</p>"},{"type":"richtext","id":"feature_3_description","label":"Benefit 3 description","default":"<p>A touch of spandex lets every piece move with wiggles, kicks and cuddles.</p>"},{"type":"select","id":"feature_4_icon","label":"Benefit 4 fallback icon","options":[{"value":"feather","label":"Feather"},{"value":"air","label":"Air"},{"value":"stretch","label":"Stretch"},{"value":"heart","label":"Heart"}],"default":"heart"},{"type":"image_picker","id":"feature_4_icon_image","label":"Benefit 4 PNG icon"},{"type":"richtext","id":"feature_4_heading","label":"Benefit 4 heading","default":"<p>Kind to their skin</p>"},{"type":"richtext","id":"feature_4_description","label":"Benefit 4 description","default":"<p>Smooth, soft fibres that feel gentle from the very first wear.</p>"},{"type":"header","content":"Links"},{"type":"richtext","id":"primary_label","label":"Primary button label","default":"<p>Shop bamboo essentials →</p>"},{"type":"url","id":"primary_url","label":"Primary button link"},{"type":"richtext","id":"secondary_label","label":"Secondary link label","default":"<p>Read the care guide</p>"},{"type":"url","id":"secondary_url","label":"Secondary link"},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Background","default":"#626B4C"},{"type":"color","id":"text_color","label":"Primary text","default":"#F5F2E8"},{"type":"color","id":"secondary_text_color","label":"Secondary text","default":"#D0D0B9"},{"type":"color","id":"badge_color","label":"Badge","default":"#F2B52F"},{"type":"color","id":"badge_text_color","label":"Badge text","default":"#343923"},{"type":"color","id":"icon_color","label":"Icons","default":"#DDAA32"},{"type":"color","id":"ring_color","label":"Decorative outline","default":"#D0D0B9"},{"type":"color","id":"button_color","label":"Button background","default":"#F5F2E8"},{"type":"color","id":"button_text_color","label":"Button text","default":"#343923"}],"presets":[{"name":"Why we chose bamboo"}],"tag":null,"class":"why-we-chose-bamboo"}
