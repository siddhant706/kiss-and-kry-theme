{% doc %}
  @prompt
    generate a full page width section to show products in quick view use bento grid for 4 products , increase size of product 1 vertically and product 4 as well so that product 4 comes below of 2 and 3 fully, keep product 2 and 3 together parallel, perfect now add heading of this section on top left as 
    Everyday Essentials,
    Made Soft.
    and an eyebrow as well all the text as rich text, now on each product card add a label on top left for product 1 BEDDING and for rest BAMBOO, Now on product one at the top left add a circle PNG placeholder to add trust indicator and for the rest add a heart as wishlist, trust badge on top right of product 1 and increase size by 40%, decrease the size of bedding and bamboo labels, and place perfect all top left , now same as 2 and 3 add 5 just right of 4, add product 5 same size of 4 and parallel, remove quick view buttons , replace view product with add to cart and small size and on bottom right of all product cards, instead of using full word add to cart use add and cart icon , for the product 1 increase product name font by 40% and for rest Four product decrease by 40% and bold, all me to manage all the products name font size as rich text, increase product font size for product 2 to 5 by 30%, for product 2 to 5 place all the info and button below product cards, now curve all the product card borders by 30%, curve all the product cards eqaully, curve card border for product 2 to 5 as well same as 1, add eyebrow text just above names of product 2 to 5 as BODYSUITS , decrease eyebrow texts size by 50%, on product 1 below product name add 2 lines description about product , on product 1 manage the gap between texts and pricing, on product 1 price in bold and yellow color and on the right side of pricing "add to cart" with icon a complete button then on right view product details link
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-bento-{{ ai_gen_id }}{display:block;width:100%;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};--radius:{{ block.settings.card_radius | times: 1.3 }}px}.ai-bento-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1400px;margin:auto}.ai-bento-{{ ai_gen_id }}__eyebrow{margin:0 0 8px;font-size:7px;line-height:1.4}.ai-bento-{{ ai_gen_id }}__eyebrow p,.ai-bento-{{ ai_gen_id }}__heading p{margin:0}.ai-bento-{{ ai_gen_id }}__heading{margin:0 0 28px;font-size:clamp(32px,5vw,64px);line-height:1.05}.ai-bento-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(2,minmax(340px,auto));gap:14px}.ai-bento-{{ ai_gen_id }}__card{position:relative;overflow:hidden;min-width:0;border-radius:var(--radius);background:#eee}.ai-bento-{{ ai_gen_id }}__card:nth-child(1){grid-column:1/span 2;grid-row:1/span 2}.ai-bento-{{ ai_gen_id }}__card:nth-child(2){grid-column:3;grid-row:1}.ai-bento-{{ ai_gen_id }}__card:nth-child(3){grid-column:4;grid-row:1}.ai-bento-{{ ai_gen_id }}__card:nth-child(4){grid-column:3;grid-row:2}.ai-bento-{{ ai_gen_id }}__card:nth-child(5){grid-column:4;grid-row:2}.ai-bento-{{ ai_gen_id }}__image,.ai-bento-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:100%;min-height:190px;object-fit:cover;border-radius:var(--radius);clip-path:inset(0 round var(--radius))}.ai-bento-{{ ai_gen_id }}__placeholder{overflow:hidden;background:#ecece8}.ai-bento-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%}.ai-bento-{{ ai_gen_id }}__label{position:absolute;z-index:2;top:14px;left:14px;padding:5px 9px;border-radius:999px;background:#fff;color:#1a1a1a;font-size:9px;font-weight:700;letter-spacing:.07em}.ai-bento-{{ ai_gen_id }}__trust{position:absolute;z-index:3;top:12px;right:12px;width:73px;height:73px;border-radius:50%;overflow:hidden;background:#fff;border:1px solid #333;display:flex;align-items:center;justify-content:center;text-align:center;color:#111;font-size:8px;font-weight:700}.ai-bento-{{ ai_gen_id }}__trust img{width:100%;height:100%;object-fit:cover}.ai-bento-{{ ai_gen_id }}__wishlist{position:absolute;z-index:3;top:12px;right:12px;width:42px;height:42px;border:0;border-radius:50%;background:#fff;color:#111;cursor:pointer}.ai-bento-{{ ai_gen_id }}__wishlist svg{width:21px;height:21px;fill:none;stroke:currentColor;stroke-width:1.8}.ai-bento-{{ ai_gen_id }}__wishlist[aria-pressed=true] svg{fill:#a32335;stroke:#a32335}.ai-bento-{{ ai_gen_id }}__overlay{position:absolute;inset:35% 0 0;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;padding:20px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.8));pointer-events:none}.ai-bento-{{ ai_gen_id }}__card:nth-child(1) .ai-bento-{{ ai_gen_id }}__overlay{gap:{{ block.settings.product_one_info_gap }}px}.ai-bento-{{ ai_gen_id }}__overlay h3{margin:0}.ai-bento-{{ ai_gen_id }}__card:nth-child(1) .ai-bento-{{ ai_gen_id }}__overlay h3{font-size:{{ block.settings.product_title_size | times: 1.4 }}px}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay h3{font-size:{{ block.settings.product_title_size | times: 0.78 }}px;font-weight:700}.ai-bento-{{ ai_gen_id }}__overlay span{font-size:14px}.ai-bento-{{ ai_gen_id }}__product-eyebrow{font-size:6.5px;font-weight:700;letter-spacing:.12em;line-height:1.2}.ai-bento-{{ ai_gen_id }}__description,.ai-bento-{{ ai_gen_id }}__description p{margin:0;font-size:14px;line-height:1.45}.ai-bento-{{ ai_gen_id }}__card form{position:absolute;z-index:4;right:12px;bottom:12px;margin:0}.ai-bento-{{ ai_gen_id }}__cart-button{display:inline-flex;align-items:center;gap:5px;min-height:32px;padding:6px 11px;border:1px solid {{ block.settings.button_color }};border-radius:999px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;font-size:11px;cursor:pointer}.ai-bento-{{ ai_gen_id }}__cart-button svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.8}.ai-bento-{{ ai_gen_id }}__product-one-actions{display:flex;align-items:center;gap:10px;flex-wrap:wrap;pointer-events:auto}.ai-bento-{{ ai_gen_id }}__product-one-actions form,.ai-bento-{{ ai_gen_id }}__card:nth-child(1) .ai-bento-{{ ai_gen_id }}__product-one-actions form{position:static;z-index:auto;margin:0}.ai-bento-{{ ai_gen_id }}__product-one-price{font-weight:700;color:#ffe27a;font-size:16px!important}.ai-bento-{{ ai_gen_id }}__product-one-details{color:#fff;font-size:12px;text-decoration:underline;text-underline-offset:3px}.ai-bento-{{ ai_gen_id }}__product-one-button{font-size:12px;white-space:nowrap}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2){overflow:visible;background:transparent;display:flex;flex-direction:column}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__image,.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__placeholder{height:auto;min-height:0;aspect-ratio:1/1;clip-path:inset(0 round var(--radius))}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay{position:static;inset:auto;justify-content:flex-start;gap:5px;padding:10px 0 4px;color:{{ block.settings.text_color }};background:none;pointer-events:auto}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay span{font-size:13px}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay .ai-bento-{{ ai_gen_id }}__product-eyebrow{font-size:6.5px}.ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) form{position:static;align-self:flex-end;margin:4px 0 0}.ai-bento-{{ ai_gen_id }} a:focus-visible,.ai-bento-{{ ai_gen_id }} button:focus-visible{outline:3px solid #111;outline-offset:3px}@media(max-width:749px){.ai-bento-{{ ai_gen_id }}__inner{width:100%}.ai-bento-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto;gap:10px}.ai-bento-{{ ai_gen_id }}__card:nth-child(1),.ai-bento-{{ ai_gen_id }}__card:nth-child(4),.ai-bento-{{ ai_gen_id }}__card:nth-child(5){grid-column:1/span 2;grid-row:auto}.ai-bento-{{ ai_gen_id }}__card:nth-child(2),.ai-bento-{{ ai_gen_id }}__card:nth-child(3){grid-column:span 1;grid-row:auto}.ai-bento-{{ ai_gen_id }}__product-one-actions{gap:7px}.ai-bento-{{ ai_gen_id }}__product-one-details{font-size:11px}}
{% endstyle %}
<product-bento-{{ ai_gen_id }} class="ai-bento-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-bento-{{ ai_gen_id }}__inner">{% if block.settings.eyebrow != blank %}<div class="ai-bento-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}{% if block.settings.heading != blank %}<div class="ai-bento-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>{% endif %}<div class="ai-bento-{{ ai_gen_id }}__grid">{% for i in (1..5) %}{% liquid
assign product_key = 'product_' | append: i
assign item = block.settings[product_key]
%}<article class="ai-bento-{{ ai_gen_id }}__card">{% if i == 1 %}<span class="ai-bento-{{ ai_gen_id }}__trust" aria-label="Trust indicator">{% if block.settings.trust_image %}<img src="{{ block.settings.trust_image | image_url: width: 160 }}" alt="{{ block.settings.trust_image.alt | default: 'Trust indicator' | escape }}">{% else %}TRUST<br>BADGE{% endif %}</span><span class="ai-bento-{{ ai_gen_id }}__label">BEDDING</span>{% else %}<span class="ai-bento-{{ ai_gen_id }}__label">BAMBOO</span><button class="ai-bento-{{ ai_gen_id }}__wishlist" type="button" aria-label="Add product to wishlist" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.8 8.6c0 4.3-8.8 10-8.8 10s-8.8-5.7-8.8-10a4.6 4.6 0 0 1 8.8-1.8 4.6 4.6 0 0 1 8.8 1.8Z"/></svg></button>{% endif %}{% if item != blank and item.featured_image %}<img class="ai-bento-{{ ai_gen_id }}__image" src="{{ item.featured_image | image_url: width: 1000 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}">{% else %}<div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-bento-{{ ai_gen_id }}__overlay">{% if i > 1 %}<span class="ai-bento-{{ ai_gen_id }}__product-eyebrow">BODYSUITS</span>{% endif %}<h3>{% if item != blank %}{{ item.title | escape }}{% else %}Choose product {{ i }}{% endif %}</h3>{% if i == 1 and block.settings.product_one_description != blank %}<div class="ai-bento-{{ ai_gen_id }}__description">{{ block.settings.product_one_description }}</div>{% endif %}{% if item != blank and i == 1 %}<div class="ai-bento-{{ ai_gen_id }}__product-one-actions"><span class="ai-bento-{{ ai_gen_id }}__product-one-price">{{ item.price | money }}</span>{% form 'product', item %}<input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}"><button type="submit" class="ai-bento-{{ ai_gen_id }}__cart-button ai-bento-{{ ai_gen_id }}__product-one-button" {% unless item.available %}disabled{% endunless %}>{% if item.available %}Add to cart<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 1.9-1.4L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{% else %}Sold out{% endif %}</button>{% endform %}<a class="ai-bento-{{ ai_gen_id }}__product-one-details" href="{{ item.url }}">View product details</a></div>{% elsif item != blank %}<span>{{ item.price | money }}</span>{% else %}<span>Add a product in block settings</span>{% endif %}</div>{% if item != blank and i > 1 %}{% form 'product', item %}<input type="hidden" name="id" value="{{ item.selected_or_first_available_variant.id }}"><button type="submit" class="ai-bento-{{ ai_gen_id }}__cart-button" {% unless item.available %}disabled{% endunless %}>{% if item.available %}<span>Add</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 1.9-1.4L21 8H6"/><circle cx="10" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>{% else %}Sold out{% endif %}</button>{% endform %}{% endif %}</article>{% endfor %}</div></div></product-bento-{{ ai_gen_id }}>
<script>(()=>{const n='product-bento-{{ ai_gen_id }}';if(customElements.get(n))return;class Bento extends HTMLElement{connectedCallback(){this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__wishlist').forEach(b=>b.addEventListener('click',()=>{const s=b.getAttribute('aria-pressed')==='true';b.setAttribute('aria-pressed',String(!s));b.setAttribute('aria-label',s?'Add product to wishlist':'Remove product from wishlist')}))}}customElements.define(n,Bento)})();</script>
{% schema %}{"name":"Bento product grid","settings":[{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>Thoughtfully made for every day</p>"},{"type":"richtext","id":"heading","label":"Heading","default":"<p>Everyday Essentials, Made Soft.</p>"},{"type":"richtext","id":"product_one_description","label":"Product 1 description","default":"<p>Soft, breathable bedding designed for everyday comfort.<br>Made with thoughtfully selected materials for a restful feel.</p>"},{"type":"range","id":"product_one_info_gap","label":"Product 1 text spacing","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"range","id":"desktop_width_percent","label":"Desktop content width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Vertical spacing","min":0,"max":100,"step":5,"unit":"px","default":50},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"range","id":"product_title_size","label":"Product name size","min":10,"max":40,"step":1,"unit":"px","default":18},{"type":"image_picker","id":"trust_image","label":"Trust badge PNG"},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#1A1A1A"},{"type":"color","id":"button_color","label":"Button background","default":"#1A1A1A"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"},{"type":"product","id":"product_5","label":"Product 5"}],"presets":[{"name":"Bento product grid"}],"tag":null,"class":"bento-product-grid-block"}{% endschema %}