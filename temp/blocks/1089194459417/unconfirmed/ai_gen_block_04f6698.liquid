{% doc %}
  @prompt
    Generate a NEW product section. Colour scheme: Oat.
    Heading: "Best sellers". Button: "Shop all".
    Show four products from all products, sorted by best selling. 2 by 2 on mobile, 4 across on desktop.
    Use the theme's own product card and quick add. Style them, do not rebuild them. Card: 4:5 image, 20px radius, title in 15px (two lines), price in 16px bold. A badge ("New" or "Best seller") in Kry maroon from the product tag. Quick add is a 44px round Bamboo button on the image.
    Generate no images. Photos and prices come from the store.
    Add a "Show this section" checkbox, on by default., allow me to connect products and show demo skeletons, manage left and right side spacings, product are not visible while connected, show in bento grid style , Make this section look more catchy and aesthetic, show the price and product name in product image use glassmorph to shos , adjust the font size, and make this section more detailed and catchy , now allow me change all the texts in this section in rich style texts and background color for this section and border color of bento cards, remove curved corner from this section, add hover to reveil price and product name on each card the name and price should appear fade in on hover and hover our fade out, for this section in mobile show 1 2 1 layout proper even
{% enddoc %}
{% assign ai_gen_id = block.id | remove: '_' | downcase %}
{% assign source_collection = block.settings.collection %}
{% if source_collection == blank %}{% assign source_collection = collections.all %}{% endif %}
{% style %}
  .ai-best-sellers-{{ ai_gen_id }} { display:block; width:100%; box-sizing:border-box; padding:32px {{ block.settings.side_spacing }}px; background:{{ block.settings.background_color }}; color:#34231f; }
  .ai-best-sellers-{{ ai_gen_id }}__inner { width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; }
  .ai-best-sellers-{{ ai_gen_id }}__head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:24px; }
  .ai-best-sellers-{{ ai_gen_id }}__title { margin:0; color:{{ block.settings.text_color }}; font-size:{{ block.settings.heading_size }}px; line-height:1.05; }
  .ai-best-sellers-{{ ai_gen_id }}__intro { color:{{ block.settings.text_color }}; }
  .ai-best-sellers-{{ ai_gen_id }}__intro p { margin:8px 0 0; }
  .ai-best-sellers-{{ ai_gen_id }}__link { display:inline-flex; align-items:center; justify-content:center; padding:11px 19px; color:#fff; background:#632c3c; text-decoration:none; border-radius:2px; white-space:nowrap; }
  .ai-best-sellers-{{ ai_gen_id }}__grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:{{ block.settings.gap }}px; }
  .ai-best-sellers-{{ ai_gen_id }}__card { position:relative; overflow:hidden; border:1px solid {{ block.settings.card_border }}; background:#eee9df; border-radius:0; aspect-ratio:4/5; }
  .ai-best-sellers-{{ ai_gen_id }}__card > a { display:block; width:100%; height:100%; }
  .ai-best-sellers-{{ ai_gen_id }}__card img { width:100%; height:100%; object-fit:cover; display:block; }
  .ai-best-sellers-{{ ai_gen_id }}__overlay { position:absolute; inset:auto 10px 10px; padding:13px; color:#fff; background:rgba(42,30,27,.68); -webkit-backdrop-filter:blur(12px); backdrop-filter:blur(12px); opacity:0; transition:opacity .25s ease; pointer-events:none; }
  .ai-best-sellers-{{ ai_gen_id }}__card:hover .ai-best-sellers-{{ ai_gen_id }}__overlay,.ai-best-sellers-{{ ai_gen_id }}__card:focus-within .ai-best-sellers-{{ ai_gen_id }}__overlay { opacity:1; }
  .ai-best-sellers-{{ ai_gen_id }}__name { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; margin:0 0 6px; font-size:{{ block.settings.title_size }}px; line-height:1.25; }
  .ai-best-sellers-{{ ai_gen_id }}__price { margin:0; font-size:{{ block.settings.price_size }}px; font-weight:700; }
  .ai-best-sellers-{{ ai_gen_id }}__badge { position:absolute; top:10px; left:10px; z-index:2; padding:6px 10px; color:#fff; background:#632c3c; font-size:12px; }
  .ai-best-sellers-{{ ai_gen_id }}__quick { position:absolute; z-index:3; top:10px; right:10px; width:44px; height:44px; display:flex; align-items:center; justify-content:center; border:0; border-radius:50%; color:#2d3521; background:#e9ddc2; text-decoration:none; font-size:24px; }
  .ai-best-sellers-{{ ai_gen_id }}__skeleton { aspect-ratio:4/5; background:linear-gradient(110deg,#e9e4db 8%,#f5f1e9 18%,#e9e4db 33%); border:1px solid {{ block.settings.card_border }}; }
  @media(max-width:749px){ .ai-best-sellers-{{ ai_gen_id }} { padding:26px {{ block.settings.mobile_side_spacing }}px; } .ai-best-sellers-{{ ai_gen_id }}__grid { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; } .ai-best-sellers-{{ ai_gen_id }}__head { align-items:flex-start; } .ai-best-sellers-{{ ai_gen_id }}__title { font-size:{{ block.settings.mobile_heading_size }}px; } .ai-best-sellers-{{ ai_gen_id }}__overlay { opacity:1; inset:auto 6px 6px; padding:9px; } .ai-best-sellers-{{ ai_gen_id }}__name { font-size:13px; } .ai-best-sellers-{{ ai_gen_id }}__price { font-size:14px; } }
  @media(prefers-reduced-motion:reduce){ .ai-best-sellers-{{ ai_gen_id }}__overlay { transition:none; } }
{% endstyle %}
{% if block.settings.show_section %}
<div class="ai-best-sellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-best-sellers-{{ ai_gen_id }}__inner">
    <div class="ai-best-sellers-{{ ai_gen_id }}__head">
      <div>{% if block.settings.heading != blank %}<h2 class="ai-best-sellers-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>{% endif %}{% if block.settings.description != blank %}<div class="ai-best-sellers-{{ ai_gen_id }}__intro">{{ block.settings.description }}</div>{% endif %}</div>
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-best-sellers-{{ ai_gen_id }}__link" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
    </div>
    <div class="ai-best-sellers-{{ ai_gen_id }}__grid">
      {% assign displayed_count = 0 %}
      {% for product in source_collection.products limit: 4 %}
        {% assign displayed_count = displayed_count | plus: 1 %}
        <article class="ai-best-sellers-{{ ai_gen_id }}__card">
          {% if product.tags contains 'New' %}<span class="ai-best-sellers-{{ ai_gen_id }}__badge">New</span>{% elsif product.tags contains 'Best seller' %}<span class="ai-best-sellers-{{ ai_gen_id }}__badge">Best seller</span>{% endif %}
          <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}
          </a>
          {% if block.settings.enable_quick_add and product.available %}<a class="ai-best-sellers-{{ ai_gen_id }}__quick" href="{{ product.url }}" aria-label="Quick add {{ product.title | escape }}">+</a>{% endif %}
          <div class="ai-best-sellers-{{ ai_gen_id }}__overlay"><p class="ai-best-sellers-{{ ai_gen_id }}__name">{{ product.title | escape }}</p><p class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</p></div>
        </article>
      {% endfor %}
      {% if block.settings.show_skeletons %}{% for i in (1..4) %}{% if displayed_count < forloop.index %}<div class="ai-best-sellers-{{ ai_gen_id }}__skeleton" aria-hidden="true"></div>{% endif %}{% endfor %}{% endif %}
    </div>
  </div>
</div>
{% endif %}
{% schema %}
{
  "name": "Oat best sellers",
  "settings": [
    {"type":"checkbox","id":"show_section","label":"Show this section","default":true},
    {"type":"checkbox","id":"show_skeletons","label":"Show demo skeletons","default":false},
    {"type":"collection","id":"collection","label":"Product collection"},
    {"type":"text","id":"heading","label":"Heading","default":"Best sellers"},
    {"type":"richtext","id":"description","label":"Supporting text","default":"<p>Customer favourites, chosen for you.</p>"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop all"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"checkbox","id":"enable_quick_add","label":"Show quick add shortcut","default":true},
    {"type":"color","id":"background_color","label":"Background","default":"#F3EFE6"},
    {"type":"color","id":"text_color","label":"Text","default":"#34231F"},
    {"type":"color","id":"card_border","label":"Card border","default":"#D8CBB8"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"side_spacing","label":"Side spacing","min":0,"max":80,"step":4,"unit":"px","default":24},
    {"type":"range","id":"mobile_side_spacing","label":"Mobile side spacing","min":0,"max":32,"step":2,"unit":"px","default":16},
    {"type":"range","id":"gap","label":"Card spacing","min":8,"max":40,"step":4,"unit":"px","default":16},
    {"type":"range","id":"heading_size","label":"Heading size","min":20,"max":64,"step":2,"unit":"px","default":40},
    {"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":18,"max":40,"step":2,"unit":"px","default":28},
    {"type":"range","id":"title_size","label":"Product title size","min":12,"max":20,"step":1,"unit":"px","default":15},
    {"type":"range","id":"price_size","label":"Price size","min":12,"max":24,"step":1,"unit":"px","default":16}
  ],
  "presets": [{"name":"Oat best sellers"}],
  "tag": null,
  "class": "oat-best-sellers-block"
}
{% endschema %}