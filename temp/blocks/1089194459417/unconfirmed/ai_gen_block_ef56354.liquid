{% doc %}
  @prompt
    generate a full page width section to show products in quick view use bento grid for 4 products , increase size of product 1 vertically and product 4 as well so that product 4 comes below of 2 and 3 fully, keep product 2 and 3 together parallel
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-bento-{{ ai_gen_id }}{display:block;width:100%;box-sizing:border-box;padding:{{ block.settings.section_padding }}px 20px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}
.ai-bento-{{ ai_gen_id }}__inner{width:{{ block.settings.desktop_width_percent }}%;max-width:1400px;margin:auto}
.ai-bento-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-template-rows:repeat(2,minmax(280px,1fr));gap:14px}
.ai-bento-{{ ai_gen_id }}__card{position:relative;overflow:hidden;min-width:0;background:#eee;border-radius:{{ block.settings.card_radius }}px}
.ai-bento-{{ ai_gen_id }}__card:nth-child(1){grid-column:1 / span 2;grid-row:1 / span 2}
.ai-bento-{{ ai_gen_id }}__card:nth-child(2){grid-column:3;grid-row:1}
.ai-bento-{{ ai_gen_id }}__card:nth-child(3){grid-column:4;grid-row:1}
.ai-bento-{{ ai_gen_id }}__card:nth-child(4){grid-column:3 / span 2;grid-row:2}
.ai-bento-{{ ai_gen_id }}__image,.ai-bento-{{ ai_gen_id }}__placeholder{display:block;width:100%;height:100%;min-height:190px;object-fit:cover}.ai-bento-{{ ai_gen_id }}__placeholder{background:#ecece8}.ai-bento-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;display:block}
.ai-bento-{{ ai_gen_id }}__overlay{position:absolute;inset:35% 0 0;display:flex;flex-direction:column;justify-content:flex-end;gap:8px;padding:20px;color:#fff;background:linear-gradient(transparent,rgba(0,0,0,.8))}.ai-bento-{{ ai_gen_id }}__overlay h3{margin:0;font-size:18px}.ai-bento-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:42px;padding:8px 16px;border:1px solid {{ block.settings.button_color }};border-radius:999px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;text-decoration:none;cursor:pointer}.ai-bento-{{ ai_gen_id }}__actions{display:flex;gap:8px;flex-wrap:wrap}.ai-bento-{{ ai_gen_id }}__dialog{position:fixed;inset:0;z-index:9999;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.65)}.ai-bento-{{ ai_gen_id }}__dialog[open]{display:flex}.ai-bento-{{ ai_gen_id }}__panel{position:relative;display:grid;grid-template-columns:1fr 1fr;width:min(850px,100%);max-height:90vh;overflow:auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }}}.ai-bento-{{ ai_gen_id }}__dialog-image{width:100%;height:100%;min-height:320px;object-fit:cover}.ai-bento-{{ ai_gen_id }}__info{padding:32px;align-self:center}.ai-bento-{{ ai_gen_id }}__close{position:absolute;right:10px;top:10px;width:40px;height:40px;border:0;border-radius:50%;font-size:24px;cursor:pointer}.ai-bento-{{ ai_gen_id }} button:focus-visible,.ai-bento-{{ ai_gen_id }} a:focus-visible{outline:3px solid #fff;outline-offset:3px}
@media(max-width:749px){.ai-bento-{{ ai_gen_id }}__inner{width:100%}.ai-bento-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-template-rows:auto;gap:10px}.ai-bento-{{ ai_gen_id }}__card:nth-child(1),.ai-bento-{{ ai_gen_id }}__card:nth-child(4){grid-column:1 / span 2;grid-row:auto}.ai-bento-{{ ai_gen_id }}__card:nth-child(2),.ai-bento-{{ ai_gen_id }}__card:nth-child(3){grid-column:span 1;grid-row:auto}.ai-bento-{{ ai_gen_id }}__panel{grid-template-columns:1fr}.ai-bento-{{ ai_gen_id }}__dialog-image{height:35vh;min-height:200px}}
{% endstyle %}
<quick-view-bento-{{ ai_gen_id }} class="ai-bento-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-bento-{{ ai_gen_id }}__inner">{% if block.settings.heading != blank %}<h2>{{ block.settings.heading | escape }}</h2>{% endif %}<div class="ai-bento-{{ ai_gen_id }}__grid">
{% for i in (1..4) %}
{% liquid
assign product_key = 'product_' | append: i
assign item = block.settings[product_key]
%}
{% if item != blank %}<article class="ai-bento-{{ ai_gen_id }}__card">{% if item.featured_image %}<img class="ai-bento-{{ ai_gen_id }}__image" src="{{ item.featured_image | image_url: width: 1000 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" loading="lazy" width="{{ item.featured_image.width }}" height="{{ item.featured_image.height }}">{% else %}<div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-bento-{{ ai_gen_id }}__overlay"><h3>{{ item.title | escape }}</h3><span>{{ item.price | money }}</span><div class="ai-bento-{{ ai_gen_id }}__actions"><button class="ai-bento-{{ ai_gen_id }}__button ai-bento-{{ ai_gen_id }}__quick" type="button" data-index="{{ i }}" aria-haspopup="dialog">Quick view</button><a class="ai-bento-{{ ai_gen_id }}__button" href="{{ item.url }}">View product</a></div></div><div hidden data-info="{{ i }}">{% if item.featured_image %}<img class="ai-bento-{{ ai_gen_id }}__dialog-image" src="{{ item.featured_image | image_url: width: 1000 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}">{% endif %}<div class="ai-bento-{{ ai_gen_id }}__info"><h3>{{ item.title | escape }}</h3><p>{{ item.price | money }}</p>{% if block.settings.show_description %}<p>{{ item.description | strip_html | truncate: 260 }}</p>{% endif %}<a class="ai-bento-{{ ai_gen_id }}__button" href="{{ item.url }}">View product</a></div></div></article>{% else %}<article class="ai-bento-{{ ai_gen_id }}__card"><div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div><div class="ai-bento-{{ ai_gen_id }}__overlay"><h3>Choose product {{ i }}</h3><span>Add a product in block settings</span></div></article>{% endif %}
{% endfor %}</div></div><dialog class="ai-bento-{{ ai_gen_id }}__dialog" aria-label="Product quick view"><div class="ai-bento-{{ ai_gen_id }}__panel"><button class="ai-bento-{{ ai_gen_id }}__close" aria-label="Close quick view" type="button">&times;</button><div class="ai-bento-{{ ai_gen_id }}__content"></div></div></dialog></quick-view-bento-{{ ai_gen_id }}>
<script>(()=>{const name='quick-view-bento-{{ ai_gen_id }}';if(customElements.get(name))return;class QuickViewBento extends HTMLElement{connectedCallback(){this.dialog=this.querySelector('dialog');this.content=this.querySelector('.ai-bento-{{ ai_gen_id }}__content');this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__quick').forEach(button=>button.addEventListener('click',()=>{const source=this.querySelector('[data-info="'+button.dataset.index+'"]');this.content.replaceChildren(...Array.from(source.children).map(node=>node.cloneNode(true)));this.dialog.showModal()}));this.querySelector('.ai-bento-{{ ai_gen_id }}__close').addEventListener('click',()=>this.dialog.close());this.dialog.addEventListener('click',event=>{if(event.target===this.dialog)this.dialog.close()})}}customElements.define(name,QuickViewBento)})();</script>
{% schema %}{"name":"Bento quick view","settings":[{"type":"text","id":"heading","label":"Heading","default":"Featured products"},{"type":"range","id":"desktop_width_percent","label":"Desktop content width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"section_padding","label":"Vertical spacing","min":0,"max":100,"step":5,"unit":"px","default":50},{"type":"range","id":"card_radius","label":"Card corner radius","min":0,"max":32,"step":2,"unit":"px","default":8},{"type":"checkbox","id":"show_description","label":"Show description in quick view","default":true},{"type":"color","id":"background_color","label":"Background","default":"#FFFFFF"},{"type":"color","id":"text_color","label":"Text","default":"#1A1A1A"},{"type":"color","id":"button_color","label":"Button background","default":"#1A1A1A"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"product","id":"product_1","label":"Product 1"},{"type":"product","id":"product_2","label":"Product 2"},{"type":"product","id":"product_3","label":"Product 3"},{"type":"product","id":"product_4","label":"Product 4"}],"presets":[{"name":"Bento quick view"}],"tag":null,"class":"bento-quick-view-block"}{% endschema %}