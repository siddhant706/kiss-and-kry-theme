{% doc %}
  @prompt
    generate a full page width section to show products in quick view use bento grid for 4 products 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bento-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px max(20px, calc((100vw - 1400px) / 2));
    box-sizing: border-box;
  }
  .ai-bento-{{ ai_gen_id }}__inner { width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; }
  .ai-bento-{{ ai_gen_id }}__heading { margin: 0 0 24px; font-size: clamp(24px, 3vw, 40px); line-height: 1.1; }
  .ai-bento-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(220px, 1fr)); gap: 14px; }
  .ai-bento-{{ ai_gen_id }}__card { position: relative; min-width: 0; overflow: hidden; border-radius: {{ block.settings.card_radius }}px; background: #f0f0ed; }
  .ai-bento-{{ ai_gen_id }}__card:nth-child(1) { grid-column: span 2; grid-row: span 2; }
  .ai-bento-{{ ai_gen_id }}__card:nth-child(2), .ai-bento-{{ ai_gen_id }}__card:nth-child(3), .ai-bento-{{ ai_gen_id }}__card:nth-child(4) { grid-column: span 1; }
  .ai-bento-{{ ai_gen_id }}__image, .ai-bento-{{ ai_gen_id }}__placeholder { display: block; width: 100%; height: 100%; min-height: 220px; object-fit: cover; }
  .ai-bento-{{ ai_gen_id }}__placeholder { background: #ecece8; }
  .ai-bento-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; color: #777; }
  .ai-bento-{{ ai_gen_id }}__overlay { position: absolute; inset: 35% 0 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 8px; padding: 20px; color: #fff; background: linear-gradient(transparent, rgba(0,0,0,.78)); }
  .ai-bento-{{ ai_gen_id }}__name { margin: 0; font-size: 18px; line-height: 1.25; }
  .ai-bento-{{ ai_gen_id }}__price { font-size: 14px; }
  .ai-bento-{{ ai_gen_id }}__actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
  .ai-bento-{{ ai_gen_id }}__button { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 9px 16px; color: {{ block.settings.button_text_color }}; background: {{ block.settings.button_color }}; border: 1px solid {{ block.settings.button_color }}; border-radius: 999px; font: inherit; text-decoration: none; cursor: pointer; }
  .ai-bento-{{ ai_gen_id }}__button--secondary { color: #fff; background: rgba(0,0,0,.28); border-color: rgba(255,255,255,.8); }
  .ai-bento-{{ ai_gen_id }}__button:focus-visible, .ai-bento-{{ ai_gen_id }}__close:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .ai-bento-{{ ai_gen_id }}__dialog { position: fixed; inset: 0; z-index: 9999; display: none; align-items: center; justify-content: center; padding: 20px; background: rgba(0,0,0,.66); }
  .ai-bento-{{ ai_gen_id }}__dialog[open] { display: flex; }
  .ai-bento-{{ ai_gen_id }}__dialog-panel { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(260px, .9fr); width: min(850px, 100%); max-height: min(90vh, 720px); overflow: auto; background: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border-radius: {{ block.settings.card_radius }}px; }
  .ai-bento-{{ ai_gen_id }}__dialog-image { width: 100%; height: 100%; min-height: 320px; object-fit: cover; }
  .ai-bento-{{ ai_gen_id }}__dialog-info { padding: 36px 28px; align-self: center; }
  .ai-bento-{{ ai_gen_id }}__dialog-info h3 { margin: 0 0 12px; font-size: 25px; }
  .ai-bento-{{ ai_gen_id }}__description { margin: 18px 0; line-height: 1.6; }
  .ai-bento-{{ ai_gen_id }}__close { position: absolute; top: 12px; right: 12px; z-index: 1; display: grid; place-items: center; width: 40px; height: 40px; border: 0; border-radius: 50%; background: #fff; color: #111; font-size: 24px; cursor: pointer; }
  @media (max-width: 749px) {
    .ai-bento-{{ ai_gen_id }} { padding: 34px 16px; }
    .ai-bento-{{ ai_gen_id }}__inner { width: 100%; }
    .ai-bento-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(190px, 1fr)); gap: 10px; }
    .ai-bento-{{ ai_gen_id }}__card:nth-child(1) { grid-column: span 2; grid-row: span 1; }
    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) { grid-column: span 1; }
    .ai-bento-{{ ai_gen_id }}__image, .ai-bento-{{ ai_gen_id }}__placeholder { min-height: 190px; }
    .ai-bento-{{ ai_gen_id }}__overlay { padding: 14px; }
    .ai-bento-{{ ai_gen_id }}__name { font-size: 16px; }
    .ai-bento-{{ ai_gen_id }}__dialog-panel { grid-template-columns: 1fr; max-height: 90vh; }
    .ai-bento-{{ ai_gen_id }}__dialog-image { height: 38vh; min-height: 200px; }
    .ai-bento-{{ ai_gen_id }}__dialog-info { padding: 24px; }
  }
  @media (prefers-reduced-motion: reduce) { .ai-bento-{{ ai_gen_id }} *, .ai-bento-{{ ai_gen_id }} *::before, .ai-bento-{{ ai_gen_id }} *::after { scroll-behavior: auto !important; } }
{% endstyle %}

<quick-view-bento-{{ ai_gen_id }} class="ai-bento-{{ ai_gen_id }}" style="width:100%;" {{ block.shopify_attributes }}>
  <div class="ai-bento-{{ ai_gen_id }}__inner">
    {% if block.settings.heading != blank %}<h2 class="ai-bento-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
    <div class="ai-bento-{{ ai_gen_id }}__grid">
      {% for i in (1..4) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign item = block.settings[product_key]
        %}
        {% if item != blank %}
          <article class="ai-bento-{{ ai_gen_id }}__card">
            {% if item.featured_image %}
              {{ item.featured_image | image_url: width: 1000 | image_tag: class: 'ai-bento-' | append: ai_gen_id | append: '__image', loading: 'lazy', alt: item.featured_image.alt | default: item.title }}
            {% else %}
              <div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
            <div class="ai-bento-{{ ai_gen_id }}__overlay">
              <h3 class="ai-bento-{{ ai_gen_id }}__name">{{ item.title | escape }}</h3>
              <span class="ai-bento-{{ ai_gen_id }}__price">{{ item.price | money }}</span>
              <div class="ai-bento-{{ ai_gen_id }}__actions">
                <button class="ai-bento-{{ ai_gen_id }}__button ai-bento-{{ ai_gen_id }}__quick" type="button" data-product="{{ i }}" aria-haspopup="dialog">Quick view</button>
                <a class="ai-bento-{{ ai_gen_id }}__button ai-bento-{{ ai_gen_id }}__button--secondary" href="{{ item.url }}">View product</a>
              </div>
            </div>
            <div hidden data-quick-content="{{ i }}">
              {% if item.featured_image %}<img src="{{ item.featured_image | image_url: width: 1000 }}" alt="{{ item.featured_image.alt | default: item.title | escape }}" class="ai-bento-{{ ai_gen_id }}__dialog-image" loading="lazy">{% endif %}
              <div class="ai-bento-{{ ai_gen_id }}__dialog-info">
                <h3>{{ item.title | escape }}</h3>
                <div>{{ item.price | money }}</div>
                {% if block.settings.show_description %}<div class="ai-bento-{{ ai_gen_id }}__description">{{ item.description | strip_html | truncate: 260 }}</div>{% endif %}
                <a class="ai-bento-{{ ai_gen_id }}__button" href="{{ item.url }}">View product</a>
              </div>
            </div>
          </article>
        {% else %}
          <article class="ai-bento-{{ ai_gen_id }}__card">
            <div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            <div class="ai-bento-{{ ai_gen_id }}__overlay"><h3 class="ai-bento-{{ ai_gen_id }}__name">Choose product {{ i }}</h3><span>Add a product in the block settings</span></div>
          </article>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <dialog class="ai-bento-{{ ai_gen_id }}__dialog" aria-label="Product quick view">
    <div class="ai-bento-{{ ai_gen_id }}__dialog-panel">
      <button class="ai-bento-{{ ai_gen_id }}__close" type="button" aria-label="Close quick view">&times;</button>
      <div class="ai-bento-{{ ai_gen_id }}__dialog-content"></div>
    </div>
  </dialog>
</quick-view-bento-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'quick-view-bento-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class QuickViewBento extends HTMLElement {
      connectedCallback() {
        this.dialog = this.querySelector('dialog');
        this.content = this.querySelector('.ai-bento-{{ ai_gen_id }}__dialog-content');
        this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__quick').forEach((button) => {
          button.addEventListener('click', () => {
            const source = this.querySelector('[data-quick-content="' + button.dataset.product + '"]');
            if (!source) return;
            this.content.replaceChildren(...Array.from(source.children).map((node) => node.cloneNode(true)));
            this.dialog.showModal();
            this.querySelector('.ai-bento-{{ ai_gen_id }}__close').focus();
          });
        });
        this.querySelector('.ai-bento-{{ ai_gen_id }}__close').addEventListener('click', () => this.dialog.close());
        this.dialog.addEventListener('click', (event) => { if (event.target === this.dialog) this.dialog.close(); });
        this.dialog.addEventListener('close', () => { const button = this.querySelector('.ai-bento-{{ ai_gen_id }}__quick'); if (button) button.focus(); });
      }
    }
    customElements.define(tagName, QuickViewBento);
  })();
</script>

{% schema %}
{
  "name": "Bento quick view",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop content width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Vertical spacing", "min": 0, "max": 100, "step": 5, "unit": "px", "default": 50 },
    { "type": "range", "id": "card_radius", "label": "Card corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "show_description", "label": "Show description in quick view", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#FFFFFF" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1A1A1A" },
    { "type": "color", "id": "button_color", "label": "Button background", "default": "#1A1A1A" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "product", "id": "product_1", "label": "Product 1" },
    { "type": "product", "id": "product_2", "label": "Product 2" },
    { "type": "product", "id": "product_3", "label": "Product 3" },
    { "type": "product", "id": "product_4", "label": "Product 4" }
  ],
  "presets": [{ "name": "Bento quick view" }],
  "tag": null,
  "class": "bento-quick-view-block"
}
{% endschema %}