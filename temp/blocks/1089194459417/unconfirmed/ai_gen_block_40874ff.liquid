{% doc %}
  @prompt
    build a full page with bento grid section to show 4 product first on left and on right rest 3, product are not visible after selectefd, I want in bento grid style, I want for 4 product , all in rectangle shape, GRID (64px below the header)
    - Desktop: 4 columns, 28px column gap, 56px row gap.
    - Feature tile spans columns 1–2 and rows 1–2. Background is the featured product's image (or an image override), with a dark olive gradient from the middle down to rgba(59,65,43,0.94).
      - Top-left: cream pill tag showing the product type (14px, 700, uppercase, 0.16em spacing).
      - Top-right: 170px cream circle badge with the text "BORN FROM BAMBOO • MADE FOR BABY •" running around the edge in olive, and a small gold leaf icon in the centre.
      - Bottom-left, in white: product title (54px, weight 600); a one-line description (19px, 85% opacity); then a row with the price (30px, 600, gold), a cream pill button "Add to cart" (68px tall, olive text, bag icon) and an underlined "View details" text link.
    - Product cards sit in a 2×2 grid to the right of the feature tile.
      - Image: 372px tall, cover-fit on a cream background, 18px radius.
      - Top-left of the image: small cream pill "BAMBOO" with a leaf icon. Top-right: 46px white circle heart (wishlist) button.
      - Under the image: product type (14px, 600, uppercase, 0.16em, taupe); product title (23px, 600, dark olive, reserve 2 lines so cards align); then a row with the price (23px, 600, olive) on the left and an "Add" pill on the right (52px tall, bag icon, 1.5px olive outline, fills olive with white text on hover).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign products = block.settings.products %}
{% assign featured_product = products.first %}
{% capture feature_form_class %}ai-bamboo-grid-{{ ai_gen_id }}__feature-form{% endcapture %}
{% capture card_form_class %}ai-bamboo-grid-{{ ai_gen_id }}__card-form{% endcapture %}
{% style %}
.ai-bamboo-grid-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto;padding-top:64px;color:#3b412b}.ai-bamboo-grid-{{ ai_gen_id }}__layout{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(372px,auto);column-gap:28px;row-gap:56px}.ai-bamboo-grid-{{ ai_gen_id }}__feature{position:relative;grid-column:span 2;grid-row:span 2;min-height:800px;overflow:hidden;border-radius:18px;background:#3b412b;color:#fff}.ai-bamboo-grid-{{ ai_gen_id }}__feature-image,.ai-bamboo-grid-{{ ai_gen_id }}__feature-placeholder{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.ai-bamboo-grid-{{ ai_gen_id }}__feature-placeholder svg{width:100%;height:100%;object-fit:cover}.ai-bamboo-grid-{{ ai_gen_id }}__feature:after{content:'';position:absolute;inset:0;background:linear-gradient(to bottom,rgba(59,65,43,0) 30%,rgba(59,65,43,.55) 55%,rgba(59,65,43,.94) 100%)}.ai-bamboo-grid-{{ ai_gen_id }}__type-pill{position:absolute;z-index:2;top:28px;left:28px;padding:11px 16px;border-radius:999px;background:#f3ecd9;color:#3b412b;font-size:14px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.ai-bamboo-grid-{{ ai_gen_id }}__seal{position:absolute;z-index:2;top:24px;right:24px;width:170px;height:170px;border-radius:50%;background:#f3ecd9;color:#3b412b}.ai-bamboo-grid-{{ ai_gen_id }}__seal svg{width:100%;height:100%}.ai-bamboo-grid-{{ ai_gen_id }}__feature-info{position:absolute;z-index:2;right:32px;bottom:34px;left:32px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-title{max-width:650px;margin:0 0 12px;color:#fff;font-size:clamp(38px,4vw,54px);line-height:1.05;font-weight:600}.ai-bamboo-grid-{{ ai_gen_id }}__feature-description{max-width:620px;margin:0 0 26px;color:rgba(255,255,255,.85);font-size:19px;line-height:1.5}.ai-bamboo-grid-{{ ai_gen_id }}__feature-actions{display:flex;flex-wrap:wrap;align-items:center;gap:18px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-price{color:#e1c47b;font-size:30px;font-weight:600}.ai-bamboo-grid-{{ ai_gen_id }}__feature-form,.ai-bamboo-grid-{{ ai_gen_id }}__card-form{margin:0}.ai-bamboo-grid-{{ ai_gen_id }}__button{display:inline-flex;min-height:68px;align-items:center;justify-content:center;gap:10px;padding:0 25px;border:1px solid #f3ecd9;border-radius:999px;background:#f3ecd9;color:#3b412b;font:inherit;font-weight:600;text-decoration:none;cursor:pointer}.ai-bamboo-grid-{{ ai_gen_id }}__button svg,.ai-bamboo-grid-{{ ai_gen_id }}__add svg{width:20px;height:20px;flex:none}.ai-bamboo-grid-{{ ai_gen_id }}__details-link{color:#fff;text-underline-offset:5px;font-size:16px}.ai-bamboo-grid-{{ ai_gen_id }}__card{min-width:0}.ai-bamboo-grid-{{ ai_gen_id }}__card-media{position:relative;height:372px;overflow:hidden;border-radius:18px;background:#f3ecd9}.ai-bamboo-grid-{{ ai_gen_id }}__card-media img,.ai-bamboo-grid-{{ ai_gen_id }}__card-placeholder svg{display:block;width:100%;height:100%;object-fit:cover}.ai-bamboo-grid-{{ ai_gen_id }}__card-placeholder{width:100%;height:100%}.ai-bamboo-grid-{{ ai_gen_id }}__bamboo-pill{position:absolute;top:14px;left:14px;display:flex;align-items:center;gap:6px;padding:8px 12px;border-radius:999px;background:#f3ecd9;color:#3b412b;font-size:11px;font-weight:700;letter-spacing:.12em}.ai-bamboo-grid-{{ ai_gen_id }}__bamboo-pill svg{width:14px;height:14px}.ai-bamboo-grid-{{ ai_gen_id }}__wishlist{position:absolute;top:12px;right:12px;display:grid;width:46px;height:46px;place-items:center;border:0;border-radius:50%;background:#fff;color:#3b412b;cursor:pointer}.ai-bamboo-grid-{{ ai_gen_id }}__wishlist svg{width:21px;height:21px}.ai-bamboo-grid-{{ ai_gen_id }}__card-info{padding:18px 2px 0}.ai-bamboo-grid-{{ ai_gen_id }}__card-type{margin:0 0 8px;color:#776e5e;font-size:14px;font-weight:600;letter-spacing:.16em;text-transform:uppercase}.ai-bamboo-grid-{{ ai_gen_id }}__card-title{display:-webkit-box;min-height:58px;margin:0 0 12px;overflow:hidden;color:#3b412b;font-size:23px;line-height:1.25;font-weight:600;-webkit-box-orient:vertical;-webkit-line-clamp:2}.ai-bamboo-grid-{{ ai_gen_id }}__card-title a{color:inherit;text-decoration:none}.ai-bamboo-grid-{{ ai_gen_id }}__card-bottom{display:flex;align-items:center;justify-content:space-between;gap:12px}.ai-bamboo-grid-{{ ai_gen_id }}__card-price{color:#3b412b;font-size:23px;line-height:1.2;font-weight:600}.ai-bamboo-grid-{{ ai_gen_id }}__add{display:inline-flex;min-height:52px;align-items:center;justify-content:center;gap:8px;padding:0 19px;border:1.5px solid #3b412b;border-radius:999px;background:transparent;color:#3b412b;font:inherit;font-weight:600;cursor:pointer;transition:background-color .2s ease,color .2s ease}.ai-bamboo-grid-{{ ai_gen_id }}__add:hover{background:#3b412b;color:#fff}.ai-bamboo-grid-{{ ai_gen_id }} a:focus-visible,.ai-bamboo-grid-{{ ai_gen_id }} button:focus-visible{outline:3px solid #a9853b;outline-offset:3px}
@media(max-width:989px){.ai-bamboo-grid-{{ ai_gen_id }}__layout{grid-template-columns:repeat(2,minmax(0,1fr));gap:32px 20px}.ai-bamboo-grid-{{ ai_gen_id }}__feature{grid-column:span 2;grid-row:auto;min-height:620px}.ai-bamboo-grid-{{ ai_gen_id }}__card-media{height:clamp(260px,42vw,372px)}}
@media(max-width:599px){.ai-bamboo-grid-{{ ai_gen_id }}{padding-top:36px}.ai-bamboo-grid-{{ ai_gen_id }}__layout{grid-template-columns:1fr;gap:32px}.ai-bamboo-grid-{{ ai_gen_id }}__feature{grid-column:auto;min-height:620px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-info{right:20px;bottom:24px;left:20px}.ai-bamboo-grid-{{ ai_gen_id }}__type-pill{top:18px;left:18px}.ai-bamboo-grid-{{ ai_gen_id }}__seal{top:16px;right:16px;width:112px;height:112px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-title{font-size:38px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-actions{gap:12px}.ai-bamboo-grid-{{ ai_gen_id }}__feature-price{width:100%}}
{% endstyle %}
<section class="ai-bamboo-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
{% if featured_product != blank %}<div class="ai-bamboo-grid-{{ ai_gen_id }}__layout">
<article class="ai-bamboo-grid-{{ ai_gen_id }}__feature">
{% assign feature_image = block.settings.feature_image | default: featured_product.featured_image %}{% if feature_image %}<img class="ai-bamboo-grid-{{ ai_gen_id }}__feature-image" src="{{ feature_image | image_url: width: 1600 }}" alt="{{ feature_image.alt | default: featured_product.title | escape }}" loading="lazy" width="{{ feature_image.width }}" height="{{ feature_image.height }}">{% else %}<div class="ai-bamboo-grid-{{ ai_gen_id }}__feature-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
<span class="ai-bamboo-grid-{{ ai_gen_id }}__type-pill">{{ featured_product.type | default: 'Bamboo essentials' | escape }}</span>
<div class="ai-bamboo-grid-{{ ai_gen_id }}__seal" aria-label="Born from bamboo, made for baby"><svg viewBox="0 0 170 170" aria-hidden="true"><defs><path id="ai-bamboo-circle-{{ ai_gen_id }}" d="M85,85 m-65,0 a65,65 0 1,1 130,0 a65,65 0 1,1 -130,0"/></defs><text fill="#3b412b" font-size="9.5" font-weight="700" letter-spacing="1.35"><textPath href="#ai-bamboo-circle-{{ ai_gen_id }}">BORN FROM BAMBOO • MADE FOR BABY •</textPath></text><path d="M85 108c-19-9-22-27-6-42 3 17 9 26 6 42Zm1 0c1-22 10-34 25-39-3 18-10 31-25 39Zm-2 2c-12-10-24-12-35-9 10 12 22 15 35 9Z" fill="#b6924b"/></svg></div>
<div class="ai-bamboo-grid-{{ ai_gen_id }}__feature-info"><h2 class="ai-bamboo-grid-{{ ai_gen_id }}__feature-title">{{ featured_product.title | escape }}</h2><p class="ai-bamboo-grid-{{ ai_gen_id }}__feature-description">{{ featured_product.description | strip_html | strip | truncate: 125 }}</p><div class="ai-bamboo-grid-{{ ai_gen_id }}__feature-actions"><span class="ai-bamboo-grid-{{ ai_gen_id }}__feature-price">{{ featured_product.price | money }}</span>{% if featured_product.available %}{% form 'product', featured_product, class: feature_form_class %}<input type="hidden" name="id" value="{{ featured_product.selected_or_first_available_variant.id }}"><button class="ai-bamboo-grid-{{ ai_gen_id }}__button" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>{{ block.settings.feature_button_label | escape }}</button>{% endform %}{% endif %}<a class="ai-bamboo-grid-{{ ai_gen_id }}__details-link" href="{{ featured_product.url }}">View details</a></div></div></article>
{% for product in products offset: 1 limit: 4 %}{% if product != blank %}<article class="ai-bamboo-grid-{{ ai_gen_id }}__card"><div class="ai-bamboo-grid-{{ ai_gen_id }}__card-media">{% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-bamboo-grid-{{ ai_gen_id }}__card-placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<span class="ai-bamboo-grid-{{ ai_gen_id }}__bamboo-pill"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M16.5 3.5C9 3.7 4 6.2 4 11.2c0 2.3 1.6 3.8 3.9 3.8 5.2 0 7.8-5.1 8.6-11.5Z"/><path d="M3 17c2.8-4.6 6.4-7.5 11-9.7"/></svg>BAMBOO</span><button class="ai-bamboo-grid-{{ ai_gen_id }}__wishlist" type="button" aria-label="Add {{ product.title | escape }} to wishlist"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M20.8 8.6c0 5.1-8.8 10.1-8.8 10.1S3.2 13.7 3.2 8.6A4.6 4.6 0 0 1 12 6.2a4.6 4.6 0 0 1 8.8 2.4Z"/></svg></button></div><div class="ai-bamboo-grid-{{ ai_gen_id }}__card-info"><p class="ai-bamboo-grid-{{ ai_gen_id }}__card-type">{{ product.type | default: 'Bamboo essentials' | escape }}</p><h3 class="ai-bamboo-grid-{{ ai_gen_id }}__card-title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3><div class="ai-bamboo-grid-{{ ai_gen_id }}__card-bottom"><span class="ai-bamboo-grid-{{ ai_gen_id }}__card-price">{{ product.price | money }}</span>{% if product.available %}{% form 'product', product, class: card_form_class %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}"><button class="ai-bamboo-grid-{{ ai_gen_id }}__add" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>Add</button>{% endform %}{% endif %}</div></div></article>{% endif %}{% endfor %}
</div>{% else %}<p>Select up to five products. The first product is featured.</p>{% endif %}</section>
{% schema %}
{"name":"Bamboo product grid","settings":[{"type":"product_list","id":"products","label":"Products","limit":5},{"type":"image_picker","id":"feature_image","label":"Feature image override"},{"type":"text","id":"feature_button_label","label":"Feature button","default":"Add to cart"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Bamboo product grid"}],"tag":null,"class":"bamboo-product-grid"}
{% endschema %}