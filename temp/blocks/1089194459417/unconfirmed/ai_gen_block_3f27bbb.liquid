{% doc %}
  @prompt
    build a full page with bento grid section to show 4 product first on left and on right rest 3, product are not visible after selectefd, I want in bento grid style, I want for 4 product , all in rectangle shape
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_products = block.settings.products %}

{% style %}
  .ai-bento-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; padding: {{ block.settings.section_padding }}px 0; color: {{ block.settings.text_color }}; }
  .ai-bento-{{ ai_gen_id }}__heading { margin: 0 0 24px; font-size: clamp(24px, 3vw, 40px); line-height: 1.1; }
  .ai-bento-{{ ai_gen_id }}__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: {{ block.settings.gap_size }}px; width: 100%; }
  .ai-bento-{{ ai_gen_id }}__card { position: relative; display: block; min-width: 0; overflow: hidden; aspect-ratio: 4 / 3; color: #fff; background: {{ block.settings.card_background }}; border-radius: {{ block.settings.corner_radius }}px; text-decoration: none; }
  .ai-bento-{{ ai_gen_id }}__media { position: absolute; inset: 0; display: block; }
  .ai-bento-{{ ai_gen_id }}__media::after { content: ''; position: absolute; inset: 35% 0 0; background: linear-gradient(transparent, rgba(0,0,0,.72)); }
  .ai-bento-{{ ai_gen_id }}__media img, .ai-bento-{{ ai_gen_id }}__placeholder svg { display: block; width: 100%; height: 100%; object-fit: cover; }
  .ai-bento-{{ ai_gen_id }}__placeholder { display: block; width: 100%; height: 100%; color: #555; }
  .ai-bento-{{ ai_gen_id }}__details { position: absolute; z-index: 1; right: 0; bottom: 0; left: 0; display: flex; justify-content: space-between; align-items: flex-end; gap: 12px; padding: 18px; }
  .ai-bento-{{ ai_gen_id }}__title { margin: 0; color: #fff; font-size: clamp(14px, 1.35vw, 20px); line-height: 1.25; font-weight: 600; }
  .ai-bento-{{ ai_gen_id }}__price { flex: 0 0 auto; color: #fff; font-size: 14px; line-height: 1.4; }
  .ai-bento-{{ ai_gen_id }}__empty { padding: 32px; color: {{ block.settings.text_color }}; text-align: center; background: {{ block.settings.card_background }}; border-radius: {{ block.settings.corner_radius }}px; }
  .ai-bento-{{ ai_gen_id }}__card:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  @media screen and (max-width: 749px) {
    .ai-bento-{{ ai_gen_id }}__grid { grid-template-columns: 1fr; }
    .ai-bento-{{ ai_gen_id }}__card { aspect-ratio: 16 / 10; }
    .ai-bento-{{ ai_gen_id }}__details { padding: 14px; }
  }
{% endstyle %}

<section class="ai-bento-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}<h2 class="ai-bento-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>{% endif %}
  {% if selected_products != blank %}
    <div class="ai-bento-{{ ai_gen_id }}__grid">
      {% for product in selected_products limit: 4 %}
        {% if product != blank %}
          <a class="ai-bento-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <div class="ai-bento-{{ ai_gen_id }}__media">
              {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 1400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}
            </div>
            <div class="ai-bento-{{ ai_gen_id }}__details"><h3 class="ai-bento-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3><span class="ai-bento-{{ ai_gen_id }}__price">{{ product.price | money }}</span></div>
          </a>
        {% endif %}
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-bento-{{ ai_gen_id }}__empty">Choose up to four products in this block's Products setting.</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Bento product grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collection" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "section_padding", "label": "Vertical spacing", "min": 0, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "gap_size", "label": "Grid gap", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#202020" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#F5F5F2" }
  ],
  "presets": [{ "name": "Bento product grid" }],
  "tag": null,
  "class": "bento-product-grid"
}
{% endschema %}