{% doc %}
  @prompt
    build a full page with bento grid section to show 4 product first on left and on right rest 3
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign selected_products = block.settings.products %}
{% assign left_products = selected_products | slice: 0, 4 %}
{% assign right_products = selected_products | slice: 4, 3 %}

{% style %}
  .ai-bento-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 0;
    color: {{ block.settings.text_color }};
  }

  .ai-bento-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    font-size: clamp(24px, 3vw, 40px);
    line-height: 1.1;
  }

  .ai-bento-{{ ai_gen_id }}__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(0, 1fr);
    gap: {{ block.settings.gap_size }}px;
    width: 100%;
  }

  .ai-bento-{{ ai_gen_id }}__left,
  .ai-bento-{{ ai_gen_id }}__right {
    display: grid;
    min-width: 0;
    gap: {{ block.settings.gap_size }}px;
  }

  .ai-bento-{{ ai_gen_id }}__left {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .ai-bento-{{ ai_gen_id }}__right {
    grid-template-columns: 1fr;
    grid-template-rows: repeat(3, minmax(0, 1fr));
  }

  .ai-bento-{{ ai_gen_id }}__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    color: inherit;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.corner_radius }}px;
    text-decoration: none;
  }

  .ai-bento-{{ ai_gen_id }}__media {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 1 / 1.08;
    background: #f2f2ef;
  }

  .ai-bento-{{ ai_gen_id }}__right .ai-bento-{{ ai_gen_id }}__media {
    aspect-ratio: 1.38 / 1;
  }

  .ai-bento-{{ ai_gen_id }}__media img,
  .ai-bento-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bento-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    color: #656565;
  }

  .ai-bento-{{ ai_gen_id }}__details {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    padding: 14px 2px 2px;
  }

  .ai-bento-{{ ai_gen_id }}__title {
    margin: 0;
    font-size: 15px;
    line-height: 1.35;
    font-weight: 500;
  }

  .ai-bento-{{ ai_gen_id }}__price {
    flex: 0 0 auto;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-bento-{{ ai_gen_id }}__empty {
    grid-column: 1 / -1;
    padding: 32px;
    text-align: center;
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.corner_radius }}px;
  }

  @media screen and (max-width: 749px) {
    .ai-bento-{{ ai_gen_id }}__layout {
      grid-template-columns: 1fr;
    }

    .ai-bento-{{ ai_gen_id }}__right {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
    }

    .ai-bento-{{ ai_gen_id }}__right .ai-bento-{{ ai_gen_id }}__media {
      aspect-ratio: 1 / 1.08;
    }
  }

  @media screen and (max-width: 480px) {
    .ai-bento-{{ ai_gen_id }}__left,
    .ai-bento-{{ ai_gen_id }}__right {
      gap: 12px;
    }

    .ai-bento-{{ ai_gen_id }}__details {
      flex-direction: column;
      gap: 4px;
      padding-top: 10px;
    }
  }
{% endstyle %}

<section class="ai-bento-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-bento-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}
  {% if selected_products != blank %}
    <div class="ai-bento-{{ ai_gen_id }}__layout">
      <div class="ai-bento-{{ ai_gen_id }}__left">
        {% for product in left_products %}
          <a class="ai-bento-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <div class="ai-bento-{{ ai_gen_id }}__media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: product.featured_image.alt | default: product.title }}
              {% else %}
                <div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <div class="ai-bento-{{ ai_gen_id }}__details">
              <h3 class="ai-bento-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
              <span class="ai-bento-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
      <div class="ai-bento-{{ ai_gen_id }}__right">
        {% for product in right_products %}
          <a class="ai-bento-{{ ai_gen_id }}__card" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
            <div class="ai-bento-{{ ai_gen_id }}__media">
              {% if product.featured_image %}
                {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360, 540, 720, 900', alt: product.featured_image.alt | default: product.title }}
              {% else %}
                <div class="ai-bento-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>
            <div class="ai-bento-{{ ai_gen_id }}__details">
              <h3 class="ai-bento-{{ ai_gen_id }}__title">{{ product.title | escape }}</h3>
              <span class="ai-bento-{{ ai_gen_id }}__price">{{ product.price | money }}</span>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <div class="ai-bento-{{ ai_gen_id }}__empty">Select up to seven products to populate this bento grid.</div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Bento product grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the collection"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 7
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Vertical spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "gap_size",
      "label": "Grid gap",
      "min": 8,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#202020"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#F5F5F2"
    }
  ],
  "presets": [
    {
      "name": "Bento product grid"
    }
  ],
  "tag": null,
  "class": "bento-product-grid"
}
{% endschema %}