e_5_line_two","label":"Title line 2","default":"BEACH"},{"type":"textarea","id":"slide_5_description","label":"Description","default":"Mauris malesuada nisi sit amet augue accumsan tincidunt. Maecenas tincidunt, velit ac porttitor pulvinar, tortor eros facilisis libero."},{"type":"text","id":"slide_5_label","label":"Button label","default":"Discover location"},{"type":"url","id":"slide_5_link","label":"Button link"},{"type":"header","content":"Slide 6"},{"type":"image_picker","id":"slide_6_image","label":"Image"},{"type":"text","id":"slide_6_location","label":"Location","default":"Cappadocia - Turkey"},{"type":"text","id":"slide_6_line_one","label":"Title line 1","default":"GÖREME"},{"type":"text","id":"slide_6_line_two","label":"Title line 2","default":"VALLEY"},{"type":"textarea","id":"slide_6_description","label":"Description","default":"Mauris malesuada nisi sit amet augue accumsan tincidunt. Maecenas tincidunt, velit ac porttitor pulvinar, tortor eros facilisis libero."},{"type":"text","id":"slide_6_label","label":"Button label","default":"Discover location"},{"type":"url","id":"slide_6_link","label":"Button link"}],"presets":[{"name":"Destination slider"}],"tag":null,"class":"destination-slider"}{% endschema %}