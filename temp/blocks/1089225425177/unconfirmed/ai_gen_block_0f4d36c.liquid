{% doc %}
  @prompt
    Create a premium, minimalist FAQ section for the babywear brand KISS & KRY, replicating the supplied reference screenshot as closely as possible.
    
    STRICT INSTRUCTION: The uploaded screenshot is the exact visual reference. Do not redesign, reinterpret, or introduce a different layout. Reproduce the same two-column structure, typography, colours, spacing, accordion styling, button shapes, and alignment.
    
    1. OVERALL SECTION DESIGN
    
    Full-width Shopify section.
    
    Background colour: warm pale cream (#F5F3E7).
    
    Maximum content width: 1200px.
    
    Desktop horizontal padding: 60px.
    
    Desktop vertical padding: 75px.
    
    Two-column layout.
    
    Left column: approximately 42% width.
    
    Right column: approximately 58% width.
    
    Column gap: 45px.
    
    Vertically align both columns towards the top.
    
    Premium, minimal, Scandinavian-inspired aesthetic.
    
    Use Montserrat typography throughout.
    
    2. LEFT COLUMN – FAQ INTRODUCTION
    
    Create a vertically aligned content block on the left.
    
    Eyebrow text:
    
    "— FAQ"
    
    Font: Montserrat Medium.
    
    Size: 10px.
    
    Uppercase.
    
    Letter spacing: 2px.
    
    Colour: muted olive (#777D5D).
    
    Small margin below.
    
    Main heading:
    
    "Questions?
    We've Got Answers."
    
    Font: Montserrat Bold.
    
    Desktop font size: 38px.
    
    Line height: 1.08.
    
    Colour: dark olive (#626B4C).
    
    Left aligned.
    
    Maximum width: 400px.
    
    Maintain the exact two-line structure.
    
    Description:
    
    "Can't find what you're looking for? We're happy to help with sizing, orders and returns."
    
    Font: Montserrat Regular.
    
    Size: 13px.
    
    Line height: 1.6.
    
    Colour: muted grey olive (#858575).
    
    Maximum width: 370px.
    
    Margin-top: 16px.
    
    Margin-bottom: 25px.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  {{ settings.type_body_font | font_face }}
  {{ settings.type_heading_font | font_face }}
  .ai-faq-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.description_color }};
    padding: 75px 60px;
  }
  .ai-faq-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 42fr 58fr;
    gap: 45px;
    align-items: start;
  }
  .ai-faq-{{ ai_gen_id }}__intro { min-width: 0; }
  .ai-faq-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 13px;
    color: {{ block.settings.eyebrow_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .ai-faq-{{ ai_gen_id }}__heading {
    max-width: 400px;
    margin: 0;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: 38px;
    font-weight: 700;
    line-height: 1.08;
  }
  .ai-faq-{{ ai_gen_id }}__description {
    max-width: 370px;
    margin: 16px 0 25px;
    color: {{ block.settings.description_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 13px;
    line-height: 1.6;
  }
  .ai-faq-{{ ai_gen_id }}__contact {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 20px;
    border: 1px solid {{ block.settings.heading_color }};
    border-radius: 30px;
    color: {{ block.settings.heading_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .4px;
    text-decoration: none;
  }
  .ai-faq-{{ ai_gen_id }}__contact:hover { background: {{ block.settings.heading_color }}; color: {{ block.settings.background_color }}; }
  .ai-faq-{{ ai_gen_id }}__contact:focus-visible,
  .ai-faq-{{ ai_gen_id }}__question:focus-visible { outline: 2px solid {{ block.settings.heading_color }}; outline-offset: 4px; }
  .ai-faq-{{ ai_gen_id }}__list { min-width: 0; }
  .ai-faq-{{ ai_gen_id }}__item { border-bottom: 1px solid {{ block.settings.divider_color }}; }
  .ai-faq-{{ ai_gen_id }}__item:first-child { border-top: 1px solid {{ block.settings.divider_color }}; }
  .ai-faq-{{ ai_gen_id }}__question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 21px 0;
    border: 0;
    background: transparent;
    color: {{ block.settings.heading_color }};
    text-align: left;
    cursor: pointer;
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
  }
  .ai-faq-{{ ai_gen_id }}__icon { flex: 0 0 18px; width: 18px; height: 18px; position: relative; color: {{ block.settings.heading_color }}; }
  .ai-faq-{{ ai_gen_id }}__icon::before,
  .ai-faq-{{ ai_gen_id }}__icon::after { content: ''; position: absolute; top: 8px; left: 3px; width: 12px; height: 1px; background: currentColor; }
  .ai-faq-{{ ai_gen_id }}__icon::after { transform: rotate(90deg); }
  .ai-faq-{{ ai_gen_id }}__question[aria-expanded='true'] .ai-faq-{{ ai_gen_id }}__icon::after { display: none; }
  .ai-faq-{{ ai_gen_id }}__answer { padding: 0 34px 20px 0; color: {{ block.settings.description_color }}; font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}; font-size: 13px; line-height: 1.65; }
  .ai-faq-{{ ai_gen_id }}__answer p { margin: 0; }
  @media screen and (max-width: 749px) {
    .ai-faq-{{ ai_gen_id }} { padding: 48px 22px; }
    .ai-faq-{{ ai_gen_id }}__inner { width: 100%; grid-template-columns: 1fr; gap: 30px; }
    .ai-faq-{{ ai_gen_id }}__heading { font-size: 32px; }
    .ai-faq-{{ ai_gen_id }}__question { padding: 18px 0; font-size: 13px; }
  }
{% endstyle %}

<faq-accordion-{{ ai_gen_id }} class="ai-faq-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-{{ ai_gen_id }}__inner">
    <div class="ai-faq-{{ ai_gen_id }}__intro">
      <p class="ai-faq-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
      <h2 class="ai-faq-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>
      <p class="ai-faq-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>
      {% if block.settings.contact_link != blank %}<a class="ai-faq-{{ ai_gen_id }}__contact" href="{{ block.settings.contact_link }}">{{ block.settings.contact_label | escape }}</a>{% endif %}
    </div>
    <div class="ai-faq-{{ ai_gen_id }}__list">
      {% for i in (1..5) %}
        {% liquid
          assign question_key = 'question_' | append: i
          assign answer_key = 'answer_' | append: i
          assign question_text = block.settings[question_key]
          assign answer_text = block.settings[answer_key]
        %}
        {% if question_text != blank %}
          <div class="ai-faq-{{ ai_gen_id }}__item">
            <button class="ai-faq-{{ ai_gen_id }}__question" type="button" aria-expanded="false" aria-controls="ai-faq-answer-{{ ai_gen_id }}-{{ i }}">
              <span>{{ question_text | escape }}</span><span class="ai-faq-{{ ai_gen_id }}__icon" aria-hidden="true"></span>
            </button>
            <div class="ai-faq-{{ ai_gen_id }}__answer" id="ai-faq-answer-{{ ai_gen_id }}-{{ i }}" hidden>{{ answer_text }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
  <script>
    (() => {
      class FaqAccordion{{ ai_gen_id }} extends HTMLElement {
        connectedCallback() {
          this.querySelectorAll('.ai-faq-{{ ai_gen_id }}__question').forEach((button) => {
            button.addEventListener('click', () => {
              const expanded = button.getAttribute('aria-expanded') === 'true';
              button.setAttribute('aria-expanded', String(!expanded));
              const panel = this.querySelector(`#${button.getAttribute('aria-controls')}`);
              panel.hidden = expanded;
            });
          });
        }
      }
      const tagName = 'faq-accordion-{{ ai_gen_id }}';
      if (!customElements.get(tagName)) customElements.define(tagName, FaqAccordion{{ ai_gen_id }});
    })();
  </script>
</faq-accordion-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Minimal FAQ",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Introduction" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— FAQ" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Questions?\nWe've Got Answers." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Can't find what you're looking for? We're happy to help with sizing, orders and returns." },
    { "type": "text", "id": "contact_label", "label": "Contact button", "default": "GET IN TOUCH" },
    { "type": "url", "id": "contact_link", "label": "Contact link" },
    { "type": "header", "content": "FAQ items" },
    { "type": "text", "id": "question_1", "label": "Question 1", "default": "How do I choose the right size?" },
    { "type": "richtext", "id": "answer_1", "label": "Answer 1", "default": "<p>Use our size guide to find the best fit for your little one. If you need help, reach out and we’ll be happy to assist.</p>" },
    { "type": "text", "id": "question_2", "label": "Question 2", "default": "What materials are your babywear made from?" },
    { "type": "richtext", "id": "answer_2", "label": "Answer 2", "default": "<p>Our garments are thoughtfully made with soft, comfortable materials selected for everyday wear.</p>" },
    { "type": "text", "id": "question_3", "label": "Question 3", "default": "When will my order ship?" },
    { "type": "richtext", "id": "answer_3", "label": "Answer 3", "default": "<p>Order processing and delivery estimates are shared at checkout and in your order confirmation.</p>" },
    { "type": "text", "id": "question_4", "label": "Question 4", "default": "What is your return policy?" },
    { "type": "richtext", "id": "answer_4", "label": "Answer 4", "default": "<p>Please review our returns page for current eligibility and instructions. Contact us if you have questions.</p>" },
    { "type": "text", "id": "question_5", "label": "Question 5", "default": "Can I change or cancel my order?" },
    { "type": "richtext", "id": "answer_5", "label": "Answer 5", "default": "<p>Contact us as soon as possible after placing your order and we’ll let you know what options are available.</p>" },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F5F3E7" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#626B4C" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#777D5D" },
    { "type": "color", "id": "description_color", "label": "Body text", "default": "#666657" },
    { "type": "color", "id": "divider_color", "label": "Dividers", "default": "#D8D7C8" }
  ],
  "presets": [{ "name": "Minimal FAQ" }],
  "tag": null,
  "class": "minimal-faq-block"
}
{% endschema %}