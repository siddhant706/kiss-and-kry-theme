{% doc %}
  @prompt
    Create a simple, clean and premium Shopify footer for KISS & KRY, a bamboo babywear brand.
    
    ### 1. Design
    - Full-width dark olive background: #383F2A.
    - Text colour: warm cream #F5F3E7.
    - Use Montserrat typography throughout.
    - Minimal, elegant and uncluttered layout.
    - Desktop padding: 40px 50px.
    - No gradients, shadows or decorative graphics.
    
    ### 2. Desktop Layout
    
    Create four simple columns:
    
    **Column 1 – Brand**
    - Heading: Kiss and Kry
    - Description: "Born from bamboo. Made for baby. Ultra-soft, naturally breathable essentials for every kiss and every cry."
    - Four small social icons: Instagram, Facebook, YouTube and Pinterest.
    
    **Column 2 – Shop**
    - Bodysuits
    - Footies
    - Rompers
    - Crib Sheets
    
    **Column 3 – Explore**
    - Why Bamboo
    - Our Story
    - Reviews
    - Care Guide
    - FAQ
    
    **Column 4 – Contact**
    - Chat on WhatsApp
    - Send us an email
    - @kissandkry
    
    ### 3. Typography
    - Brand heading: Montserrat Bold, 20px.
    - Column headings: Montserrat SemiBold, 11px, uppercase, mustard accent #DDAA32.
    - Navigation links: Montserrat Regular, 11px.
    - Description: Montserrat Regular, 11px.
    - Text colour: #C7C8B8.
    - Link hover colour: #FFFFFF.
    
    ### 4. Bottom Bar
    
    Add a thin horizontal divider.
    
    Below it, create a simple bottom row:
    
    Left:
    "© 2026 Kiss and Kry. All rights reserved."
    
    Centre:
    Small payment badges for UPI, VISA, Mastercard, RuPay and COD.
    
    Right:
    - Privacy Policy
    - Terms of Service
    - Refund Policy
    
    Use small 9px Montserrat text.
    
    ### 5. Responsive Design
    - Desktop: Four columns horizontally aligned.
    - Tablet: Two-column layout.
    - Mobile: Stack brand information, navigation and contact details vertically.
    - Centre the bottom copyright and legal links on mobile.
    - Prevent horizontal scrolling.
    
    ### 6. Shopify Functionality
    - Make all navigation links clickable.
    - Make social icons link to their respective profiles.
    - Make WhatsApp and email links functional.
    - Use Shopify's native policy URLs.
    - Make text, links, colours and social URLs editable through the Theme Editor.
    - Generate clean, self-contained Shopify Liquid code.
    - Ensure compatibility with Shopify 2.0.
    
    ### IMPORTANT
    Keep the footer SIMPLE. Do not add newsletter forms, extra sections, large icons, decorative illustrations, animations, extra columns or unnecessary elements. Prioritise clean spacing, readability and a premium olive-and-cream aesthetic.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-footer-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    box-sizing: border-box;
    padding: 40px 50px 18px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.footer_font.family }}, {{ block.settings.footer_font.fallback_families }};
    overflow-wrap: anywhere;
  }
  .ai-footer-{{ ai_gen_id }} *, .ai-footer-{{ ai_gen_id }} *::before, .ai-footer-{{ ai_gen_id }} *::after { box-sizing: border-box; }
  .ai-footer-{{ ai_gen_id }}__columns { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 36px; }
  .ai-footer-{{ ai_gen_id }}__brand-title { margin: 0 0 12px; color: {{ block.settings.text_color }}; font-size: 20px; line-height: 1.3; font-weight: 700; }
  .ai-footer-{{ ai_gen_id }}__description, .ai-footer-{{ ai_gen_id }}__link { color: {{ block.settings.text_color }}; font-size: 11px; font-weight: 400; line-height: 1.8; }
  .ai-footer-{{ ai_gen_id }}__description { max-width: 310px; margin: 0; }
  .ai-footer-{{ ai_gen_id }}__heading { margin: 2px 0 13px; color: {{ block.settings.accent_color }}; font-size: 11px; line-height: 1.4; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .ai-footer-{{ ai_gen_id }}__list { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
  .ai-footer-{{ ai_gen_id }}__link { text-decoration: none; }
  .ai-footer-{{ ai_gen_id }}__link:hover { color: {{ block.settings.hover_color }}; text-decoration: underline; text-underline-offset: 3px; }
  .ai-footer-{{ ai_gen_id }}__link:focus-visible { outline: 2px solid {{ block.settings.hover_color }}; outline-offset: 3px; }
  .ai-footer-{{ ai_gen_id }}__socials { display: flex; gap: 13px; margin-top: 17px; }
  .ai-footer-{{ ai_gen_id }}__social-link { display: inline-flex; width: 17px; height: 17px; color: {{ block.settings.text_color }}; }
  .ai-footer-{{ ai_gen_id }}__social-link:hover { color: {{ block.settings.hover_color }}; }
  .ai-footer-{{ ai_gen_id }}__social-link svg { width: 100%; height: 100%; fill: currentColor; }
  .ai-footer-{{ ai_gen_id }}__bottom { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 18px; margin-top: 31px; padding-top: 15px; border-top: 1px solid {{ block.settings.divider_color }}; }
  .ai-footer-{{ ai_gen_id }}__fine, .ai-footer-{{ ai_gen_id }}__legal a { color: {{ block.settings.text_color }}; font-size: 9px; line-height: 1.6; text-decoration: none; }
  .ai-footer-{{ ai_gen_id }}__payments { display: flex; justify-content: center; flex-wrap: wrap; gap: 5px; }
  .ai-footer-{{ ai_gen_id }}__payment { display: inline-flex; align-items: center; justify-content: center; min-height: 19px; padding: 2px 5px; border: 1px solid {{ block.settings.text_color }}; border-radius: 2px; color: {{ block.settings.text_color }}; font-size: 8px; font-weight: 600; letter-spacing: .02em; white-space: nowrap; }
  .ai-footer-{{ ai_gen_id }}__legal { display: flex; justify-content: flex-end; flex-wrap: wrap; gap: 13px; }
  .ai-footer-{{ ai_gen_id }}__legal a:hover { color: {{ block.settings.hover_color }}; text-decoration: underline; }
  @media screen and (max-width: 989px) {
    .ai-footer-{{ ai_gen_id }}__columns { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 30px; }
  }
  @media screen and (max-width: 600px) {
    .ai-footer-{{ ai_gen_id }} { padding: 32px 22px 18px; }
    .ai-footer-{{ ai_gen_id }}__columns { grid-template-columns: 1fr; gap: 25px; }
    .ai-footer-{{ ai_gen_id }}__bottom { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 12px; margin-top: 25px; }
    .ai-footer-{{ ai_gen_id }}__legal { justify-content: center; }
  }
{% endstyle %}

<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-footer-{{ ai_gen_id }}__columns">
    <div>
      <h2 class="ai-footer-{{ ai_gen_id }}__brand-title">{{ block.settings.brand_name | escape }}</h2>
      <p class="ai-footer-{{ ai_gen_id }}__description">{{ block.settings.brand_description | escape }}</p>
      <div class="ai-footer-{{ ai_gen_id }}__socials" aria-label="Social media">
        {% if block.settings.instagram_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.instagram_url }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2.2A2.8 2.8 0 0 0 4.2 7v10A2.8 2.8 0 0 0 7 19.8h10a2.8 2.8 0 0 0 2.8-2.8V7A2.8 2.8 0 0 0 17 4.2H7zm5 3.1a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4zm0 2.2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zm5.1-3.5a1.1 1.1 0 1 1 0 2.2 1.1 1.1 0 0 1 0-2.2z"/></svg></a>{% endif %}
        {% if block.settings.facebook_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.facebook_url }}" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.4 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7H17V2.5c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.7-4.6 4.8v2.3H6.6V13h3.1v9h3.7z"/></svg></a>{% endif %}
        {% if block.settings.youtube_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.youtube_url }}" aria-label="YouTube"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4L15.8 12z"/></svg></a>{% endif %}
        {% if block.settings.pinterest_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.pinterest_url }}" aria-label="Pinterest"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.6 19.3c0-.8 0-1.8.2-2.7l1.3-5.5s-.3-.6-.3-1.5c0-1.4.8-2.5 1.9-2.5.9 0 1.3.7 1.3 1.5 0 .9-.6 2.3-.9 3.6-.3 1.1.5 2 1.6 2 1.9 0 3.3-2.5 3.3-5.5 0-2.3-1.6-4-4.4-4-3.2 0-5.2 2.4-5.2 5.1 0 .9.3 1.8.7 2.3.2.3.2.4.1.7l-.2.9c-.1.3-.3.4-.6.3-1.4-.6-2-2.2-2-4 0-3 2.5-6.6 7.6-6.6 4.1 0 6.8 3 6.8 6.3 0 4.3-2.4 7.6-6 7.6-1.2 0-2.4-.7-2.8-1.5l-.8 3.1c-.3.9-.7 1.8-1.1 2.5A10 10 0 1 0 12 2z"/></svg></a>{% endif %}
      </div>
    </div>
    <div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.shop_heading | escape }}</h3><nav class="ai-footer-{{ ai_gen_id }}__list" aria-label="Shop">{% for i in (1..4) %}{% assign label_key = 'shop_label_' | append: i %}{% assign url_key = 'shop_url_' | append: i %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings[url_key] | default: routes.all_products_collection_url }}">{{ block.settings[label_key] | escape }}</a>{% endfor %}</nav></div>
    <div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.explore_heading | escape }}</h3><nav class="ai-footer-{{ ai_gen_id }}__list" aria-label="Explore">{% for i in (1..5) %}{% assign label_key = 'explore_label_' | append: i %}{% assign url_key = 'explore_url_' | append: i %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings[url_key] | default: routes.root_url }}">{{ block.settings[label_key] | escape }}</a>{% endfor %}</nav></div>
    <div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.contact_heading | escape }}</h3><div class="ai-footer-{{ ai_gen_id }}__list">{% if block.settings.whatsapp_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.whatsapp_url }}">{{ block.settings.whatsapp_label | escape }}</a>{% endif %}{% if block.settings.contact_email != blank %}<a class="ai-footer-{{ ai_gen_id }}__link" href="mailto:{{ block.settings.contact_email | escape }}">{{ block.settings.email_label | escape }}</a>{% endif %}{% if block.settings.instagram_handle_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings.instagram_handle_url }}">{{ block.settings.instagram_handle | escape }}</a>{% endif %}</div></div>
  </div>
  <div class="ai-footer-{{ ai_gen_id }}__bottom">
    <div class="ai-footer-{{ ai_gen_id }}__fine">{{ block.settings.copyright_text | escape }}</div>
    <div class="ai-footer-{{ ai_gen_id }}__payments" aria-label="Accepted payment methods"><span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings.payment_one | escape }}</span><span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings.payment_two | escape }}</span><span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings.payment_three | escape }}</span><span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings.payment_four | escape }}</span><span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings.payment_five | escape }}</span></div>
    <nav class="ai-footer-{{ ai_gen_id }}__legal" aria-label="Policies"><a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ block.settings.privacy_label | escape }}</a><a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">{{ block.settings.terms_label | escape }}</a><a href="{{ shop.policies.refund_policy.url | default: '/policies/refund-policy' }}">{{ block.settings.refund_label | escape }}</a></nav>
  </div>
</footer>

