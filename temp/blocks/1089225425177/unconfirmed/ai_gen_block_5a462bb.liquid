{% doc %}
  @prompt
    Create a simple, clean and premium Shopify footer for KISS & KRY, a bamboo babywear brand.
    
    ### 1. Design
    - Full-width dark olive background: #383F2A.
    - Text colour: warm cream #F5F3E7.
    - Use Montserrat typography throughout.
    - Minimal, elegant and uncluttered layout.
    - Desktop padding: 40px 50px.
    - No gradients, shadows or decorative graphics.
    
    ### 2. Desktop Layout
    
    Create four simple columns:
    
    **Column 1 – Brand**
    - Heading: Kiss and Kry
    - Description: "Born from bamboo. Made for baby. Ultra-soft, naturally breathable essentials for every kiss and every cry."
    - Four small social icons: Instagram, Facebook, YouTube and Pinterest.
    
    **Column 2 – Shop**
    - Bodysuits
    - Footies
    - Rompers
    - Crib Sheets
    
    **Column 3 – Explore**
    - Why Bamboo
    - Our Story
    - Reviews
    - Care Guide
    - FAQ
    
    **Column 4 – Contact**
    - Chat on WhatsApp
    - Send us an email
    - @kissandkry
    
    ### 3. Typography
    - Brand heading: Montserrat Bold, 20px.
    - Column headings: Montserrat SemiBold, 11px, uppercase, mustard accent #DDAA32.
    - Navigation links: Montserrat Regular, 11px.
    - Description: Montserrat Regular, 11px.
    - Text colour: #C7C8B8.
    - Link hover colour: #FFFFFF.
    
    ### 4. Bottom Bar
    
    Add a thin horizontal divider.
    
    Below it, create a simple bottom row:
    
    Left:
    "© 2026 Kiss and Kry. All rights reserved."
    
    Centre:
    Small payment badges for UPI, VISA, Mastercard, RuPay and COD.
    
    Right:
    - Privacy Policy
    - Terms of Service
    - Refund Policy
    
    Use small 9px Montserrat text.
    
    ### 5. Responsive Design
    - Desktop: Four columns horizontally aligned.
    - Tablet: Two-column layout.
    - Mobile: Stack brand information, navigation and contact details vertically.
    - Centre the bottom copyright and legal links on mobile.
    - Prevent horizontal scrolling.
    
    ### 6. Shopify Functionality
    - Make all navigation links clickable.
    - Make social icons link to their respective profiles.
    - Make WhatsApp and email links functional.
    - Use Shopify's native policy URLs.
    - Make text, links, colours and social URLs editable through the Theme Editor.
    - Generate clean, self-contained Shopify Liquid code.
    - Ensure compatibility with Shopify 2.0.
    
    ### IMPORTANT
    Keep the footer SIMPLE. Do not add newsletter forms, extra sections, large icons, decorative illustrations, animations, extra columns or unnecessary elements. Prioritise clean spacing, readability and a premium olive-and-cream aesthetic., add this contact details as 
    ### Kiss & Kry – Complete Contact Details
    
    - Instagram: [@kissandkry](https://www.instagram.com/kissandkry/?utm_source=chatgpt.com)
    - Facebook: [Kiss & Kry Facebook Page](https://www.facebook.com/profile.php?id=61563831763161\&utm_source=chatgpt.com)
    - WhatsApp: [+91 99997 38480](https://wa.me/919999738480?utm_source=chatgpt.com)
    - Phone: +91 99997 38480
    
    All four details can now be added to your Shopify footer as clickable links.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign instagram_link = block.settings.instagram_url | default: 'https://www.instagram.com/kissandkry/' %}
{% assign facebook_link = block.settings.facebook_url | default: 'https://www.facebook.com/profile.php?id=61563831763161' %}
{% assign whatsapp_link = block.settings.whatsapp_url | default: 'https://wa.me/919999738480' %}
{% style %}
.ai-footer-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;padding:40px 50px 18px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};font-family:{{ block.settings.footer_font.family }},{{ block.settings.footer_font.fallback_families }};overflow-wrap:anywhere}.ai-footer-{{ ai_gen_id }} *,.ai-footer-{{ ai_gen_id }} *::before,.ai-footer-{{ ai_gen_id }} *::after{box-sizing:border-box}.ai-footer-{{ ai_gen_id }}__columns{display:grid;grid-template-columns:1.6fr 1fr 1fr 1fr;gap:36px}.ai-footer-{{ ai_gen_id }}__brand-title{margin:0 0 12px;color:{{ block.settings.text_color }};font-size:20px;line-height:1.3;font-weight:700}.ai-footer-{{ ai_gen_id }}__description,.ai-footer-{{ ai_gen_id }}__link{color:{{ block.settings.text_color }};font-size:11px;font-weight:400;line-height:1.8}.ai-footer-{{ ai_gen_id }}__description{max-width:310px;margin:0}.ai-footer-{{ ai_gen_id }}__heading{margin:2px 0 13px;color:{{ block.settings.accent_color }};font-size:11px;line-height:1.4;font-weight:600;letter-spacing:.08em;text-transform:uppercase}.ai-footer-{{ ai_gen_id }}__list{display:flex;flex-direction:column;align-items:flex-start;gap:6px}.ai-footer-{{ ai_gen_id }}__link{text-decoration:none}.ai-footer-{{ ai_gen_id }}__link:hover,.ai-footer-{{ ai_gen_id }}__legal a:hover{color:{{ block.settings.hover_color }};text-decoration:underline;text-underline-offset:3px}.ai-footer-{{ ai_gen_id }}__link:focus-visible,.ai-footer-{{ ai_gen_id }}__social-link:focus-visible,.ai-footer-{{ ai_gen_id }}__legal a:focus-visible{outline:2px solid {{ block.settings.hover_color }};outline-offset:3px}.ai-footer-{{ ai_gen_id }}__socials{display:flex;gap:13px;margin-top:17px}.ai-footer-{{ ai_gen_id }}__social-link{display:inline-flex;width:17px;height:17px;color:{{ block.settings.text_color }}}.ai-footer-{{ ai_gen_id }}__social-link:hover{color:{{ block.settings.hover_color }}}.ai-footer-{{ ai_gen_id }}__social-link svg{width:100%;height:100%;fill:currentColor}.ai-footer-{{ ai_gen_id }}__bottom{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;margin-top:31px;padding-top:15px;border-top:1px solid {{ block.settings.divider_color }}}.ai-footer-{{ ai_gen_id }}__fine,.ai-footer-{{ ai_gen_id }}__legal a{color:{{ block.settings.text_color }};font-size:9px;line-height:1.6;text-decoration:none}.ai-footer-{{ ai_gen_id }}__payments{display:flex;justify-content:center;flex-wrap:wrap;gap:5px}.ai-footer-{{ ai_gen_id }}__payment{display:inline-flex;align-items:center;justify-content:center;min-height:19px;padding:2px 5px;border:1px solid {{ block.settings.text_color }};border-radius:2px;color:{{ block.settings.text_color }};font-size:8px;font-weight:600;white-space:nowrap}.ai-footer-{{ ai_gen_id }}__legal{display:flex;justify-content:flex-end;flex-wrap:wrap;gap:13px}@media(max-width:989px){.ai-footer-{{ ai_gen_id }}__columns{grid-template-columns:repeat(2,minmax(0,1fr));gap:30px}}@media(max-width:600px){.ai-footer-{{ ai_gen_id }}{padding:32px 22px 18px}.ai-footer-{{ ai_gen_id }}__columns{grid-template-columns:1fr;gap:25px}.ai-footer-{{ ai_gen_id }}__bottom{grid-template-columns:1fr;justify-items:center;text-align:center;gap:12px;margin-top:25px}.ai-footer-{{ ai_gen_id }}__legal{justify-content:center}}
{% endstyle %}
<footer class="ai-footer-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-footer-{{ ai_gen_id }}__columns"><div><h2 class="ai-footer-{{ ai_gen_id }}__brand-title">{{ block.settings.brand_name | escape }}</h2><p class="ai-footer-{{ ai_gen_id }}__description">{{ block.settings.brand_description | escape }}</p><div class="ai-footer-{{ ai_gen_id }}__socials" aria-label="Social media"><a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ instagram_link }}" aria-label="Instagram"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10a5 5 0 0 1 5 5v10a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5V7a5 5 0 0 1 5-5zm0 2.2A2.8 2.8 0 0 0 4.2 7v10A2.8 2.8 0 0 0 7 19.8h10a2.8 2.8 0 0 0 2.8-2.8V7A2.8 2.8 0 0 0 17 4.2H7zm5 3.1a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4zm0 2.2a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg></a><a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ facebook_link }}" aria-label="Facebook"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.4 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.7 1.8-1.7H17V2.5c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.7-4.6 4.8v2.3H6.6V13h3.1v9z"/></svg></a>{% if block.settings.youtube_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.youtube_url }}" aria-label="YouTube">YouTube</a>{% endif %}{% if block.settings.pinterest_url != blank %}<a class="ai-footer-{{ ai_gen_id }}__social-link" href="{{ block.settings.pinterest_url }}" aria-label="Pinterest">Pinterest</a>{% endif %}</div></div>
<div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.shop_heading | escape }}</h3><nav class="ai-footer-{{ ai_gen_id }}__list" aria-label="Shop">{% for i in (1..4) %}{% assign lk = 'shop_label_' | append: i %}{% assign uk = 'shop_url_' | append: i %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings[uk] | default: routes.all_products_collection_url }}">{{ block.settings[lk] | escape }}</a>{% endfor %}</nav></div>
<div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.explore_heading | escape }}</h3><nav class="ai-footer-{{ ai_gen_id }}__list" aria-label="Explore">{% for i in (1..5) %}{% assign lk = 'explore_label_' | append: i %}{% assign uk = 'explore_url_' | append: i %}<a class="ai-footer-{{ ai_gen_id }}__link" href="{{ block.settings[uk] | default: routes.root_url }}">{{ block.settings[lk] | escape }}</a>{% endfor %}</nav></div>
<div><h3 class="ai-footer-{{ ai_gen_id }}__heading">{{ block.settings.contact_heading | escape }}</h3><div class="ai-footer-{{ ai_gen_id }}__list"><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ whatsapp_link }}">{{ block.settings.whatsapp_label | escape }}</a><a class="ai-footer-{{ ai_gen_id }}__link" href="tel:{{ block.settings.phone_number | remove: ' ' | remove: '-' }}">{{ block.settings.phone_number | escape }}</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ instagram_link }}">{{ block.settings.instagram_handle | escape }}</a><a class="ai-footer-{{ ai_gen_id }}__link" href="{{ facebook_link }}">{{ block.settings.facebook_label | escape }}</a></div></div></div>
<div class="ai-footer-{{ ai_gen_id }}__bottom"><div class="ai-footer-{{ ai_gen_id }}__fine">{{ block.settings.copyright_text | escape }}</div><div class="ai-footer-{{ ai_gen_id }}__payments">{% for i in (1..5) %}{% assign pk = 'payment_' | append: i %}<span class="ai-footer-{{ ai_gen_id }}__payment">{{ block.settings[pk] | escape }}</span>{% endfor %}</div><nav class="ai-footer-{{ ai_gen_id }}__legal" aria-label="Policies"><a href="{{ shop.policies.privacy_policy.url | default: '/policies/privacy-policy' }}">{{ block.settings.privacy_label | escape }}</a><a href="{{ shop.policies.terms_of_service.url | default: '/policies/terms-of-service' }}">{{ block.settings.terms_label | escape }}</a><a href="{{ shop.policies.refund_policy.url | default: '/policies/refund-policy' }}">{{ block.settings.refund_label | escape }}</a></nav></div></footer>
{% schema %}
{"name":"Kiss and Kry footer","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"font_picker","id":"footer_font","label":"Font","default":"montserrat_n4"},{"type":"color","id":"background_color","label":"Background","default":"#383F2A"},{"type":"color","id":"text_color","label":"Text","default":"#C7C8B8"},{"type":"color","id":"accent_color","label":"Headings","default":"#DDAA32"},{"type":"color","id":"hover_color","label":"Link hover","default":"#FFFFFF"},{"type":"color","id":"divider_color","label":"Divider","default":"#707465"},{"type":"header","content":"Brand"},{"type":"text","id":"brand_name","label":"Brand name","default":"Kiss and Kry"},{"type":"textarea","id":"brand_description","label":"Description","default":"Born from bamboo. Made for baby. Ultra-soft, naturally breathable essentials for every kiss and every cry."},{"type":"url","id":"instagram_url","label":"Instagram profile"},{"type":"url","id":"facebook_url","label":"Facebook profile"},{"type":"url","id":"youtube_url","label":"YouTube profile"},{"type":"url","id":"pinterest_url","label":"Pinterest profile"},{"type":"header","content":"Shop links"},{"type":"text","id":"shop_heading","label":"Column heading","default":"Shop"},{"type":"text","id":"shop_label_1","label":"Link 1","default":"Bodysuits"},{"type":"url","id":"shop_url_1","label":"Link 1 destination"},{"type":"text","id":"shop_label_2","label":"Link 2","default":"Footies"},{"type":"url","id":"shop_url_2","label":"Link 2 destination"},{"type":"text","id":"shop_label_3","label":"Link 3","default":"Rompers"},{"type":"url","id":"shop_url_3","label":"Link 3 destination"},{"type":"text","id":"shop_label_4","label":"Link 4","default":"Crib Sheets"},{"type":"url","id":"shop_url_4","label":"Link 4 destination"},{"type":"header","content":"Explore links"},{"type":"text","id":"explore_heading","label":"Column heading","default":"Explore"},{"type":"text","id":"explore_label_1","label":"Link 1","default":"Why Bamboo"},{"type":"url","id":"explore_url_1","label":"Link 1 destination"},{"type":"text","id":"explore_label_2","label":"Link 2","default":"Our Story"},{"type":"url","id":"explore_url_2","label":"Link 2 destination"},{"type":"text","id":"explore_label_3","label":"Link 3","default":"Reviews"},{"type":"url","id":"explore_url_3","label":"Link 3 destination"},{"type":"text","id":"explore_label_4","label":"Link 4","default":"Care Guide"},{"type":"url","id":"explore_url_4","label":"Link 4 destination"},{"type":"text","id":"explore_label_5","label":"Link 5","default":"FAQ"},{"type":"url","id":"explore_url_5","label":"Link 5 destination"},{"type":"header","content":"Contact"},{"type":"text","id":"contact_heading","label":"Column heading","default":"Contact"},{"type":"text","id":"whatsapp_label","label":"WhatsApp link text","default":"Chat on WhatsApp: +91 99997 38480"},{"type":"url","id":"whatsapp_url","label":"WhatsApp link"},{"type":"text","id":"phone_number","label":"Phone number","default":"+91 99997 38480"},{"type":"text","id":"instagram_handle","label":"Instagram handle","default":"@kissandkry"},{"type":"text","id":"facebook_label","label":"Facebook link text","default":"Kiss & Kry Facebook Page"},{"type":"header","content":"Bottom bar"},{"type":"text","id":"copyright_text","label":"Copyright text","default":"© 2026 Kiss and Kry. All rights reserved."},{"type":"text","id":"payment_1","label":"Payment badge 1","default":"UPI"},{"type":"text","id":"payment_2","label":"Payment badge 2","default":"VISA"},{"type":"text","id":"payment_3","label":"Payment badge 3","default":"Mastercard"},{"type":"text","id":"payment_4","label":"Payment badge 4","default":"RuPay"},{"type":"text","id":"payment_5","label":"Payment badge 5","default":"COD"},{"type":"text","id":"privacy_label","label":"Privacy link text","default":"Privacy Policy"},{"type":"text","id":"terms_label","label":"Terms link text","default":"Terms of Service"},{"type":"text","id":"refund_label","label":"Refund link text","default":"Refund Policy"}],"presets":[{"name":"Kiss and Kry footer"}],"tag":null,"class":"kiss-and-kry-footer-block"}
{% endschema %}