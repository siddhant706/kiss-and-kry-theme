    { "type": "text", "id": "product_name_3", "label": "Product", "default": "Cosy Rompers" },
    { "type": "image_picker", "id": "product_image_3", "label": "Product image" }
  ],
  "presets": [{ "name": "Customer testimonials" }]
}
