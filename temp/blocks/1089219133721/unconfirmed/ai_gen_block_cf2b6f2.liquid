    { "type": "text", "id": "name_2", "label": "Name", "default": "Meera K." },
    { "type": "text", "id": "initials_2", "label": "Avatar initials", "default": "MK" },
    { "type": "text", "id": "product_name_2", "label": "Product", "default": "Luxurious Bodysuits" },
    { "type": "image_picker", "id": "product_image_2", "label": "Product image" },
    { "type": "header", "content": "Testimonial 3" },
