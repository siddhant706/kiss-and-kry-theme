{% doc %}
  @prompt
    Create a premium, minimal, editorial-style Shopify section for KISS & KRY – Bamboo Babywear, replicating the supplied reference screenshot as closely as possible.
    
    STRICT INSTRUCTION: The uploaded screenshot is the exact design reference. Do not redesign, reinterpret, or introduce a different layout. Maintain the same background, typography, spacing, card proportions, icon placement, and visual hierarchy.
    
    1. OVERALL SECTION DESIGN
    
    Full-width Shopify section.
    
    Background colour: warm beige (#EFE3D6).
    
    Maximum content width: 1200px.
    
    Desktop vertical padding: 75px.
    
    Horizontal padding: 45px.
    
    Minimal, premium, Scandinavian-inspired aesthetic.
    
    All content centred horizontally.
    
    Use Montserrat throughout.
    
    No gradients, heavy shadows, or unnecessary decorations.
    
    2. HEADER – CENTRED ALIGNMENT
    
    Eyebrow text:
    
    "— CARE GUIDE"
    
    Montserrat Medium.
    
    10px.
    
    Uppercase.
    
    Letter spacing: 2px.
    
    Colour: muted olive (#777D5D).
    
    Centre aligned.
    
    Small margin below.
    
    Main heading:
    
    "Keep It Soft, Wash After Wash."
    
    Montserrat Bold.
    
    Desktop font size: 38px.
    
    Line height: 1.2.
    
    Colour: dark olive (#626B4C).
    
    Centre aligned.
    
    Keep on one line on desktop.
    
    Description:
    
    "Bamboo viscose loves a little gentleness. Follow these four simple steps and every piece stays soft for longer."
    
    Montserrat Regular.
    
    13px.
    
    Line height: 1.6.
    
    Colour: muted grey olive (#858575).
    
    Maximum width: 480px.
    
    Centre aligned.
    
    Margin-top: 12px.
    
    Margin-bottom: 40px.
    
    3. FOUR CARE STEP CARDS
    
    Create exactly FOUR equal-sized cards arranged horizontally in one row on desktop.
    
    Each card must have:
    
    Width: approximately 25% of the available content width.
    
    Height: 185px.
    
    Background: warm off-white (#F9F6F1).
    
    Border radius: 18px.
    
    No prominent border.
    
    No heavy shadow.
    
    Padding: 22px.
    
    Text alignment: centre.
    
    Spacing:
    
    18px gap between cards.
    
    All four cards must have identical dimensions.
    
    Maintain consistent vertical alignment.
    
    4. CARD DESIGN AND CONTENT
    
    Each card must follow this exact internal structure:
    
    Large outlined step number at the top-right.
    
    Circular icon container near the top centre.
    
    Bold care instruction heading.
    
    Short supporting description., make all the text in this section rich text, allow me to change icons as PNG and some glassmorph style in cards , make this cards as bento grid style and for any use background image as well, maintain grid style even style 2 same size and 2 different size 1:2 and 2:1, make back as 1:1:1:1 remove BG image feature
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-care-guide-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;box-sizing:border-box;margin-inline:auto;padding:75px 45px;background:{{ block.settings.background_color }};font-family:{{ settings.type_body_font.family }},Montserrat,sans-serif}
.ai-care-guide-{{ ai_gen_id }} *, .ai-care-guide-{{ ai_gen_id }} *::before, .ai-care-guide-{{ ai_gen_id }} *::after{box-sizing:border-box}
.ai-care-guide-{{ ai_gen_id }}__inner{width:100%;max-width:1200px;margin:0 auto;text-align:center}
.ai-care-guide-{{ ai_gen_id }}__eyebrow{margin:0 0 10px;color:{{ block.settings.eyebrow_color }};font-family:{{ settings.type_subheading_font.family }},Montserrat,sans-serif;font-size:10px;font-weight:500;letter-spacing:2px;line-height:1.4;text-transform:uppercase}
.ai-care-guide-{{ ai_gen_id }}__eyebrow p,.ai-care-guide-{{ ai_gen_id }}__title p,.ai-care-guide-{{ ai_gen_id }}__description p,.ai-care-guide-{{ ai_gen_id }}__card-title p,.ai-care-guide-{{ ai_gen_id }}__card-description p{margin:0}
.ai-care-guide-{{ ai_gen_id }}__title{margin:0;color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }},Montserrat,sans-serif;font-size:38px;font-weight:700;line-height:1.2}
.ai-care-guide-{{ ai_gen_id }}__description{max-width:480px;margin:12px auto 40px;color:{{ block.settings.description_color }};font-size:13px;line-height:1.6}
.ai-care-guide-{{ ai_gen_id }}__cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:18px;width:100%;text-align:center}
.ai-care-guide-{{ ai_gen_id }}__card{position:relative;display:flex;min-width:0;min-height:185px;flex-direction:column;align-items:center;justify-content:center;padding:22px 16px;overflow:hidden;border-radius:18px;background-color:{{ block.settings.card_color }};color:{{ block.settings.heading_color }};text-align:center;isolation:isolate}
{% if block.settings.glass_effect %}.ai-care-guide-{{ ai_gen_id }}__card{background-color:rgba(249,246,241,.72);backdrop-filter:blur({{ block.settings.glass_blur }}px);-webkit-backdrop-filter:blur({{ block.settings.glass_blur }}px);border:1px solid rgba(255,255,255,.55)}{% endif %}
.ai-care-guide-{{ ai_gen_id }}__number{position:absolute;top:15px;right:18px;color:transparent;-webkit-text-stroke:1px {{ block.settings.number_color }};font-family:{{ settings.type_heading_font.family }},Montserrat,sans-serif;font-size:21px;font-weight:600;line-height:1}
.ai-care-guide-{{ ai_gen_id }}__icon{display:flex;width:50px;height:50px;flex:0 0 50px;align-items:center;justify-content:center;margin:3px 0 11px;border-radius:50%;background:{{ block.settings.icon_background }};color:{{ block.settings.icon_color }};overflow:hidden}
.ai-care-guide-{{ ai_gen_id }}__icon svg{display:block;width:23px;height:23px;fill:none;stroke:currentColor;stroke-linecap:round;stroke-linejoin:round;stroke-width:1.5}
.ai-care-guide-{{ ai_gen_id }}__icon img{display:block;width:100%;height:100%;object-fit:contain;padding:8px}
.ai-care-guide-{{ ai_gen_id }}__card-title{margin:0 0 6px;color:{{ block.settings.heading_color }};font-family:{{ settings.type_heading_font.family }},Montserrat,sans-serif;font-size:14px;font-weight:700;line-height:1.3}
.ai-care-guide-{{ ai_gen_id }}__card-description{max-width:360px;margin:0;color:{{ block.settings.description_color }};font-size:12px;line-height:1.5}
@media screen and (max-width:749px){.ai-care-guide-{{ ai_gen_id }}{padding:52px 20px}.ai-care-guide-{{ ai_gen_id }}__title{font-size:clamp(27px,7vw,38px)}.ai-care-guide-{{ ai_gen_id }}__description{margin-bottom:28px}.ai-care-guide-{{ ai_gen_id }}__cards{grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.ai-care-guide-{{ ai_gen_id }}__card{min-height:190px;padding:20px 14px}}
@media screen and (max-width:420px){.ai-care-guide-{{ ai_gen_id }}__cards{grid-template-columns:1fr}.ai-care-guide-{{ ai_gen_id }}__card{min-height:175px}}
{% endstyle %}
<div class="ai-care-guide-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-care-guide-{{ ai_gen_id }}__inner"><div class="ai-care-guide-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div><div class="ai-care-guide-{{ ai_gen_id }}__title">{{ block.settings.title }}</div><div class="ai-care-guide-{{ ai_gen_id }}__description">{{ block.settings.description }}</div><div class="ai-care-guide-{{ ai_gen_id }}__cards">
{% for i in (1..4) %}
{% liquid
assign heading_key = 'step_' | append: i | append: '_heading'
assign description_key = 'step_' | append: i | append: '_description'
assign icon_key = 'step_' | append: i | append: '_icon'
assign step_heading = block.settings[heading_key]
assign step_description = block.settings[description_key]
assign step_icon = block.settings[icon_key]
%}
<article class="ai-care-guide-{{ ai_gen_id }}__card"><span class="ai-care-guide-{{ ai_gen_id }}__number" aria-hidden="true">0{{ i }}</span><span class="ai-care-guide-{{ ai_gen_id }}__icon" aria-hidden="true">{% if step_icon != blank %}<img src="{{ step_icon | image_url: width: 120 }}" alt="" loading="lazy" width="120" height="120">{% else %}{% case i %}{% when 1 %}<svg viewBox="0 0 24 24"><path d="M4 7h16l-1.5 13h-13L4 7Z"/><path d="M8 7a4 4 0 0 1 8 0M8 12c1.2 1 2.8 1 4 0s2.8-1 4 0"/></svg>{% when 2 %}<svg viewBox="0 0 24 24"><path d="M12 3 3 20h18L12 3Z"/><path d="m9 14 6-6M8 9l2 2m4 4 2 2"/></svg>{% when 3 %}<svg viewBox="0 0 24 24"><path d="M4 17h16M6 17l1-7h10l1 7M8 10V7a4 4 0 0 1 8 0v3M12 4v2"/></svg>{% when 4 %}<svg viewBox="0 0 24 24"><path d="M4 16.5 18.5 2a2.1 2.1 0 0 1 3 3L7 19.5 3 21l1-4.5Z"/><path d="m14 6 4 4M5 17l2 2"/></svg>{% endcase %}{% endif %}</span><div class="ai-care-guide-{{ ai_gen_id }}__card-title">{{ step_heading }}</div><div class="ai-care-guide-{{ ai_gen_id }}__card-description">{{ step_description }}</div></article>
{% endfor %}</div></div></div>
{% schema %}
{"name":"Bamboo care guide","settings":[{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Header"},{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>— CARE GUIDE</p>"},{"type":"richtext","id":"title","label":"Heading","default":"<p>Keep It Soft, Wash After Wash.</p>"},{"type":"richtext","id":"description","label":"Description","default":"<p>Bamboo viscose loves a little gentleness. Follow these four simple steps and every piece stays soft for longer.</p>"},{"type":"header","content":"Care steps"},{"type":"image_picker","id":"step_1_icon","label":"Step 1 icon PNG"},{"type":"richtext","id":"step_1_heading","label":"Step 1 heading","default":"<p>Wash gently</p>"},{"type":"richtext","id":"step_1_description","label":"Step 1 description","default":"<p>Use a cool, gentle cycle to care for the fibres.</p>"},{"type":"image_picker","id":"step_2_icon","label":"Step 2 icon PNG"},{"type":"richtext","id":"step_2_heading","label":"Step 2 heading","default":"<p>Skip the bleach</p>"},{"type":"richtext","id":"step_2_description","label":"Step 2 description","default":"<p>Choose a mild detergent and avoid harsh whitening agents.</p>"},{"type":"image_picker","id":"step_3_icon","label":"Step 3 icon PNG"},{"type":"richtext","id":"step_3_heading","label":"Step 3 heading","default":"<p>Air dry</p>"},{"type":"richtext","id":"step_3_description","label":"Step 3 description","default":"<p>Lay flat or hang to dry, away from direct heat.</p>"},{"type":"image_picker","id":"step_4_icon","label":"Step 4 icon PNG"},{"type":"richtext","id":"step_4_heading","label":"Step 4 heading","default":"<p>Low heat only</p>"},{"type":"richtext","id":"step_4_description","label":"Step 4 description","default":"<p>If needed, press on a low setting while slightly damp.</p>"},{"type":"header","content":"Card appearance"},{"type":"checkbox","id":"glass_effect","label":"Glassmorphism effect","default":false},{"type":"range","id":"glass_blur","label":"Glass blur","min":0,"max":20,"step":1,"unit":"px","default":8},{"type":"header","content":"Colors"},{"type":"color","id":"background_color","label":"Section background","default":"#EFE3D6"},{"type":"color","id":"card_color","label":"Card background","default":"#F9F6F1"},{"type":"color","id":"heading_color","label":"Headings","default":"#626B4C"},{"type":"color","id":"eyebrow_color","label":"Eyebrow","default":"#777D5D"},{"type":"color","id":"description_color","label":"Descriptions","default":"#555545"},{"type":"color","id":"number_color","label":"Outlined numbers","default":"#777D5D"},{"type":"color","id":"icon_background","label":"Icon circle","default":"#EFE3D6"},{"type":"color","id":"icon_color","label":"Icons","default":"#626B4C"}],"presets":[{"name":"Bamboo care guide"}],"tag":null,"class":"bamboo-care-guide-block"}
{% endschema %}