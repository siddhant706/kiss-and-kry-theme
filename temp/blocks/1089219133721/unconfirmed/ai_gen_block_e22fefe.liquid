{% doc %}
  @prompt
    Create a premium, minimalist Shopify customer testimonial section for the babywear brand KISS & KRY, replicating the supplied reference screenshot as closely as possible.
    
    STRICT REQUIREMENT: Follow the reference image exactly. Do not redesign, change the card arrangement, introduce additional elements, or create a generic review section.
    
    1. SECTION STRUCTURE
    
    Full-width section.
    
    Background: pure white (#FFFFFF).
    
    Maximum content width: 1200px.
    
    Desktop horizontal padding: 55px.
    
    Vertical padding: 65px.
    
    Minimal, clean, premium editorial design.
    
    Use Montserrat typography throughout.
    
    2. TOP HEADER
    
    Create a left-aligned header at the top.
    
    Eyebrow:
    "— LOVED BY PARENTS"
    
    Montserrat Medium.
    
    9px.
    
    Uppercase.
    
    Letter spacing: 2px.
    
    Colour: muted olive (#777D5D).
    
    Main heading:
    "Little Ones Approve."
    
    Montserrat Bold.
    
    Font size: 36px desktop.
    
    Colour: dark olive (#626B4C).
    
    Line height: 1.2.
    
    Margin below: 22px.
    
    3. NAVIGATION ARROWS
    
    Position two circular navigation buttons at the top-right, aligned horizontally with the heading.
    
    Previous button:
    
    White background.
    
    Thin light-grey border.
    
    Left arrow icon.
    
    Dark olive icon.
    
    Next button:
    
    Dark olive background (#626B4C).
    
    White right arrow icon.
    
    Specifications:
    
    46px × 46px.
    
    Perfect circular shape.
    
    12px gap.
    
    Smooth hover transition.
    
    Functional previous/next navigation.
    
    4. TESTIMONIAL CARDS
    
    Create exactly THREE testimonial cards visible side by side on desktop.
    
    Layout:
    
    Three equal-width columns.
    
    Gap: 18px.
    
    Each card approximately 360px wide and 230px tall.
    
    Background: warm cream (#F5F3E7).
    
    Border radius: 17px.
    
    Padding: 26px.
    
    No heavy borders.
    
    No excessive shadows.
    
    All three cards must have identical dimensions and internal layout.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background: #ffffff;
    color: #343a29;
    font-family: Montserrat, {{ settings.type_body_font.family }}, sans-serif;
  }

  .ai-testimonials-{{ ai_gen_id }} * { box-sizing: border-box; }
  .ai-testimonials-{{ ai_gen_id }}__inner {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 65px 55px;
  }

  .ai-testimonials-{{ ai_gen_id }}__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    margin-bottom: 22px;
  }

  .ai-testimonials-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 10px;
    color: #777d5d;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-testimonials-{{ ai_gen_id }}__heading {
    margin: 0;
    color: #626b4c;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
  }

  .ai-testimonials-{{ ai_gen_id }}__controls { display: flex; gap: 12px; flex: 0 0 auto; }
  .ai-testimonials-{{ ai_gen_id }}__arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    padding: 0;
    border: 1px solid #deded8;
    border-radius: 50%;
    background: #ffffff;
    color: #626b4c;
    cursor: pointer;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }
  .ai-testimonials-{{ ai_gen_id }}__arrow--next { background: #626b4c; border-color: #626b4c; color: #ffffff; }
  .ai-testimonials-{{ ai_gen_id }}__arrow:hover { background: #626b4c; border-color: #626b4c; color: #ffffff; }
  .ai-testimonials-{{ ai_gen_id }}__arrow:focus-visible { outline: 2px solid #343a29; outline-offset: 3px; }
  .ai-testimonials-{{ ai_gen_id }}__arrow svg { width: 17px; height: 17px; }

  .ai-testimonials-{{ ai_gen_id }}__viewport { overflow: hidden; }
  .ai-testimonials-{{ ai_gen_id }}__track {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    transition: transform 320ms ease;
  }
  .ai-testimonials-{{ ai_gen_id }}__card {
    min-width: 0;
    min-height: 230px;
    height: 230px;
    padding: 26px;
    overflow: hidden;
    border-radius: 17px;
    background: #f5f3e7;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .ai-testimonials-{{ ai_gen_id }}__quote {
    margin: 0;
    color: #343a29;
    font-size: 14px;
    font-weight: 400;
    line-height: 1.65;
  }
  .ai-testimonials-{{ ai_gen_id }}__author { margin: 16px 0 0; color: #626b4c; font-size: 11px; font-weight: 600; letter-spacing: .3px; }
  .ai-testimonials-{{ ai_gen_id }}__viewport:focus-visible { outline: 2px solid #626b4c; outline-offset: 4px; }

  @media screen and (max-width: 749px) {
    .ai-testimonials-{{ ai_gen_id }}__inner { padding: 44px 20px; }
    .ai-testimonials-{{ ai_gen_id }}__header { align-items: center; gap: 12px; }
    .ai-testimonials-{{ ai_gen_id }}__heading { font-size: 28px; }
    .ai-testimonials-{{ ai_gen_id }}__arrow { width: 40px; height: 40px; }
    .ai-testimonials-{{ ai_gen_id }}__controls { gap: 8px; }
    .ai-testimonials-{{ ai_gen_id }}__track { grid-template-columns: 1fr; gap: 12px; }
    .ai-testimonials-{{ ai_gen_id }}__card { height: 230px; }
  }
{% endstyle %}

<testimonial-carousel-{{ ai_gen_id }} class="ai-testimonials-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-{{ ai_gen_id }}__inner">
    <div class="ai-testimonials-{{ ai_gen_id }}__header">
      <div>
        <p class="ai-testimonials-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
        <h2 class="ai-testimonials-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      </div>
      <div class="ai-testimonials-{{ ai_gen_id }}__controls" aria-label="Testimonial navigation">
        <button class="ai-testimonials-{{ ai_gen_id }}__arrow ai-testimonials-{{ ai_gen_id }}__arrow--prev" type="button" aria-label="Previous testimonials">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M5 12l7-7M5 12l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <button class="ai-testimonials-{{ ai_gen_id }}__arrow ai-testimonials-{{ ai_gen_id }}__arrow--next" type="button" aria-label="Next testimonials">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m0 0-7-7m7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
    <div class="ai-testimonials-{{ ai_gen_id }}__viewport" tabindex="0" aria-label="Customer testimonials">
      <div class="ai-testimonials-{{ ai_gen_id }}__track">
        {% for i in (1..3) %}
          {% liquid
            assign quote_key = 'quote_' | append: i
            assign author_key = 'author_' | append: i
            assign quote_value = block.settings[quote_key]
            assign author_value = block.settings[author_key]
          %}
          <article class="ai-testimonials-{{ ai_gen_id }}__card">
            <p class="ai-testimonials-{{ ai_gen_id }}__quote">“{{ quote_value | escape }}”</p>
            <p class="ai-testimonials-{{ ai_gen_id }}__author">{{ author_value | escape }}</p>
          </article>
        {% endfor %}
      </div>
    </div>
  </div>
</testimonial-carousel-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'testimonial-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class TestimonialCarousel extends HTMLElement {
      connectedCallback() {
        this.prevButton = this.querySelector('.ai-testimonials-{{ ai_gen_id }}__arrow--prev');
        this.nextButton = this.querySelector('.ai-testimonials-{{ ai_gen_id }}__arrow--next');
        this.track = this.querySelector('.ai-testimonials-{{ ai_gen_id }}__track');
        this.cards = Array.from(this.querySelectorAll('.ai-testimonials-{{ ai_gen_id }}__card'));
        this.index = 0;
        this.prevButton.addEventListener('click', () => this.move(-1));
        this.nextButton.addEventListener('click', () => this.move(1));
      }
      move(direction) {
        if (window.matchMedia('(max-width: 749px)').matches) return;
        this.index = (this.index + direction + this.cards.length) % this.cards.length;
        const card = this.cards[0];
        const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
        this.track.style.transform = `translateX(-${this.index * (card.getBoundingClientRect().width + gap)}px)`;
      }
    }
    customElements.define(tagName, TestimonialCarousel);
  })();
</script>

{% schema %}
{
  "name": "Customer testimonials",
  "tag": null,
  "class": "customer-testimonials-block",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "— LOVED BY PARENTS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Little Ones Approve." },
    { "type": "header", "content": "Testimonial 1" },
    { "type": "textarea", "id": "quote_1", "label": "Quote", "default": "Beautifully soft, thoughtfully made, and so comfortable for my little one." },
    { "type": "text", "id": "author_1", "label": "Name", "default": "A happy parent" },
    { "type": "header", "content": "Testimonial 2" },
    { "type": "textarea", "id": "quote_2", "label": "Quote", "default": "The quality is lovely and every detail feels considered. We reach for it daily." },
    { "type": "text", "id": "author_2", "label": "Name", "default": "A happy parent" },
    { "type": "header", "content": "Testimonial 3" },
    { "type": "textarea", "id": "quote_3", "label": "Quote", "default": "A gorgeous fit and wonderfully gentle fabric. Such a special little outfit." },
    { "type": "text", "id": "author_3", "label": "Name", "default": "A happy parent" }
  ],
  "presets": [{ "name": "Customer testimonials" }]
}
{% endschema %}