{% doc %}
  @prompt
    Create a premium, minimalist Instagram gallery section for the babywear brand KISS & KRY, replicating the supplied reference screenshot as closely as possible.
    
    STRICT INSTRUCTION: Do not redesign or reinterpret the reference. Maintain the exact layout, image proportions, spacing, typography, colours, alignment, and visual hierarchy.
    
    1. OVERALL SECTION DESIGN
    
    Full-width Shopify section.
    
    Background colour: pure white (#FFFFFF).
    
    Maximum content width: 1200px.
    
    Desktop horizontal padding: 55px.
    
    Desktop vertical padding: 65px.
    
    Minimal, clean, premium editorial aesthetic.
    
    Use Montserrat typography throughout.
    
    No gradients, heavy shadows, or decorative backgrounds.
    
    2. HEADER – LEFT ALIGNMENT
    
    Create a header at the top-left.
    
    Eyebrow text:
    
    "— #KISSANDKRY"
    
    Font: Montserrat Medium.
    
    Size: 9px.
    
    Uppercase.
    
    Letter spacing: 2px.
    
    Colour: muted olive (#777D5D).
    
    Position above the main heading.
    
    Main heading:
    
    "Tiny Moments, Shared."
    
    Font: Montserrat Bold.
    
    Size: 36px desktop.
    
    Colour: dark olive (#626B4C).
    
    Line height: 1.2.
    
    Left aligned.
    
    Margin-top: 8px.
    
    3. INSTAGRAM FOLLOW BUTTON
    
    Position the Instagram follow button at the top-right of the section.
    
    Button content:
    Instagram outline icon + "Follow @kissandkry"
    
    Design:
    
    White background.
    
    Thin olive-grey border (#C9CDBD).
    
    Pill-shaped border radius: 30px.
    
    Height: 42px.
    
    Horizontal padding: 20px.
    
    Font: Montserrat SemiBold.
    
    Size: 11px.
    
    Text colour: #626B4C.
    
    Instagram icon: small, 13px.
    
    Vertically centred content.
    
    Subtle hover transition.
    
    Functionality:
    
    Make the entire button clickable.
    
    Link to the Instagram profile: https://www.instagram.com/kissandkry/
    
    Open in a new tab.
    
    4. INSTAGRAM IMAGE GALLERY
    
    This is the most important component.
    
    Create a single horizontal row containing EXACTLY SIX equally sized image tiles on desktop.
    
    Layout specifications:
    
    Six columns.
    
    Equal image dimensions.
    
    Image aspect ratio: approximately 1:1.
    
    Desktop image dimensions: approximately 160px × 160px.
    
    Horizontal gap: 10px.
    
    Border radius: 12px.
    
    Object-fit: cover.
    
    Object-position: center.
    
    No borders.
    
    No heavy shadows.
    
    All images must have identical dimensions.
    
    The gallery must span almost the entire available content width.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-instagram-gallery-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: 65px 55px;
    background: #ffffff;
    color: #626B4C;
    box-sizing: border-box;
    font-family: {{ settings.type_body_font.family }}, sans-serif;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__inner {
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
    margin-bottom: 32px;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: #777D5D;
    font-size: 9px;
    font-weight: 500;
    letter-spacing: 2px;
    line-height: 1.4;
    text-transform: uppercase;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__title {
    margin: 0;
    color: #626B4C;
    font-family: {{ settings.type_heading_font.family }}, sans-serif;
    font-size: 36px;
    font-weight: 700;
    line-height: 1.2;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__follow {
    display: inline-flex;
    min-height: 42px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 0 20px;
    border: 1px solid #C9CDBD;
    border-radius: 30px;
    background: #ffffff;
    color: #626B4C;
    font-size: 11px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__follow:hover {
    background-color: #f8f9f5;
    border-color: #777D5D;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__follow:focus-visible {
    outline: 2px solid #626B4C;
    outline-offset: 3px;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__icon {
    display: block;
    width: 13px;
    height: 13px;
    flex: 0 0 13px;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__tile {
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 12px;
    background: #f5f5f2;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__tile img,
  .ai-instagram-gallery-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }
  .ai-instagram-gallery-{{ ai_gen_id }}__placeholder svg {
    background: #f5f5f2;
  }
  @media screen and (max-width: 749px) {
    .ai-instagram-gallery-{{ ai_gen_id }} { padding: 44px 20px; }
    .ai-instagram-gallery-{{ ai_gen_id }}__header { align-items: flex-start; gap: 16px; margin-bottom: 24px; }
    .ai-instagram-gallery-{{ ai_gen_id }}__title { font-size: 28px; }
    .ai-instagram-gallery-{{ ai_gen_id }}__follow { min-height: 38px; padding: 0 13px; font-size: 10px; }
    .ai-instagram-gallery-{{ ai_gen_id }}__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media screen and (max-width: 480px) {
    .ai-instagram-gallery-{{ ai_gen_id }}__header { flex-direction: column; }
    .ai-instagram-gallery-{{ ai_gen_id }}__title { font-size: 26px; }
  }
{% endstyle %}

<div class="ai-instagram-gallery-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-instagram-gallery-{{ ai_gen_id }}__inner">
    <div class="ai-instagram-gallery-{{ ai_gen_id }}__header">
      <div class="ai-instagram-gallery-{{ ai_gen_id }}__heading-wrap">
        <p class="ai-instagram-gallery-{{ ai_gen_id }}__eyebrow">— #KISSANDKRY</p>
        <h2 class="ai-instagram-gallery-{{ ai_gen_id }}__title">Tiny Moments, Shared.</h2>
      </div>
      <a class="ai-instagram-gallery-{{ ai_gen_id }}__follow" href="https://www.instagram.com/kissandkry/" target="_blank" rel="noopener noreferrer" aria-label="Follow @kissandkry on Instagram, opens in a new tab">
        <svg class="ai-instagram-gallery-{{ ai_gen_id }}__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5"></rect>
          <circle cx="12" cy="12" r="4"></circle>
          <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
        </svg>
        <span>Follow @kissandkry</span>
      </a>
    </div>
    <div class="ai-instagram-gallery-{{ ai_gen_id }}__grid" aria-label="KISS & KRY Instagram gallery">
      {% for i in (1..6) %}
        {% assign image_key = 'gallery_image_' | append: i %}
        {% assign gallery_image = block.settings[image_key] %}
        <div class="ai-instagram-gallery-{{ ai_gen_id }}__tile">
          {% if gallery_image != blank %}
            <img src="{{ gallery_image | image_url: width: 500 }}" alt="{{ gallery_image.alt | escape }}" loading="lazy" width="{{ gallery_image.width }}" height="{{ gallery_image.height }}">
          {% else %}
            <div class="ai-instagram-gallery-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram gallery",
  "settings": [
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Gallery images" },
    { "type": "image_picker", "id": "gallery_image_1", "label": "Image 1" },
    { "type": "image_picker", "id": "gallery_image_2", "label": "Image 2" },
    { "type": "image_picker", "id": "gallery_image_3", "label": "Image 3" },
    { "type": "image_picker", "id": "gallery_image_4", "label": "Image 4" },
    { "type": "image_picker", "id": "gallery_image_5", "label": "Image 5" },
    { "type": "image_picker", "id": "gallery_image_6", "label": "Image 6" }
  ],
  "presets": [{ "name": "Instagram gallery" }],
  "tag": null,
  "class": "instagram-gallery-block"
}
{% endschema %}