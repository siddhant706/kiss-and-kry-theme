{% doc %}
  @prompt
    You are a senior Shopify theme developer. Build ONE production-ready Online Store 2.0 section (a single .liquid file) that recreates the attached reference banner exactly: same layout, proportions, typography hierarchy, colors, curved card and pill button. Return ONLY the complete code (Liquid + CSS + {% schema %}). No explanations, no commentary, no placeholder lorem ipsum.
    
    The baby photo, blanket, plant and soft light are all part of ONE background image that I will upload. Do NOT draw, recreate or substitute them. The three round trust icons (bamboo, cotton, leaf) are images that I will upload into blocks.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
  .ai-baby-banner-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.banner_height }}px;
    overflow: hidden;
    border-radius: {{ block.settings.outer_radius }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    isolation: isolate;
  }
  .ai-baby-banner-{{ ai_gen_id }}__image,
  .ai-baby-banner-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .ai-baby-banner-{{ ai_gen_id }}__image { object-fit: cover; object-position: {{ block.settings.image_position }}; z-index: -2; }
  .ai-baby-banner-{{ ai_gen_id }}__shade { z-index: -1; background: linear-gradient(90deg, {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | divided_by: 100.0 }} 0%, rgba(0,0,0,0) 76%); }
  .ai-baby-banner-{{ ai_gen_id }}__content { box-sizing: border-box; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; width: min(54%, 620px); min-height: {{ block.settings.banner_height }}px; padding: clamp(28px, 6vw, 88px); }
  .ai-baby-banner-{{ ai_gen_id }}__eyebrow { margin: 0 0 14px; color: {{ block.settings.accent_color }}; font-family: {{ settings.type_accent_font.family }}, {{ settings.type_accent_font.fallback_families }}; font-size: 13px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  .ai-baby-banner-{{ ai_gen_id }}__heading { max-width: 520px; margin: 0; color: inherit; font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}; font-size: clamp(38px, 5vw, {{ block.settings.heading_size }}px); line-height: 1.02; letter-spacing: -.035em; }
  .ai-baby-banner-{{ ai_gen_id }}__description { max-width: 430px; margin: 18px 0 0; color: inherit; font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}; font-size: 16px; line-height: 1.55; }
  .ai-baby-banner-{{ ai_gen_id }}__trust { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 25px; }
  .ai-baby-banner-{{ ai_gen_id }}__trust-item { display: flex; align-items: center; gap: 9px; color: inherit; font-size: 12px; font-weight: 600; line-height: 1.25; }
  .ai-baby-banner-{{ ai_gen_id }}__trust-item img { display: block; width: 38px; height: 38px; flex: 0 0 38px; border-radius: 50%; object-fit: cover; }
  .ai-baby-banner-{{ ai_gen_id }}__button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; margin-top: 28px; padding: 12px 28px; border: 0; border-radius: 999px; background: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }}; font-size: 14px; font-weight: 700; text-decoration: none; transition: background-color .2s ease, color .2s ease; }
  .ai-baby-banner-{{ ai_gen_id }}__button:hover { background: {{ block.settings.button_hover_color }}; color: {{ block.settings.button_text_color }}; }
  .ai-baby-banner-{{ ai_gen_id }}__button:focus-visible { outline: 3px solid {{ block.settings.text_color }}; outline-offset: 3px; }
  .ai-baby-banner-{{ ai_gen_id }}__card { position: absolute; right: 4%; bottom: 0; width: 27%; min-height: 23%; padding: 22px 26px 0; border-radius: 28px 28px 0 0; background: {{ block.settings.card_color }}; color: {{ block.settings.card_text_color }}; text-align: center; }
  .ai-baby-banner-{{ ai_gen_id }}__card p { margin: 0; font-size: 13px; line-height: 1.45; }
  .ai-baby-banner-{{ ai_gen_id }}__card strong { display: block; margin-bottom: 5px; font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }}; font-size: 17px; }
  .ai-baby-banner-{{ ai_gen_id }}__placeholder { position: absolute; inset: 0; z-index: -2; display: grid; place-items: center; background: #eee9df; }
  .ai-baby-banner-{{ ai_gen_id }}__placeholder svg { width: 100%; height: 100%; color: #b8b1a5; }
  .ai-baby-banner-{{ ai_gen_id }}__empty { position: absolute; right: 16px; bottom: 16px; padding: 8px 12px; border-radius: 4px; background: rgba(255,255,255,.9); color: #333; font-size: 12px; }
  @media screen and (max-width: 749px) {
    .ai-baby-banner-{{ ai_gen_id }} { min-height: {{ block.settings.mobile_height }}px; }
    .ai-baby-banner-{{ ai_gen_id }}__image { object-position: {{ block.settings.mobile_image_position }}; }
    .ai-baby-banner-{{ ai_gen_id }}__shade { background: linear-gradient(0deg, {{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | divided_by: 100.0 }} 0%, rgba(0,0,0,0) 100%); }
    .ai-baby-banner-{{ ai_gen_id }}__content { justify-content: flex-end; width: 100%; min-height: {{ block.settings.mobile_height }}px; padding: 34px 24px 150px; }
    .ai-baby-banner-{{ ai_gen_id }}__heading { max-width: 390px; font-size: clamp(36px, 11vw, 58px); }
    .ai-baby-banner-{{ ai_gen_id }}__description { max-width: 360px; font-size: 14px; }
    .ai-baby-banner-{{ ai_gen_id }}__trust { gap: 12px; margin-top: 18px; }
    .ai-baby-banner-{{ ai_gen_id }}__trust-item { font-size: 10px; gap: 6px; }
    .ai-baby-banner-{{ ai_gen_id }}__trust-item img { width: 30px; height: 30px; flex-basis: 30px; }
    .ai-baby-banner-{{ ai_gen_id }}__button { margin-top: 20px; min-height: 44px; }
    .ai-baby-banner-{{ ai_gen_id }}__card { right: 5%; width: 56%; min-height: 100px; padding: 15px 16px 0; border-radius: 22px 22px 0 0; }
  }
{% endstyle %}
<section class="ai-baby-banner-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image != blank %}
    <img class="ai-baby-banner-{{ ai_gen_id }}__image" src="{{ block.settings.background_image | image_url: width: 2400 }}" alt="{{ block.settings.background_image.alt | escape }}" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}" loading="lazy">
  {% else %}
    <div class="ai-baby-banner-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="ai-baby-banner-{{ ai_gen_id }}__empty">Add the banner background image</span></div>
  {% endif %}
  <div class="ai-baby-banner-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-baby-banner-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}<p class="ai-baby-banner-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>{% endif %}
    {% if block.settings.heading != blank %}<h2 class="ai-baby-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape | newline_to_br }}</h2>{% endif %}
    {% if block.settings.description != blank %}<p class="ai-baby-banner-{{ ai_gen_id }}__description">{{ block.settings.description | escape }}</p>{% endif %}
    <div class="ai-baby-banner-{{ ai_gen_id }}__trust">
      {% for i in (1..3) %}
        {% liquid
          assign icon_key = 'trust_icon_' | append: i
          assign label_key = 'trust_label_' | append: i
          assign icon_image = block.settings[icon_key]
          assign icon_label = block.settings[label_key]
        %}
        {% if icon_image != blank or icon_label != blank %}<div class="ai-baby-banner-{{ ai_gen_id }}__trust-item">{% if icon_image != blank %}<img src="{{ icon_image | image_url: width: 96 }}" alt="{{ icon_image.alt | default: icon_label | escape }}" width="38" height="38" loading="lazy">{% endif %}{% if icon_label != blank %}<span>{{ icon_label | escape }}</span>{% endif %}</div>{% endif %}
      {% endfor %}
    </div>
    {% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="ai-baby-banner-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>{% endif %}
  </div>
  {% if block.settings.card_heading != blank or block.settings.card_text != blank %}<aside class="ai-baby-banner-{{ ai_gen_id }}__card">{% if block.settings.card_heading != blank %}<strong>{{ block.settings.card_heading | escape }}</strong>{% endif %}{% if block.settings.card_text != blank %}<p>{{ block.settings.card_text | escape }}</p>{% endif %}</aside>{% endif %}
</section>
{% schema %}
{
  "name": "Baby image banner",
  "settings": [
    {"type":"image_picker","id":"background_image","label":"Background image"},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"range","id":"banner_height","label":"Desktop height","min":400,"max":900,"step":50,"unit":"px","default":650},
    {"type":"range","id":"mobile_height","label":"Mobile height","min":450,"max":850,"step":50,"unit":"px","default":650},
    {"type":"select","id":"image_position","label":"Desktop image position","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}],"default":"center center"},
    {"type":"select","id":"mobile_image_position","label":"Mobile image position","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}],"default":"center center"},
    {"type":"range","id":"outer_radius","label":"Banner corner radius","min":0,"max":60,"step":5,"unit":"px","default":20},
    {"type":"header","content":"Banner text"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Gentle by nature"},
    {"type":"textarea","id":"heading","label":"Heading","default":"Made for their\nsoftest beginnings"},
    {"type":"textarea","id":"description","label":"Description","default":"Thoughtful essentials, made with the gentlest materials for little ones and the people who love them."},
    {"type":"color","id":"text_color","label":"Text","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Eyebrow accent","default":"#F2E7D7"},
    {"type":"color","id":"overlay_color","label":"Image overlay","default":"#263020"},
    {"type":"range","id":"overlay_opacity","label":"Overlay strength","min":0,"max":80,"step":5,"unit":"%","default":35},
    {"type":"range","id":"heading_size","label":"Heading size","min":40,"max":80,"step":5,"unit":"px","default":65},
    {"type":"header","content":"Trust icons"},
    {"type":"image_picker","id":"trust_icon_1","label":"Bamboo icon image"},
    {"type":"text","id":"trust_label_1","label":"Bamboo label","default":"Bamboo blend"},
    {"type":"image_picker","id":"trust_icon_2","label":"Cotton icon image"},
    {"type":"text","id":"trust_label_2","label":"Cotton label","default":"Organic cotton"},
    {"type":"image_picker","id":"trust_icon_3","label":"Leaf icon image"},
    {"type":"text","id":"trust_label_3","label":"Leaf label","default":"Naturally gentle"},
    {"type":"header","content":"Button"},
    {"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"color","id":"button_color","label":"Background","default":"#F5EEE4"},
    {"type":"color","id":"button_text_color","label":"Text","default":"#34402D"},
    {"type":"color","id":"button_hover_color","label":"Hover background","default":"#E6D8C5"},
    {"type":"header","content":"Curved card"},
    {"type":"text","id":"card_heading","label":"Card heading","default":"A softer kind of care"},
    {"type":"textarea","id":"card_text","label":"Card text","default":"Comfort-first pieces for every little moment."},
    {"type":"color","id":"card_color","label":"Background","default":"#F5EEE4"},
    {"type":"color","id":"card_text_color","label":"Text","default":"#34402D"}
  ],
  "presets": [{"name":"Baby image banner"}],
  "tag": null,
  "class": "baby-image-banner-block"
}
{% endschema %}