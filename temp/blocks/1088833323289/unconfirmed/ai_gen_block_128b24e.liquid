{% doc %}
  @prompt
    generate a full page width cover sized hero section with full size background image and all the text as eyebrow, heading, context on left top , align all the text in equal side spacing from left perfectly aligned to each other in verticle order, make all the font as montserrate and allow me to change as rich text , now on bottom left add three trust indicators in circle frame with a circular stroke and , the trust indicators should be in PNG only and also allow me change all the texts size as well, image for indicators are not appearing, circular strokee should be thick allow me change thickness as well, heading size should be increase if I increase, increase heading size by 40% more, add a indicator name tag just below each indicator in small size bold, indicator circular strokes should be in glassmorphic style
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-cover-hero-{{ ai_gen_id }}{position:relative;display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;min-height:{{ block.settings.hero_height }}px;overflow:hidden;isolation:isolate;background:{{ block.settings.fallback_color }};color:{{ block.settings.text_color }};font-family:Montserrat,var(--font-body-family,sans-serif)}
.ai-cover-hero-{{ ai_gen_id }}__image,.ai-cover-hero-{{ ai_gen_id }}__placeholder,.ai-cover-hero-{{ ai_gen_id }}__shade{position:absolute;inset:0;width:100%;height:100%}.ai-cover-hero-{{ ai_gen_id }}__image{object-fit:cover;object-position:{{ block.settings.image_position }};z-index:-2}.ai-cover-hero-{{ ai_gen_id }}__placeholder{z-index:-2;background:#e9e9e5}.ai-cover-hero-{{ ai_gen_id }}__placeholder svg{display:block;width:100%;height:100%;object-fit:cover;color:#777}.ai-cover-hero-{{ ai_gen_id }}__shade{z-index:-1;background:linear-gradient(90deg,rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }}) 0%,rgba(0,0,0,0) 100%)}
.ai-cover-hero-{{ ai_gen_id }}__content{position:relative;z-index:1;display:flex;flex-direction:column;align-items:flex-start;width:min(100%,{{ block.settings.content_width }}px);padding:{{ block.settings.content_padding }}px;text-align:left;font-family:Montserrat,var(--font-body-family,sans-serif)}.ai-cover-hero-{{ ai_gen_id }}__eyebrow,.ai-cover-hero-{{ ai_gen_id }}__heading,.ai-cover-hero-{{ ai_gen_id }}__context{box-sizing:border-box;width:100%;max-width:100%;margin-left:0;margin-right:0;text-align:left;font-family:Montserrat,var(--font-body-family,sans-serif)}.ai-cover-hero-{{ ai_gen_id }}__eyebrow{margin-top:0;margin-bottom:14px;font-size:{{ block.settings.eyebrow_size }}px;font-weight:600;letter-spacing:.12em;line-height:1.4;text-transform:uppercase}.ai-cover-hero-{{ ai_gen_id }}__heading{max-width:14ch;margin:0;font-size:{{ block.settings.heading_size | times:1.4 }}px;line-height:1.05;font-weight:600;text-wrap:balance}.ai-cover-hero-{{ ai_gen_id }}__context{max-width:48ch;margin-top:18px;font-size:{{ block.settings.context_size }}px;line-height:1.6}.ai-cover-hero-{{ ai_gen_id }}__eyebrow>*,.ai-cover-hero-{{ ai_gen_id }}__heading>*,.ai-cover-hero-{{ ai_gen_id }}__context>*{margin:0;font-family:Montserrat,var(--font-body-family,sans-serif);text-align:left}
.ai-cover-hero-{{ ai_gen_id }}__trust{position:absolute;z-index:2;left:{{ block.settings.content_padding }}px;bottom:{{ block.settings.content_padding }}px;display:flex;flex-wrap:wrap;align-items:flex-start;gap:14px;max-width:calc(100% - 48px)}.ai-cover-hero-{{ ai_gen_id }}__trust-card{display:flex;flex-direction:column;align-items:center;gap:7px}.ai-cover-hero-{{ ai_gen_id }}__trust-item{box-sizing:border-box;width:{{ block.settings.trust_circle_size }}px;height:{{ block.settings.trust_circle_size }}px;padding:6px;display:flex;align-items:center;justify-content:center;border:{{ block.settings.trust_stroke_width }}px solid {{ block.settings.trust_stroke_color }};border-radius:50%;overflow:hidden;background:rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:inset 0 1px 1px rgba(255,255,255,.35),0 4px 16px rgba(0,0,0,.12)}.ai-cover-hero-{{ ai_gen_id }}__trust-item img{display:block;width:100%;height:100%;object-fit:contain;border-radius:50%}.ai-cover-hero-{{ ai_gen_id }}__trust-label{max-width:{{ block.settings.trust_circle_size | plus:24 }}px;color:{{ block.settings.text_color }};font-family:Montserrat,var(--font-body-family,sans-serif);font-size:{{ block.settings.trust_label_size }}px;font-weight:700;line-height:1.25;text-align:center}
@media(max-width:749px){.ai-cover-hero-{{ ai_gen_id }}{min-height:{{ block.settings.mobile_height }}px}.ai-cover-hero-{{ ai_gen_id }}__content{padding:28px}.ai-cover-hero-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times:1.05 }}px}.ai-cover-hero-{{ ai_gen_id }}__trust{left:28px;bottom:28px;gap:9px}.ai-cover-hero-{{ ai_gen_id }}__trust-item{width:{{ block.settings.trust_circle_size | times:0.8 }}px;height:{{ block.settings.trust_circle_size | times:0.8 }}px}}
{% endstyle %}
<section class="ai-cover-hero-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
{% if block.settings.background_image != blank %}<img class="ai-cover-hero-{{ ai_gen_id }}__image" src="{{ block.settings.background_image | image_url: width:2400 }}" srcset="{{ block.settings.background_image | image_url: width:1200 }} 1200w,{{ block.settings.background_image | image_url: width:1800 }} 1800w,{{ block.settings.background_image | image_url: width:2400 }} 2400w" sizes="100vw" alt="{{ block.settings.background_image.alt | escape }}" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}" loading="lazy">{% else %}<div class="ai-cover-hero-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-cover-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
<div class="ai-cover-hero-{{ ai_gen_id }}__content">{% if block.settings.eyebrow != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}{% if block.settings.heading != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>{% endif %}{% if block.settings.context != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__context">{{ block.settings.context }}</div>{% endif %}</div>
{% assign trust_one = block.settings.trust_image_one %}{% assign trust_two = block.settings.trust_image_two %}{% assign trust_three = block.settings.trust_image_three %}{% if trust_one != blank or trust_two != blank or trust_three != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__trust" role="group" aria-label="Trust indicators">{% if trust_one != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__trust-card"><div class="ai-cover-hero-{{ ai_gen_id }}__trust-item"><img src="{{ trust_one | image_url: width:300 }}" alt="{{ trust_one.alt | escape }}" width="{{ trust_one.width }}" height="{{ trust_one.height }}" loading="lazy"></div>{% if block.settings.trust_label_one != blank %}<span class="ai-cover-hero-{{ ai_gen_id }}__trust-label">{{ block.settings.trust_label_one | escape }}</span>{% endif %}</div>{% endif %}{% if trust_two != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__trust-card"><div class="ai-cover-hero-{{ ai_gen_id }}__trust-item"><img src="{{ trust_two | image_url: width:300 }}" alt="{{ trust_two.alt | escape }}" width="{{ trust_two.width }}" height="{{ trust_two.height }}" loading="lazy"></div>{% if block.settings.trust_label_two != blank %}<span class="ai-cover-hero-{{ ai_gen_id }}__trust-label">{{ block.settings.trust_label_two | escape }}</span>{% endif %}</div>{% endif %}{% if trust_three != blank %}<div class="ai-cover-hero-{{ ai_gen_id }}__trust-card"><div class="ai-cover-hero-{{ ai_gen_id }}__trust-item"><img src="{{ trust_three | image_url: width:300 }}" alt="{{ trust_three.alt | escape }}" width="{{ trust_three.width }}" height="{{ trust_three.height }}" loading="lazy"></div>{% if block.settings.trust_label_three != blank %}<span class="ai-cover-hero-{{ ai_gen_id }}__trust-label">{{ block.settings.trust_label_three | escape }}</span>{% endif %}</div>{% endif %}</div>{% endif %}
</section>
{% schema %}
{"name":"Cover hero","settings":[{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"hero_height","label":"Desktop height","min":400,"max":900,"step":50,"unit":"px","default":700},{"type":"range","id":"mobile_height","label":"Mobile height","min":300,"max":700,"step":50,"unit":"px","default":500},{"type":"select","id":"image_position","label":"Image focal point","options":[{"value":"center center","label":"Center"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"}],"default":"center center"},{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>A thoughtful collection</p>"},{"type":"richtext","id":"heading","label":"Heading","default":"<h2>Made for your everyday</h2>"},{"type":"richtext","id":"context","label":"Context","default":"<p>Discover considered essentials, made to bring a little more meaning to every day.</p>"},{"type":"range","id":"eyebrow_size","label":"Eyebrow text size","min":10,"max":30,"step":2,"unit":"px","default":14},{"type":"range","id":"heading_size","label":"Heading text size","min":40,"max":88,"step":4,"unit":"px","default":64},{"type":"range","id":"context_size","label":"Context text size","min":12,"max":30,"step":2,"unit":"px","default":16},{"type":"range","id":"content_width","label":"Text width","min":320,"max":800,"step":40,"unit":"px","default":560},{"type":"range","id":"content_padding","label":"Content inset","min":24,"max":120,"step":8,"unit":"px","default":64},{"type":"range","id":"overlay_opacity","label":"Image overlay","min":0,"max":80,"step":5,"unit":"%","default":40},{"type":"color","id":"text_color","label":"Text color","default":"#FFFFFF"},{"type":"color","id":"fallback_color","label":"Fallback background","default":"#5E6539"},{"type":"header","content":"Trust indicators"},{"type":"image_picker","id":"trust_image_one","label":"Trust image one"},{"type":"text","id":"trust_label_one","label":"Name tag one","default":"Indicator one"},{"type":"image_picker","id":"trust_image_two","label":"Trust image two"},{"type":"text","id":"trust_label_two","label":"Name tag two","default":"Indicator two"},{"type":"image_picker","id":"trust_image_three","label":"Trust image three"},{"type":"text","id":"trust_label_three","label":"Name tag three","default":"Indicator three"},{"type":"range","id":"trust_label_size","label":"Name tag size","min":10,"max":18,"step":2,"unit":"px","default":12},{"type":"range","id":"trust_circle_size","label":"Circle size","min":64,"max":144,"step":8,"unit":"px","default":96},{"type":"range","id":"trust_stroke_width","label":"Circle stroke thickness","min":2,"max":10,"step":2,"unit":"px","default":6},{"type":"color","id":"trust_stroke_color","label":"Circle stroke","default":"#FFFFFF"}],"presets":[{"name":"Cover hero"}],"tag":null,"class":"cover-hero-block"}
{% endschema %}