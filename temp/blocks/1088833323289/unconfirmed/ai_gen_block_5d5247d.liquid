{% doc %}
  @prompt
    You are a senior Shopify theme developer. Build ONE production-ready Online Store 2.0 section (a single .liquid file) that recreates the attached reference banner exactly: same layout, proportions, typography hierarchy, colors, curved card and pill button. Return ONLY the complete code (Liquid + CSS + {% schema %}). No explanations, no commentary, no placeholder lorem ipsum.
    
    The baby photo, blanket, plant and soft light are all part of ONE background image that I will upload. Do NOT draw, recreate or substitute them. The three round trust icons (bamboo, cotton, leaf) are images that I will upload into blocks., 1. HARD RULES (do not break any)
    =====================================================
    1. FONT: Montserrat ONLY. Load it with <link rel="preconnect"> plus a Google Fonts stylesheet (Montserrat weights 300;400;500;600;700;800, display=swap). Set font-family: 'Montserrat', sans-serif on the section root and force every child to inherit it. Do NOT add font_picker settings. Do NOT use theme fonts or any second font.
    2. NOTHING hardcoded: every piece of text, every color, size, weight, spacing, radius, link and toggle must be a section or block setting. Default copy and values live only in the schema "default" keys.
    3. ALL text fields are type "richtext" (CTA label is the only plain "text"). Follow the rich-text rendering rules in section 7.
    4. Every setting has a default, a clear label and, where useful, "info" stating the unit. Group settings with "header" type settings exactly as listed in section 5. The schema must be valid JSON with unique ids.
    5. Scope all CSS to the section (#shopify-section-{{ section.id }} or a wrapper class with the section id). Use the class prefix "mbh-". Push settings into CSS custom properties on the wrapper (for example --mbh-heading-size) and use var() everywhere.
    6. No JavaScript libraries, no external CSS, no theme-specific classes or snippets. Pure Liquid + CSS (JS only if absolutely unavoidable).
    7. Fully responsive, mobile-first. Breakpoints: mobile below 750px, desktop 990px and up. Between 750px and 1440px scale type fluidly with clamp(mobileValue, vw-based value, desktopValue).
{% enddoc %}
{% assign mbh_id = block.id | replace: '_', '' | downcase %}
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
{% style %}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}{--mbh-width:{{ block.settings.width }}%;--mbh-height:{{ block.settings.height }}px;--mbh-radius:{{ block.settings.radius }}px;--mbh-text:{{ block.settings.text_color }};--mbh-overlay:{{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | divided_by: 100.0 }};--mbh-heading-size:{{ block.settings.heading_size }}px;--mbh-copy-size:{{ block.settings.copy_size }}px;--mbh-pad:{{ block.settings.padding }}px;--mbh-button-bg:{{ block.settings.button_bg }};--mbh-button-color:{{ block.settings.button_color }};--mbh-card-bg:{{ block.settings.card_bg }};--mbh-card-color:{{ block.settings.card_color }};--mbh-card-radius:{{ block.settings.card_radius }}px;display:block;position:relative;isolation:isolate;overflow:hidden;width:var(--mbh-width);max-width:100%;min-height:var(--mbh-height);border-radius:var(--mbh-radius);color:var(--mbh-text);font-family:'Montserrat',sans-serif}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }},#shopify-block-{{ block.id }} .mbh-{{ mbh_id }} *{box-sizing:border-box;font-family:inherit}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__image,#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__shade{position:absolute;inset:0;width:100%;height:100%}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__image{z-index:-2;object-fit:cover;object-position:{{ block.settings.image_position }}}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__shade{z-index:-1;background:linear-gradient(90deg,var(--mbh-overlay),transparent 80%)}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__content{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:18px;width:min(56%,650px);min-height:var(--mbh-height);padding:var(--mbh-pad)}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__eyebrow{margin:0;color:{{ block.settings.accent_color }};font-size:13px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__heading{max-width:12ch;margin:0;font-size:clamp(36px,5vw,var(--mbh-heading-size));font-weight:700;line-height:1.04;letter-spacing:-.04em}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__copy{max-width:42ch;font-size:var(--mbh-copy-size);font-weight:400;line-height:1.55}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__copy p,#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__card-copy p{margin:0}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__trust{display:flex;flex-wrap:wrap;gap:18px;align-items:center}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__trust-item{display:flex;align-items:center;gap:8px;font-size:13px;font-weight:600}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__trust-item img{width:38px;height:38px;border-radius:50%;object-fit:cover}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__button{display:inline-flex;padding:14px 28px;border-radius:999px;background:var(--mbh-button-bg);color:var(--mbh-button-color);font-size:14px;font-weight:700;text-decoration:none}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__button:hover{background:{{ block.settings.button_hover }};color:var(--mbh-button-color)}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__button:focus-visible{outline:3px solid var(--mbh-text);outline-offset:3px}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__card{position:absolute;right:4%;bottom:0;width:30%;padding:22px;border-radius:var(--mbh-card-radius) var(--mbh-card-radius) 0 0;background:var(--mbh-card-bg);color:var(--mbh-card-color);text-align:center}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__card-heading{margin:0 0 6px;font-size:17px;font-weight:700}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__card-copy{font-size:13px;line-height:1.45}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__placeholder{position:absolute;inset:0;z-index:-2;display:grid;place-items:center;background:#eee9df}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__placeholder svg{width:100%;height:100%}
#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__empty{position:absolute;right:16px;bottom:16px;padding:8px 12px;background:#fff;color:#333;font-size:12px}
@media(min-width:750px) and (max-width:1440px){#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__heading{font-size:clamp(36px,5vw,var(--mbh-heading-size))}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__copy{font-size:clamp(14px,1.1vw,var(--mbh-copy-size))}}
@media(max-width:749px){#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}{min-height:{{ block.settings.mobile_height }}px}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__image{object-position:{{ block.settings.mobile_position }}}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__shade{background:linear-gradient(0deg,var(--mbh-overlay),transparent 85%)}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__content{width:100%;min-height:{{ block.settings.mobile_height }}px;justify-content:flex-end;padding:24px 24px 145px}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__heading{font-size:clamp(36px,10vw,var(--mbh-heading-size))}#shopify-block-{{ block.id }} .mbh-{{ mbh_id }}__card{right:5%;width:56%;padding:16px}}
{% endstyle %}
<div class="mbh-{{ mbh_id }}" {{ block.shopify_attributes }}>
{% if block.settings.background_image != blank %}<img class="mbh-{{ mbh_id }}__image" src="{{ block.settings.background_image | image_url: width: 2400 }}" alt="{{ block.settings.background_image.alt | escape }}" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}" loading="lazy">{% else %}<div class="mbh-{{ mbh_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}<span class="mbh-{{ mbh_id }}__empty">{{ block.settings.empty_text | escape }}</span></div>{% endif %}<div class="mbh-{{ mbh_id }}__shade" aria-hidden="true"></div><div class="mbh-{{ mbh_id }}__content">{% if block.settings.eyebrow != blank %}<div class="mbh-{{ mbh_id }}__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}{% if block.settings.heading != blank %}<div class="mbh-{{ mbh_id }}__heading">{{ block.settings.heading }}</div>{% endif %}{% if block.settings.description != blank %}<div class="mbh-{{ mbh_id }}__copy">{{ block.settings.description }}</div>{% endif %}<div class="mbh-{{ mbh_id }}__trust">{% for i in (1..3) %}{% liquid
assign image_key = 'trust_image_' | append: i
assign label_key = 'trust_label_' | append: i
assign trust_image = block.settings[image_key]
assign trust_label = block.settings[label_key]
%}{% if trust_image != blank or trust_label != blank %}<div class="mbh-{{ mbh_id }}__trust-item">{% if trust_image != blank %}<img src="{{ trust_image | image_url: width: 120 }}" alt="{{ trust_image.alt | default: trust_label | strip_html | escape }}" width="38" height="38" loading="lazy">{% endif %}{{ trust_label }}</div>{% endif %}{% endfor %}</div>{% if block.settings.button_label != blank and block.settings.button_link != blank %}<a class="mbh-{{ mbh_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label }}</a>{% endif %}</div>{% if block.settings.card_heading != blank or block.settings.card_text != blank %}<aside class="mbh-{{ mbh_id }}__card">{% if block.settings.card_heading != blank %}<div class="mbh-{{ mbh_id }}__card-heading">{{ block.settings.card_heading }}</div>{% endif %}<div class="mbh-{{ mbh_id }}__card-copy">{{ block.settings.card_text }}</div></aside>{% endif %}</div>
{% schema %}
{"name":"Mont. baby banner","settings":[{"type":"image_picker","id":"background_image","label":"Background photo"},{"type":"text","id":"empty_text","label":"Image prompt","default":"Add the banner background photo"},{"type":"range","id":"width","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"height","label":"Desktop height","min":400,"max":900,"step":50,"unit":"px","default":650},{"type":"range","id":"mobile_height","label":"Mobile height","min":400,"max":900,"step":50,"unit":"px","default":650},{"type":"select","id":"image_position","label":"Desktop photo position","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}],"default":"center center"},{"type":"select","id":"mobile_position","label":"Mobile photo position","options":[{"value":"center center","label":"Center"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"}],"default":"center center"},{"type":"range","id":"radius","label":"Banner corner radius","min":0,"max":60,"step":5,"unit":"px","default":20},{"type":"header","content":"Banner content"},{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>Gentle by nature</p>"},{"type":"richtext","id":"heading","label":"Heading","default":"<h2>Made for their softest beginnings</h2>"},{"type":"richtext","id":"description","label":"Description","default":"<p>Thoughtful essentials made for little ones and the people who love them.</p>"},{"type":"range","id":"heading_size","label":"Heading size","min":36,"max":80,"step":2,"unit":"px","default":64},{"type":"range","id":"copy_size","label":"Body size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"padding","label":"Content padding","min":20,"max":100,"step":5,"unit":"px","default":70},{"type":"color","id":"text_color","label":"Text color","default":"#FFFFFF"},{"type":"color","id":"accent_color","label":"Eyebrow color","default":"#F2E7D7"},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#263020"},{"type":"range","id":"overlay_opacity","label":"Overlay strength","min":0,"max":80,"step":5,"unit":"%","default":35},{"type":"header","content":"Trust icons"},{"type":"image_picker","id":"trust_image_1","label":"Bamboo icon"},{"type":"richtext","id":"trust_label_1","label":"Bamboo label","default":"<p>Bamboo blend</p>"},{"type":"image_picker","id":"trust_image_2","label":"Cotton icon"},{"type":"richtext","id":"trust_label_2","label":"Cotton label","default":"<p>Organic cotton</p>"},{"type":"image_picker","id":"trust_image_3","label":"Leaf icon"},{"type":"richtext","id":"trust_label_3","label":"Leaf label","default":"<p>Naturally gentle</p>"},{"type":"header","content":"Pill button"},{"type":"text","id":"button_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"button_link","label":"Button link"},{"type":"color","id":"button_bg","label":"Button background","default":"#F5EEE4"},{"type":"color","id":"button_hover","label":"Button hover background","default":"#E6D8C5"},{"type":"color","id":"button_color","label":"Button text color","default":"#34402D"},{"type":"header","content":"Curved card"},{"type":"richtext","id":"card_heading","label":"Card heading","default":"<p>A softer kind of care</p>"},{"type":"richtext","id":"card_text","label":"Card text","default":"<p>Comfort-first pieces for every little moment.</p>"},{"type":"color","id":"card_bg","label":"Card background","default":"#F5EEE4"},{"type":"color","id":"card_color","label":"Card text color","default":"#34402D"},{"type":"range","id":"card_radius","label":"Card corner radius","min":8,"max":48,"step":4,"unit":"px","default":28}],"presets":[{"name":"Mont. baby banner"}],"tag":null,"class":"mbh-banner-block"}
{% endschema %}