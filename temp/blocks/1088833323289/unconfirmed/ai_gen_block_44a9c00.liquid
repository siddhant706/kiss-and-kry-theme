<div class="mbh-{{ mbh }}" {{ block.shopify_attributes }}>{% if bg != blank %}{% assign alt=bg.alt | default:block.settings.bg_alt %}{% assign load='lazy' %}{% if block.settings.eager_load %}{% assign load='eager' %}{% endif %}<img class="mbh-{{ mbh }}__bg" src="{{ bg | image_url:width:1800 }}" srcset="{{ bg | image_url:width:750 }} 750w, {{ bg | image_url:width:1100 }} 1100w, {{ bg | image_url:width:1500 }} 1500w, {{ bg | image_url:width:1800 }} 1800w, {{ bg | image_url:width:2200 }} 2200w, {{ bg | image_url:width:2800 }} 2800w" sizes="100vw" width="{{ bg.width }}" height="{{ bg.height }}" alt="{{ alt | escape }}" loading="{{ load }}"{% if block.settings.eager_load %} fetchpriority="high"{% endif %}>{% endif %}<div class="mbh-{{ mbh }}__overlay" aria-hidden="true"></div><div class="mbh-{{ mbh }}__text">{% if block.settings.show_eyebrow and block.settings.eyebrow!=blank %}<div class="mbh-{{ mbh }}__eyebrow">{{ block.settings.eyebrow | strip_html }}{% if block.settings.show_eyebrow_line %}<span class="mbh-{{ mbh }}__line" aria-hidden="true"></span>{% endif %}</div>{% endif %}{% if block.settings.heading!=blank %}{% capture tagname %}{{ block.settings.heading_tag }}{% endcapture %}<{{ tagname }} class="mbh-{{ mbh }}__heading">{{ block.settings.heading }}</{{ tagname }}>{% endif %}{% if block.settings.show_subtext and block.settings.subtext!=blank %}<div class="mbh-{{ mbh }}__copy">{{ block.settings.subtext }}</div>{% endif %}</div><div class="mbh-{{ mbh }}__spacer" aria-hidden="true"></div>{% if block.settings.show_badges %}<div class="mbh-{{ mbh }}__badges">{% assign badge_count=0 %}{% for badge in block.blocks %}{% if badge.type=='trust_badge' and badge.settings.label!=blank %}{% assign badge_count=badge_count | plus:1 %}{% endif %}{% endfor %}{% assign rendered=0 %}{% for badge in block.blocks %}{% if badge.type=='trust_badge' and badge.settings.label!=blank %}{% assign rendered=rendered | plus:1 %}{% capture badge_markup %}<div class="mbh-{{ mbh }}__badge" {{ badg