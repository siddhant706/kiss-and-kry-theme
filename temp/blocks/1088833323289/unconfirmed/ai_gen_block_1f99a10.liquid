{% doc %}
  @prompt
    generate a full page width cover sized hero section with full size background image and all the text as eyebrow, heading, context on left top , align all the text in equal side spacing from left perfectly aligned to each other in verticle order
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-cover-hero-{{ ai_gen_id }} {
    position: relative;
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    min-height: {{ block.settings.hero_height }}px;
    overflow: hidden;
    isolation: isolate;
    background-color: {{ block.settings.fallback_color }};
    color: {{ block.settings.text_color }};
  }

  .ai-cover-hero-{{ ai_gen_id }}__image,
  .ai-cover-hero-{{ ai_gen_id }}__placeholder,
  .ai-cover-hero-{{ ai_gen_id }}__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .ai-cover-hero-{{ ai_gen_id }}__image {
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
    z-index: -2;
  }

  .ai-cover-hero-{{ ai_gen_id }}__placeholder {
    z-index: -2;
    background: #e9e9e5;
  }

  .ai-cover-hero-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: #777;
  }

  .ai-cover-hero-{{ ai_gen_id }}__shade {
    z-index: -1;
    background: linear-gradient(90deg, rgba(0, 0, 0, {{ block.settings.overlay_opacity | divided_by: 100.0 }}) 0%, rgba(0, 0, 0, 0) 100%);
  }

  .ai-cover-hero-{{ ai_gen_id }}__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(100%, {{ block.settings.content_width }}px);
    padding: {{ block.settings.content_padding }}px;
    text-align: left;
  }

  .ai-cover-hero-{{ ai_gen_id }}__eyebrow,
  .ai-cover-hero-{{ ai_gen_id }}__heading,
  .ai-cover-hero-{{ ai_gen_id }}__context {
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin-left: 0;
    margin-right: 0;
    text-align: left;
  }

  .ai-cover-hero-{{ ai_gen_id }}__eyebrow {
    margin-top: 0;
    margin-bottom: 14px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .ai-cover-hero-{{ ai_gen_id }}__heading {
    max-width: 14ch;
    margin-top: 0;
    margin-bottom: 0;
    font-family: var(--font-heading-family, sans-serif);
    font-size: clamp(2.5rem, 6vw, {{ block.settings.heading_size }}px);
    line-height: 1.05;
    font-weight: 600;
    text-wrap: balance;
  }

  .ai-cover-hero-{{ ai_gen_id }}__context {
    max-width: 48ch;
    margin-top: 18px;
    font-family: var(--font-body-family, sans-serif);
    font-size: 1rem;
    line-height: 1.6;
  }

  .ai-cover-hero-{{ ai_gen_id }}__context p {
    margin: 0;
    text-align: left;
  }

  @media screen and (max-width: 749px) {
    .ai-cover-hero-{{ ai_gen_id }} {
      min-height: {{ block.settings.mobile_height }}px;
    }

    .ai-cover-hero-{{ ai_gen_id }}__content {
      padding: 28px;
    }
  }
{% endstyle %}

<section class="ai-cover-hero-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.background_image != blank %}
    <img
      class="ai-cover-hero-{{ ai_gen_id }}__image"
      src="{{ block.settings.background_image | image_url: width: 2400 }}"
      srcset="{{ block.settings.background_image | image_url: width: 1200 }} 1200w, {{ block.settings.background_image | image_url: width: 1800 }} 1800w, {{ block.settings.background_image | image_url: width: 2400 }} 2400w"
      sizes="100vw"
      alt="{{ block.settings.background_image.alt | escape }}"
      width="{{ block.settings.background_image.width }}"
      height="{{ block.settings.background_image.height }}"
      loading="lazy"
    >
  {% else %}
    <div class="ai-cover-hero-{{ ai_gen_id }}__placeholder">
      {{ 'hero-apparel-1' | placeholder_svg_tag }}
    </div>
  {% endif %}
  <div class="ai-cover-hero-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
  <div class="ai-cover-hero-{{ ai_gen_id }}__content">
    {% if block.settings.eyebrow != blank %}
      <p class="ai-cover-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if block.settings.heading != blank %}
      <h1 class="ai-cover-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h1>
    {% endif %}
    {% if block.settings.context != blank %}
      <div class="ai-cover-hero-{{ ai_gen_id }}__context">{{ block.settings.context }}</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Cover hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop height",
      "min": 400,
      "max": 900,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile height",
      "min": 300,
      "max": 700,
      "step": 50,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal point",
      "options": [
        { "value": "center center", "label": "Center" },
        { "value": "left center", "label": "Left" },
        { "value": "right center", "label": "Right" },
        { "value": "center top", "label": "Top" },
        { "value": "center bottom", "label": "Bottom" }
      ],
      "default": "center center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "A thoughtful collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for your everyday"
    },
    {
      "type": "richtext",
      "id": "context",
      "label": "Context",
      "default": "<p>Discover considered essentials, made to bring a little more meaning to every day.</p>"
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text width",
      "min": 320,
      "max": 800,
      "step": 40,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Content inset",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 40,
      "max": 88,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Image overlay",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "fallback_color",
      "label": "Fallback background",
      "default": "#5E6539"
    }
  ],
  "presets": [
    {
      "name": "Cover hero"
    }
  ],
  "tag": null,
  "class": "cover-hero-block"
}
{% endschema %}