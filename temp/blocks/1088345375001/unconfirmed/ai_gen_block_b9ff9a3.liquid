{% doc %}
  @prompt
    Generate a NEW section "Shop by age" using hang tags. Colour scheme: Oat.
    Heading: "Shop by age". Support line: "Not sure? Try the size helper." (links to #size-helper)
    Five tags: Newborn, 0–3 months, 3–6 months, 6–12 months, 12–24 months. Each tag is a Milk card, 20px radius, olive-tinted shadow, with an icon on top and the label below. The whole tag is the link.
    Generate five matching line icons that show a bamboo shoot growing from a tiny sprout to a taller stalk, one step per age.
    A thin copper line runs across the top of the row, and each tag hangs from it on a short thread.
    Mobile: snap-scroll row, tags 170px wide, a peek of the next tag. Desktop: five across.
    Links: the five age collections. If they do not exist, create automatic collections from product tags or titles and tell me the rule you used.
    Add a "Show this section" checkbox, on by default., make the boxes glassmorphic style and also manage life and right side spacing for this section and also allow me to change age wise icons in PNG and heading and title all the texts alignement and size , color and background color of this section, remove this brown lines from this section , all the content should be in rich text elements style
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-age-section-{{ ai_gen_id }}{display:block;box-sizing:border-box;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:{{ block.settings.vertical_spacing }}px {{ block.settings.side_spacing }}px;background:{{ block.settings.section_background }};color:{{ block.settings.text_color }}}
.ai-age-heading-{{ ai_gen_id }}{margin:0 0 8px;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size }}px;line-height:1.15;text-align:{{ block.settings.text_alignment }}}
.ai-age-heading-{{ ai_gen_id }} p,.ai-age-support-{{ ai_gen_id }} p,.ai-age-label-{{ ai_gen_id }} p{margin:0}
.ai-age-support-{{ ai_gen_id }}{margin:0 0 26px;font-size:{{ block.settings.support_size }}px;color:{{ block.settings.text_color }};text-align:{{ block.settings.text_alignment }}}
.ai-age-support-{{ ai_gen_id }} a{color:{{ block.settings.text_color }};text-underline-offset:3px}
.ai-age-list-{{ ai_gen_id }}{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:18px;padding:0;margin:0;list-style:none}
.ai-age-item-{{ ai_gen_id }}{min-width:0;padding-top:8px}
.ai-age-link-{{ ai_gen_id }}{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;min-height:186px;padding:20px 12px 18px;border:1px solid {{ block.settings.card_border_color }};border-radius:20px;background:{{ block.settings.card_color | color_modify: 'alpha', block.settings.card_opacity | divided_by: 100.0 }};color:{{ block.settings.text_color }};text-align:{{ block.settings.text_alignment }};text-decoration:none;box-shadow:0 5px 13px rgba(94,101,57,.20);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px)}
.ai-age-link-{{ ai_gen_id }}:hover{box-shadow:0 7px 17px rgba(94,101,57,.30)}
.ai-age-link-{{ ai_gen_id }}:focus-visible,.ai-age-support-{{ ai_gen_id }} a:focus-visible{outline:3px solid {{ block.settings.text_color }};outline-offset:3px}
.ai-age-icon-{{ ai_gen_id }}{display:block;width:{{ block.settings.icon_size }}px;height:{{ block.settings.icon_size }}px;object-fit:contain;color:{{ block.settings.icon_color }}}
.ai-age-label-{{ ai_gen_id }}{color:{{ block.settings.text_color }};font-size:{{ block.settings.label_size }}px;line-height:1.3;font-weight:600}
@media screen and (max-width:749px){.ai-age-section-{{ ai_gen_id }}{padding:{{ block.settings.mobile_vertical_spacing }}px {{ block.settings.mobile_side_spacing }}px}.ai-age-list-{{ ai_gen_id }}{display:flex;gap:14px;overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:thin;padding:0 18px 12px 2px}.ai-age-item-{{ ai_gen_id }}{flex:0 0 170px;scroll-snap-align:start}.ai-age-link-{{ ai_gen_id }}{min-height:176px}}
{% endstyle %}
{% if block.settings.show_section %}<section class="ai-age-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-age-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</div><div class="ai-age-support-{{ ai_gen_id }}">{{ block.settings.support_text }}</div><ul class="ai-age-list-{{ ai_gen_id }}">
{% for i in (1..5) %}{% liquid
assign collection_key = 'age_collection_' | append: i
assign collection_obj = block.settings[collection_key]
assign title_key = 'age_label_' | append: i
assign age_label = block.settings[title_key]
assign icon_key = 'age_icon_' | append: i
assign age_icon = block.settings[icon_key]
assign age_link = '/collections/' | append: age_label | handleize
if collection_obj != blank
assign age_link = collection_obj.url
endif
%}<li class="ai-age-item-{{ ai_gen_id }}"><a class="ai-age-link-{{ ai_gen_id }}" href="{{ age_link }}" aria-label="Shop {{ age_label | strip_html | escape }}">{% if age_icon != blank %}<img class="ai-age-icon-{{ ai_gen_id }}" src="{{ age_icon | image_url: width: 240 }}" alt="" loading="lazy" width="{{ block.settings.icon_size }}" height="{{ block.settings.icon_size }}">{% else %}<svg class="ai-age-icon-{{ ai_gen_id }}" viewBox="0 0 72 84" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg"><path d="M36 74V56M36 58C29 56 26 51 27 46C33 47 37 51 36 58Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>{% if i >= 2 %}<path d="M36 51C42 49 45 45 44 40C39 41 35 45 36 51Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>{% endif %}{% if i >= 3 %}<path d="M36 43C29 41 26 36 27 31C33 32 37 36 36 43Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>{% endif %}{% if i >= 4 %}<path d="M36 35C42 33 45 29 44 24C39 25 35 29 36 35Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>{% endif %}{% if i >= 5 %}<path d="M36 27C29 25 27 20 28 15C33 16 37 20 36 27Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>{% endif %}<path d="M24 74H48M31 74C31 70 33 68 36 68C39 68 41 70 41 74" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>{% if i == 1 %}<circle cx="36" cy="62" r="2" fill="currentColor"/>{% endif %}</svg>{% endif %}<div class="ai-age-label-{{ ai_gen_id }}">{{ age_label }}</div></a></li>{% endfor %}
</ul></section>{% endif %}
{% schema %}{
"name":"Shop by age","tag":null,"class":"shop-by-age-block","settings":[{"type":"checkbox","id":"show_section","label":"Show this section","default":true},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"header","content":"Section style"},{"type":"color","id":"section_background","label":"Background","default":"#F3EEE2"},{"type":"color","id":"text_color","label":"Text","default":"#41452B"},{"type":"color","id":"heading_color","label":"Heading color","default":"#41452B"},{"type":"select","id":"text_alignment","label":"Text alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"},{"value":"right","label":"Right"}],"default":"left"},{"type":"range","id":"heading_size","label":"Heading size","min":20,"max":56,"step":2,"unit":"px","default":40},{"type":"range","id":"support_size","label":"Support text size","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"range","id":"label_size","label":"Tag label size","min":12,"max":24,"step":1,"unit":"px","default":15},{"type":"range","id":"vertical_spacing","label":"Vertical spacing","min":0,"max":80,"step":4,"unit":"px","default":32},{"type":"range","id":"side_spacing","label":"Left and right spacing","min":0,"max":80,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_vertical_spacing","label":"Mobile vertical spacing","min":0,"max":60,"step":4,"unit":"px","default":24},{"type":"range","id":"mobile_side_spacing","label":"Mobile side spacing","min":0,"max":40,"step":2,"unit":"px","default":12},{"type":"header","content":"Glass cards and icons"},{"type":"color","id":"card_color","label":"Card tint","default":"#FFFDF7"},{"type":"range","id":"card_opacity","label":"Card transparency","min":30,"max":100,"step":5,"unit":"%","default":75},{"type":"color","id":"card_border_color","label":"Card border","default":"#FFFFFF"},{"type":"color","id":"icon_color","label":"Icon color","default":"#5E6539"},{"type":"range","id":"icon_size","label":"Icon size","min":40,"max":120,"step":5,"unit":"px","default":70},{"type":"header","content":"Section content"},{"type":"richtext","id":"heading","label":"Heading","default":"<h2>Shop by age</h2>"},{"type":"richtext","id":"support_text","label":"Support line","default":"<p>Not sure? <a href=\"#size-helper\">Try the size helper.</a></p>"},{"type":"header","content":"Age tags and collections"},{"type":"richtext","id":"age_label_1","label":"Age 1 label","default":"<p>Newborn</p>"},{"type":"image_picker","id":"age_icon_1","label":"Age 1 icon PNG"},{"type":"collection","id":"age_collection_1","label":"Newborn collection"},{"type":"richtext","id":"age_label_2","label":"Age 2 label","default":"<p>0–3 months</p>"},{"type":"image_picker","id":"age_icon_2","label":"Age 2 icon PNG"},{"type":"collection","id":"age_collection_2","label":"0–3 months collection"},{"type":"richtext","id":"age_label_3","label":"Age 3 label","default":"<p>3–6 months</p>"},{"type":"image_picker","id":"age_icon_3","label":"Age 3 icon PNG"},{"type":"collection","id":"age_collection_3","label":"3–6 months collection"},{"type":"richtext","id":"age_label_4","label":"Age 4 label","default":"<p>6–12 months</p>"},{"type":"image_picker","id":"age_icon_4","label":"Age 4 icon PNG"},{"type":"collection","id":"age_collection_4","label":"6–12 months collection"},{"type":"richtext","id":"age_label_5","label":"Age 5 label","default":"<p>12–24 months</p>"},{"type":"image_picker","id":"age_icon_5","label":"Age 5 icon PNG"},{"type":"collection","id":"age_collection_5","label":"12–24 months collection"}],"presets":[{"name":"Shop by age"}]}
{% endschema %}