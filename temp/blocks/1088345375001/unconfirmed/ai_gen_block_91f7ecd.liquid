{% doc %}
  @prompt
    Generate a NEW comparison section. Colour scheme: Milk.
    Heading: "Bamboo viscose or cotton?" Support line: "Here is where bamboo viscose helps."
    Two cards, stacked on mobile and side by side on desktop, 28px radius. Left card (Sage mist): a bamboo leaf icon and the title "Bamboo viscose". Right card (Oat): a cotton boll icon and the title "Cotton".
    Three rows in each: Feel, Breathability, Care. Each row is a small label and one short line.
    Use only these facts: Feel: [fact]. Breathability: [fact]. Care: [fact]. If a fact is missing, leave that row out.
    Generate two icons: a bamboo leaf and a cotton boll, 1.5px line, olive. No fabric close-ups, no percentages, no health words.
    Add a "Show this section" checkbox, on by default., these facts: Feel: [fact]. Breathability: [fact]. Care: [fact]. If a fact is missing, leave that row out.
    Generate two icons: a bamboo leaf and a cotton boll, 1.5px line, olive. No fabric close-ups, no percentages, no health words.
    Add a "Show this section" checkbox, on by default.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-fabric-compare-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    padding: 48px 24px;
    background: #f7f5ee;
    color: #343820;
  }

  .ai-fabric-compare-{{ ai_gen_id }}[hidden] { display: none; }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__inner-{{ ai_gen_id }} {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__intro-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 auto 30px;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__heading-{{ ai_gen_id }} {
    margin: 0;
    color: #343820;
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(28px, 4vw, 44px);
    line-height: 1.12;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__support-{{ ai_gen_id }} {
    margin: 12px 0 0;
    color: #5e6539;
    font-size: 16px;
    line-height: 1.5;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__cards-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__card-{{ ai_gen_id }} {
    min-width: 0;
    padding: 28px;
    border-radius: 28px;
    color: #343820;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__card--bamboo-{{ ai_gen_id }} { background: #dce4d8; }
  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__card--cotton-{{ ai_gen_id }} { background: #e9ddc7; }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__card-header-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 20px;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__icon-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    color: #5e6539;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__icon-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__title-{{ ai_gen_id }} {
    margin: 0;
    color: #343820;
    font-size: 22px;
    line-height: 1.25;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__row-{{ ai_gen_id }} {
    padding: 14px 0;
    border-top: 1px solid rgba(52, 56, 32, 0.24);
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__label-{{ ai_gen_id }} {
    display: block;
    margin-bottom: 4px;
    color: #4b502e;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__fact-{{ ai_gen_id }} {
    margin: 0;
    color: #343820;
    font-size: 15px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-fabric-compare-{{ ai_gen_id }} { padding: 36px 18px; }
    .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__cards-{{ ai_gen_id }} { grid-template-columns: 1fr; gap: 14px; }
    .ai-fabric-compare-{{ ai_gen_id }} .ai-fabric-compare__card-{{ ai_gen_id }} { padding: 22px; }
  }
{% endstyle %}

{% if block.settings.show_section %}
  <section class="ai-fabric-compare-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-fabric-compare__inner-{{ ai_gen_id }}">
      <header class="ai-fabric-compare__intro-{{ ai_gen_id }}">
        <h2 class="ai-fabric-compare__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
        {% if block.settings.support_line != blank %}
          <p class="ai-fabric-compare__support-{{ ai_gen_id }}">{{ block.settings.support_line | escape }}</p>
        {% endif %}
      </header>
      <div class="ai-fabric-compare__cards-{{ ai_gen_id }}">
        <article class="ai-fabric-compare__card-{{ ai_gen_id }} ai-fabric-compare__card--bamboo-{{ ai_gen_id }}">
          <div class="ai-fabric-compare__card-header-{{ ai_gen_id }}">
            <span class="ai-fabric-compare__icon-{{ ai_gen_id }}" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M8 39C18 31 27 21 39 8"/><path d="M14 33C9 26 9 19 12 14c7 2 11 7 12 13"/><path d="M23 24c-2-8 0-14 5-18 6 4 8 10 6 17"/><path d="M16 31 12 17M25 23l3-13"/></svg>
            </span>
            <h3 class="ai-fabric-compare__title-{{ ai_gen_id }}">Bamboo viscose</h3>
          </div>
          {% if block.settings.bamboo_feel != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Feel</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.bamboo_feel | escape }}</p></div>{% endif %}
          {% if block.settings.bamboo_breathability != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Breathability</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.bamboo_breathability | escape }}</p></div>{% endif %}
          {% if block.settings.bamboo_care != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Care</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.bamboo_care | escape }}</p></div>{% endif %}
        </article>
        <article class="ai-fabric-compare__card-{{ ai_gen_id }} ai-fabric-compare__card--cotton-{{ ai_gen_id }}">
          <div class="ai-fabric-compare__card-header-{{ ai_gen_id }}">
            <span class="ai-fabric-compare__icon-{{ ai_gen_id }}" aria-hidden="true">
              <svg viewBox="0 0 48 48"><path d="M24 40V23"/><path d="M24 29c-5 0-9-4-9-9 0-3 2-6 5-7 1-5 7-7 11-4 4 2 5 7 3 11 2 5-2 9-7 9"/><path d="M18 14c-4-1-7 1-8 5-1 4 2 7 6 7M30 9c4-2 8 0 9 4 2 4 0 8-4 9M20 40h8M24 29c-3 2-5 4-5 7M24 29c3 2 5 4 5 7"/></svg>
            </span>
            <h3 class="ai-fabric-compare__title-{{ ai_gen_id }}">Cotton</h3>
          </div>
          {% if block.settings.cotton_feel != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Feel</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.cotton_feel | escape }}</p></div>{% endif %}
          {% if block.settings.cotton_breathability != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Breathability</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.cotton_breathability | escape }}</p></div>{% endif %}
          {% if block.settings.cotton_care != blank %}<div class="ai-fabric-compare__row-{{ ai_gen_id }}"><span class="ai-fabric-compare__label-{{ ai_gen_id }}">Care</span><p class="ai-fabric-compare__fact-{{ ai_gen_id }}">{{ block.settings.cotton_care | escape }}</p></div>{% endif %}
        </article>
      </div>
    </div>
  </section>
{% endif %}

{% schema %}
{
  "name": "Fabric comparison",
  "settings": [
    {"type":"checkbox","id":"show_section","label":"Show this section","default":true},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},
    {"type":"text","id":"heading","label":"Heading","default":"Bamboo viscose or cotton?"},
    {"type":"text","id":"support_line","label":"Support line","default":"Here is where bamboo viscose helps."},
    {"type":"header","content":"Bamboo viscose facts"},
    {"type":"text","id":"bamboo_feel","label":"Feel"},
    {"type":"text","id":"bamboo_breathability","label":"Breathability"},
    {"type":"text","id":"bamboo_care","label":"Care"},
    {"type":"header","content":"Cotton facts"},
    {"type":"text","id":"cotton_feel","label":"Feel"},
    {"type":"text","id":"cotton_breathability","label":"Breathability"},
    {"type":"text","id":"cotton_care","label":"Care"}
  ],
  "presets": [{"name":"Fabric comparison"}],
  "tag": null,
  "class": "fabric-comparison-block"
}
{% endschema %}