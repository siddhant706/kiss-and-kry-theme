{% doc %}
  @prompt
    Generate a NEW product section. Colour scheme: Oat.
    Heading: "Best sellers". Button: "Shop all".
    Show four products from all products, sorted by best selling. 2 by 2 on mobile, 4 across on desktop.
    Use the theme's own product card and quick add. Style them, do not rebuild them. Card: 4:5 image, 20px radius, title in 15px (two lines), price in 16px bold. A badge ("New" or "Best seller") in Kry maroon from the product tag. Quick add is a 44px round Bamboo button on the image.
    Generate no images. Photos and prices come from the store.
    Add a "Show this section" checkbox, on by default., allow me to connect products and show demo skeletons, manage left and right side spacings, product are not visible while connected, show in bento grid style , Make this section look more catchy and aesthetic
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign all_products_collection = collections['all'] %}
{% style %}
.ai-best-sellers-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:44px {{ block.settings.side_spacing }}px;background:#f2ecdf;color:#3d302b;box-sizing:border-box;border-radius:24px}.ai-best-sellers-{{ ai_gen_id }}__header{display:flex;align-items:flex-end;justify-content:space-between;gap:16px;margin:0 0 26px}.ai-best-sellers-{{ ai_gen_id }}__heading-wrap{display:flex;flex-direction:column;gap:8px}.ai-best-sellers-{{ ai_gen_id }}__eyebrow{margin:0;color:#6e7453;font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.ai-best-sellers-{{ ai_gen_id }}__heading{margin:0;font-size:clamp(30px,4vw,48px);line-height:1.05;letter-spacing:-.04em;color:#3d302b}.ai-best-sellers-{{ ai_gen_id }}__link{display:inline-flex;align-items:center;justify-content:center;min-height:46px;padding:0 24px;border:1px solid #5e2734;border-radius:100px;color:#fff;background:#5e2734;text-decoration:none;font-size:14px;font-weight:600;white-space:nowrap}.ai-best-sellers-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(170px,auto);gap:16px}.ai-best-sellers-{{ ai_gen_id }}__card{position:relative;min-width:0;display:flex;flex-direction:column;padding:8px 8px 14px;border-radius:24px;background:#fbf8f1;box-shadow:0 4px 18px rgba(61,48,43,.06);overflow:hidden}.ai-best-sellers-{{ ai_gen_id }}__card:first-child{grid-column:span 2;grid-row:span 2}.ai-best-sellers-{{ ai_gen_id }}__card:nth-child(4){grid-column:span 2}.ai-best-sellers-{{ ai_gen_id }}__image-link{position:relative;display:block;overflow:hidden;aspect-ratio:4/5;border-radius:18px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__card:first-child .ai-best-sellers-{{ ai_gen_id }}__image-link{height:100%;min-height:100%;aspect-ratio:auto}.ai-best-sellers-{{ ai_gen_id }}__image{display:block;width:100%;height:100%;object-fit:cover}.ai-best-sellers-{{ ai_gen_id }}__badge{position:absolute;z-index:2;top:18px;left:18px;padding:7px 12px;border-radius:100px;background:#5e2734;color:#fff;font-size:11px;line-height:1.2;font-weight:700;letter-spacing:.03em}.ai-best-sellers-{{ ai_gen_id }}__card-title{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:12px 8px 5px;color:inherit;text-decoration:none;font-size:15px;line-height:1.35}.ai-best-sellers-{{ ai_gen_id }}__price{margin:0 8px;color:#3d302b;font-size:16px;font-weight:700}.ai-best-sellers-{{ ai_gen_id }}__skeleton-media{width:100%;aspect-ratio:4/5;border-radius:18px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__skeleton-line{height:12px;margin:14px 8px 0;border-radius:8px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__skeleton-line--short{width:62%;height:14px;margin-top:8px}@media(max-width:749px){.ai-best-sellers-{{ ai_gen_id }}{padding:28px {{ block.settings.side_spacing | at_most: 32 }}px;border-radius:18px}.ai-best-sellers-{{ ai_gen_id }}__header{align-items:center;margin-bottom:20px}.ai-best-sellers-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:auto;gap:12px 9px}.ai-best-sellers-{{ ai_gen_id }}__card:first-child{grid-column:span 2;grid-row:auto}.ai-best-sellers-{{ ai_gen_id }}__card:first-child .ai-best-sellers-{{ ai_gen_id }}__image-link{aspect-ratio:4/5}.ai-best-sellers-{{ ai_gen_id }}__card:nth-child(4){grid-column:auto}.ai-best-sellers-{{ ai_gen_id }}__card{padding:5px 5px 10px;border-radius:17px}.ai-best-sellers-{{ ai_gen_id }}__image-link{border-radius:13px}.ai-best-sellers-{{ ai_gen_id }}__heading{font-size:30px}.ai-best-sellers-{{ ai_gen_id }}__link{min-height:40px;padding:0 16px;font-size:13px}.ai-best-sellers-{{ ai_gen_id }}__card-title{margin:9px 5px 4px;font-size:14px}.ai-best-sellers-{{ ai_gen_id }}__price{margin:0 5px;font-size:15px}}
{% endstyle %}
{% if block.settings.show_section %}<section class="ai-best-sellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-best-sellers-{{ ai_gen_id }}__header"><div class="ai-best-sellers-{{ ai_gen_id }}__heading-wrap"><p class="ai-best-sellers-{{ ai_gen_id }}__eyebrow">Curated for you</p><h2 class="ai-best-sellers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2></div><a class="ai-best-sellers-{{ ai_gen_id }}__link" href="{{ block.settings.button_link | default: all_products_collection.url }}">{{ block.settings.button_label | escape }}</a></div><div class="ai-best-sellers-{{ ai_gen_id }}__grid">{% assign connected_products = block.settings.products %}{% if connected_products != blank %}{% for product in connected_products limit: 4 %}<article class="ai-best-sellers-{{ ai_gen_id }}__card">{% for tag in product.tags %}{% assign tag_lower = tag | downcase %}{% if tag_lower == 'new' or tag_lower == 'best seller' %}<span class="ai-best-sellers-{{ ai_gen_id }}__badge">{{ tag | escape }}</span>{% break %}{% endif %}{% endfor %}<a class="ai-best-sellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-best-sellers-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</a><a class="ai-best-sellers-{{ ai_gen_id }}__card-title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</div></article>{% endfor %}{% elsif block.settings.show_demo_skeletons %}{% for i in (1..4) %}<div class="ai-best-sellers-{{ ai_gen_id }}__card" aria-hidden="true"><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-media"></div><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-line"></div><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-line ai-best-sellers-{{ ai_gen_id }}__skeleton-line--short"></div></div>{% endfor %}{% else %}{% for product in all_products_collection.products limit: 4 %}<article class="ai-best-sellers-{{ ai_gen_id }}__card"><a class="ai-best-sellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-best-sellers-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}</a><a class="ai-best-sellers-{{ ai_gen_id }}__card-title" href="{{ product.url }}">{{ product.title | escape }}</a><div class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</div></article>{% endfor %}{% endif %}</div></section>{% endif %}
{% schema %}{"name":"Best sellers grid","settings":[{"type":"checkbox","id":"show_section","label":"Show this section","default":true},{"type":"text","id":"heading","label":"Heading","default":"Best sellers"},{"type":"text","id":"button_label","label":"Button","default":"Shop all"},{"type":"url","id":"button_link","label":"Button link"},{"type":"product_list","id":"products","label":"Products","limit":4},{"type":"checkbox","id":"show_demo_skeletons","label":"Show demo skeletons when no products are connected","default":true},{"type":"range","id":"side_spacing","label":"Left and right spacing","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Best sellers grid"}],"tag":null,"class":"best-sellers-grid"}{% endschema %}