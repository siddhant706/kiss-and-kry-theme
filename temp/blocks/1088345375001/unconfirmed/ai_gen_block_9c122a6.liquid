{% doc %}
  @prompt
    Generate a NEW product section. Colour scheme: Oat.
    Heading: "Best sellers". Button: "Shop all".
    Show four products from all products, sorted by best selling. 2 by 2 on mobile, 4 across on desktop.
    Use the theme's own product card and quick add. Style them, do not rebuild them. Card: 4:5 image, 20px radius, title in 15px (two lines), price in 16px bold. A badge ("New" or "Best seller") in Kry maroon from the product tag. Quick add is a 44px round Bamboo button on the image.
    Generate no images. Photos and prices come from the store.
    Add a "Show this section" checkbox, on by default., allow me to connect products and show demo skeletons, manage left and right side spacings, product are not visible while connected, show in bento grid style , Make this section look more catchy and aesthetic, show the price and product name in product image use glassmorph to shos , adjust the font size, and make this section more detailed and catchy , now allow me change all the texts in this section in rich style texts and background color for this section and border color of bento cards
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign all_products_collection = collections['all'] %}
{% style %}
.ai-best-sellers-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;padding:44px {{ block.settings.side_spacing }}px;background:{{ block.settings.section_background }};color:#3d302b;box-sizing:border-box;border-radius:24px}.ai-best-sellers-{{ ai_gen_id }}__header{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin:0 0 26px}.ai-best-sellers-{{ ai_gen_id }}__heading-wrap{display:flex;flex-direction:column;gap:9px;max-width:720px}.ai-best-sellers-{{ ai_gen_id }}__eyebrow{margin:0;color:#6e7453;font-size:12px;font-weight:700;letter-spacing:.16em;text-transform:uppercase}.ai-best-sellers-{{ ai_gen_id }}__eyebrow p,.ai-best-sellers-{{ ai_gen_id }}__heading p,.ai-best-sellers-{{ ai_gen_id }}__description p,.ai-best-sellers-{{ ai_gen_id }}__link p{margin:0}.ai-best-sellers-{{ ai_gen_id }}__heading{margin:0;font-size:{{ block.settings.heading_size }}px;line-height:1.05;letter-spacing:-.04em;color:#3d302b}.ai-best-sellers-{{ ai_gen_id }}__heading h1,.ai-best-sellers-{{ ai_gen_id }}__heading h2,.ai-best-sellers-{{ ai_gen_id }}__heading h3,.ai-best-sellers-{{ ai_gen_id }}__heading h4,.ai-best-sellers-{{ ai_gen_id }}__heading h5,.ai-best-sellers-{{ ai_gen_id }}__heading h6,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h1,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h2,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h3,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h4,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h5,.ai-best-sellers-{{ ai_gen_id }}__eyebrow h6{margin:0;font:inherit;color:inherit}.ai-best-sellers-{{ ai_gen_id }}__description{margin:0;color:#514640;font-size:{{ block.settings.description_size }}px;line-height:1.5}.ai-best-sellers-{{ ai_gen_id }}__link{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:0 25px;border:1px solid #5e2734;border-radius:100px;color:#fff;background:#5e2734;text-decoration:none;font-size:15px;font-weight:650;white-space:nowrap}.ai-best-sellers-{{ ai_gen_id }}__grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));grid-auto-rows:minmax(170px,auto);gap:16px}.ai-best-sellers-{{ ai_gen_id }}__card{position:relative;min-width:0;display:flex;flex-direction:column;padding:8px;border:1px solid {{ block.settings.card_border_color }};border-radius:24px;background:#fbf8f1;box-shadow:0 5px 22px rgba(61,48,43,.09);overflow:hidden}.ai-best-sellers-{{ ai_gen_id }}__card:first-child{grid-column:span 2;grid-row:span 2}.ai-best-sellers-{{ ai_gen_id }}__card:nth-child(4){grid-column:span 2}.ai-best-sellers-{{ ai_gen_id }}__image-link{position:relative;display:block;overflow:hidden;aspect-ratio:4/5;border-radius:18px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__card:first-child .ai-best-sellers-{{ ai_gen_id }}__image-link{height:100%;min-height:100%;aspect-ratio:auto}.ai-best-sellers-{{ ai_gen_id }}__image{display:block;width:100%;height:100%;object-fit:cover}.ai-best-sellers-{{ ai_gen_id }}__badge{position:absolute;z-index:3;top:16px;left:16px;padding:7px 12px;border-radius:100px;background:#5e2734;color:#fff;font-size:12px;line-height:1.2;font-weight:700;letter-spacing:.03em}.ai-best-sellers-{{ ai_gen_id }}__glass{position:absolute;z-index:2;left:12px;right:12px;bottom:12px;display:flex;align-items:flex-end;justify-content:space-between;gap:10px;padding:14px 16px;border:1px solid rgba(255,255,255,.72);border-radius:16px;background:rgba(250,248,242,.88);color:#302824;box-shadow:0 5px 18px rgba(40,30,24,.15);-webkit-backdrop-filter:blur(14px);backdrop-filter:blur(14px)}.ai-best-sellers-{{ ai_gen_id }}__glass-copy{min-width:0}.ai-best-sellers-{{ ai_gen_id }}__card-title{display:-webkit-box;overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:2;margin:0;color:inherit;text-decoration:none;font-size:{{ block.settings.product_title_size }}px;line-height:1.3;font-weight:600}.ai-best-sellers-{{ ai_gen_id }}__price{flex:0 0 auto;margin:0;color:#3d302b;font-size:{{ block.settings.price_size }}px;font-weight:700;white-space:nowrap}.ai-best-sellers-{{ ai_gen_id }}__skeleton-media{width:100%;aspect-ratio:4/5;border-radius:18px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__skeleton-line{height:12px;margin:14px 8px 0;border-radius:8px;background:#e5dece}.ai-best-sellers-{{ ai_gen_id }}__skeleton-line--short{width:62%;height:14px;margin-top:8px}@media(max-width:749px){.ai-best-sellers-{{ ai_gen_id }}{padding:28px {{ block.settings.side_spacing | at_most: 32 }}px;border-radius:18px}.ai-best-sellers-{{ ai_gen_id }}__header{align-items:center;margin-bottom:20px}.ai-best-sellers-{{ ai_gen_id }}__grid{grid-template-columns:repeat(2,minmax(0,1fr));grid-auto-rows:auto;gap:12px 9px}.ai-best-sellers-{{ ai_gen_id }}__card:first-child{grid-column:span 2;grid-row:auto}.ai-best-sellers-{{ ai_gen_id }}__card:first-child .ai-best-sellers-{{ ai_gen_id }}__image-link{aspect-ratio:4/5}.ai-best-sellers-{{ ai_gen_id }}__card:nth-child(4){grid-column:auto}.ai-best-sellers-{{ ai_gen_id }}__card{padding:5px;border-radius:17px}.ai-best-sellers-{{ ai_gen_id }}__image-link{border-radius:13px}.ai-best-sellers-{{ ai_gen_id }}__heading{font-size:min({{ block.settings.heading_size }}px, 9vw)}.ai-best-sellers-{{ ai_gen_id }}__link{min-height:40px;padding:0 16px;font-size:13px}.ai-best-sellers-{{ ai_gen_id }}__glass{left:7px;right:7px;bottom:7px;gap:6px;padding:9px;border-radius:12px}.ai-best-sellers-{{ ai_gen_id }}__card-title{font-size:min({{ block.settings.product_title_size }}px, 4vw)}.ai-best-sellers-{{ ai_gen_id }}__price{font-size:min({{ block.settings.price_size }}px, 4vw)}.ai-best-sellers-{{ ai_gen_id }}__badge{top:10px;left:10px;padding:6px 9px;font-size:10px}.ai-best-sellers-{{ ai_gen_id }}__description{font-size:min({{ block.settings.description_size }}px, 4vw)}}
{% endstyle %}
{% if block.settings.show_section %}<section class="ai-best-sellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-best-sellers-{{ ai_gen_id }}__header"><div class="ai-best-sellers-{{ ai_gen_id }}__heading-wrap">{% if block.settings.eyebrow != blank %}<div class="ai-best-sellers-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}<div class="ai-best-sellers-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>{% if block.settings.description != blank %}<div class="ai-best-sellers-{{ ai_gen_id }}__description">{{ block.settings.description }}</div>{% endif %}</div><a class="ai-best-sellers-{{ ai_gen_id }}__link" href="{{ block.settings.button_link | default: all_products_collection.url }}">{{ block.settings.button_label }}</a></div><div class="ai-best-sellers-{{ ai_gen_id }}__grid">{% assign connected_products = block.settings.products %}{% if connected_products != blank %}{% for product in connected_products limit: 4 %}<article class="ai-best-sellers-{{ ai_gen_id }}__card"><a class="ai-best-sellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-best-sellers-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% else %}<div>{{ 'product-apparel-1' | placeholder_svg_tag }}</div>{% endif %}{% for tag in product.tags %}{% assign tag_lower = tag | downcase %}{% if tag_lower == 'new' or tag_lower == 'best seller' %}<span class="ai-best-sellers-{{ ai_gen_id }}__badge">{{ tag | escape }}</span>{% break %}{% endif %}{% endfor %}<span class="ai-best-sellers-{{ ai_gen_id }}__glass"><span class="ai-best-sellers-{{ ai_gen_id }}__glass-copy"><span class="ai-best-sellers-{{ ai_gen_id }}__card-title">{{ product.title | escape }}</span></span><span class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</span></span></a></article>{% endfor %}{% elsif block.settings.show_demo_skeletons %}{% for i in (1..4) %}<div class="ai-best-sellers-{{ ai_gen_id }}__card" aria-hidden="true"><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-media"></div><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-line"></div><div class="ai-best-sellers-{{ ai_gen_id }}__skeleton-line ai-best-sellers-{{ ai_gen_id }}__skeleton-line--short"></div></div>{% endfor %}{% else %}{% for product in all_products_collection.products limit: 4 %}<article class="ai-best-sellers-{{ ai_gen_id }}__card"><a class="ai-best-sellers-{{ ai_gen_id }}__image-link" href="{{ product.url }}">{% if product.featured_image %}<img class="ai-best-sellers-{{ ai_gen_id }}__image" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">{% endif %}<span class="ai-best-sellers-{{ ai_gen_id }}__glass"><span class="ai-best-sellers-{{ ai_gen_id }}__glass-copy"><span class="ai-best-sellers-{{ ai_gen_id }}__card-title">{{ product.title | escape }}</span></span><span class="ai-best-sellers-{{ ai_gen_id }}__price">{{ product.price | money }}</span></span></a></article>{% endfor %}{% endif %}</div></section>{% endif %}
{% schema %}{"name":"Best sellers grid","settings":[{"type":"checkbox","id":"show_section","label":"Show this section","default":true},{"type":"richtext","id":"heading","label":"Heading","default":"<h2>Best sellers</h2>"},{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>A little something special</p>"},{"type":"richtext","id":"description","label":"Description","default":"<p>Shop the pieces everyone is reaching for.</p>"},{"type":"richtext","id":"button_label","label":"Button text","default":"<p>Shop all →</p>"},{"type":"url","id":"button_link","label":"Button link"},{"type":"product_list","id":"products","label":"Products","limit":4},{"type":"checkbox","id":"show_demo_skeletons","label":"Show demo skeletons when no products are connected","default":true},{"type":"range","id":"heading_size","label":"Heading size","min":24,"max":64,"step":2,"unit":"px","default":48},{"type":"range","id":"description_size","label":"Description size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"product_title_size","label":"Product name size","min":12,"max":22,"step":1,"unit":"px","default":15},{"type":"range","id":"price_size","label":"Price size","min":12,"max":24,"step":1,"unit":"px","default":16},{"type":"range","id":"side_spacing","label":"Left and right spacing","min":0,"max":100,"step":5,"unit":"px","default":20},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"color","id":"section_background","label":"Section background","default":"#F2ECDF"},{"type":"color","id":"card_border_color","label":"Card border","default":"#D7CBB8"}],"presets":[{"name":"Best sellers grid"}],"tag":null,"class":"best-sellers-grid"}{% endschema %}