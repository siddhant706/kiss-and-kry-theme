{% doc %}
  @prompt
    Generate a NEW product section. Colour scheme: Oat.
    Heading: "Best sellers". Button: "Shop all".
    Show four products from all products, sorted by best selling. 2 by 2 on mobile, 4 across on desktop.
    Use the theme's own product card and quick add. Style them, do not rebuild them. Card: 4:5 image, 20px radius, title in 15px (two lines), price in 16px bold. A badge ("New" or "Best seller") in Kry maroon from the product tag. Quick add is a 44px round Bamboo button on the image.
    Generate no images. Photos and prices come from the store.
    Add a "Show this section" checkbox, on by default.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign all_products_collection = collections['all'] %}
{% style %}
  .ai-best-sellers-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: 32px 0;
    background: #eee7d8;
    color: #3d302b;
  }
  .ai-best-sellers-{{ ai_gen_id }}__inner { width: 100%; }
  .ai-best-sellers-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0 0 22px;
  }
  .ai-best-sellers-{{ ai_gen_id }}__heading {
    margin: 0;
    font-family: var(--font-heading--family, inherit);
    font-size: 32px;
    line-height: 1.15;
    color: #3d302b;
  }
  .ai-best-sellers-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 22px;
    border: 1px solid #5e2734;
    border-radius: 100px;
    color: #fff;
    background: #5e2734;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
  }
  .ai-best-sellers-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }
  .ai-best-sellers-{{ ai_gen_id }}__item { position: relative; min-width: 0; }
  .ai-best-sellers-{{ ai_gen_id }}__item .product-card__media,
  .ai-best-sellers-{{ ai_gen_id }}__item .product-card__image,
  .ai-best-sellers-{{ ai_gen_id }}__item .product-card__media-container {
    aspect-ratio: 4 / 5;
    border-radius: 20px;
    overflow: hidden;
  }
  .ai-best-sellers-{{ ai_gen_id }}__item .product-card__title,
  .ai-best-sellers-{{ ai_gen_id }}__item .product-title {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    font-size: 15px;
    line-height: 1.35;
  }
  .ai-best-sellers-{{ ai_gen_id }}__item .price,
  .ai-best-sellers-{{ ai_gen_id }}__item .product-card__price {
    font-size: 16px;
    font-weight: 700;
  }
  .ai-best-sellers-{{ ai_gen_id }}__item .quick-add,
  .ai-best-sellers-{{ ai_gen_id }}__item .quick-add__button,
  .ai-best-sellers-{{ ai_gen_id }}__item button[name="add"] {
    width: 44px;
    height: 44px;
    min-width: 44px;
    min-height: 44px;
    border-radius: 50%;
    background: #d9dfc7;
    color: #332f27;
  }
  .ai-best-sellers-{{ ai_gen_id }}__badge {
    position: absolute;
    z-index: 3;
    top: 12px;
    left: 12px;
    padding: 6px 10px;
    border-radius: 100px;
    background: #5e2734;
    color: #fff;
    font-size: 12px;
    line-height: 1.2;
    pointer-events: none;
  }
  @media screen and (max-width: 749px) {
    .ai-best-sellers-{{ ai_gen_id }} { padding: 24px 0; }
    .ai-best-sellers-{{ ai_gen_id }}__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px 10px; }
    .ai-best-sellers-{{ ai_gen_id }}__heading { font-size: 26px; }
    .ai-best-sellers-{{ ai_gen_id }}__link { min-height: 40px; padding: 0 16px; }
  }
{% endstyle %}
{% if block.settings.show_section %}
  <section class="ai-best-sellers-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <div class="ai-best-sellers-{{ ai_gen_id }}__inner">
      <div class="ai-best-sellers-{{ ai_gen_id }}__header">
        <h2 class="ai-best-sellers-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
        <a class="ai-best-sellers-{{ ai_gen_id }}__link" href="{{ block.settings.button_link | default: all_products_collection.url }}">{{ block.settings.button_label | escape }}</a>
      </div>
      <div class="ai-best-sellers-{{ ai_gen_id }}__grid">
        {% assign best_selling_products = all_products_collection.products | sort: 'best-selling' %}
        {% for product in best_selling_products limit: 4 %}
          <div class="ai-best-sellers-{{ ai_gen_id }}__item">
            {% for tag in product.tags %}
              {% assign tag_lower = tag | downcase %}
              {% if tag_lower == 'new' or tag_lower == 'best seller' %}
                <span class="ai-best-sellers-{{ ai_gen_id }}__badge">{{ tag | escape }}</span>
                {% break %}
              {% endif %}
            {% endfor %}
            {% render 'product-card', product: product %}
          </div>
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}
{% schema %}
{
  "name": "Best sellers grid",
  "settings": [
    { "type": "checkbox", "id": "show_section", "label": "Show this section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best sellers" },
    { "type": "text", "id": "button_label", "label": "Button", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 }
  ],
  "presets": [{ "name": "Best sellers grid" }],
  "tag": null,
  "class": "best-sellers-grid"
}
{% endschema %}