{% doc %}
  @prompt
    generate a full page width section in which right side an image when some featured cards in that image as glassmorphic style to show features of that cloth and in left section an eyebrow, title, subheading and context and CTA to redirect on product page., add CTA as well to redirect on product page. also allow me to change the size, position of each feature card, allow me to change size of each and every text in this section also don't overflow any element out of this section and also allow me to change image height and width, also add one more small image overlapping this current image at bottom left corner and tilt a bit, allow me change the position up and down of this overlay image and also add border , add CTA just below description, also add border and border color on main image, make rich text entire section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-showcase-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding }}px 0;
    overflow: hidden;
  }

  .ai-feature-showcase-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    align-items: center;
  }

  .ai-feature-showcase-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-feature-showcase-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 600;
    margin: 0;
  }

  .ai-feature-showcase-eyebrow-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-feature-showcase-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0;
    line-height: 1.2;
  }

  .ai-feature-showcase-title-{{ ai_gen_id }} p,
  .ai-feature-showcase-title-{{ ai_gen_id }} h1,
  .ai-feature-showcase-title-{{ ai_gen_id }} h2,
  .ai-feature-showcase-title-{{ ai_gen_id }} h3 {
    margin: 0;
    font-size: inherit;
    color: inherit;
    line-height: inherit;
  }

  .ai-feature-showcase-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    font-weight: 500;
  }

  .ai-feature-showcase-subheading-{{ ai_gen_id }} p,
  .ai-feature-showcase-subheading-{{ ai_gen_id }} h1,
  .ai-feature-showcase-subheading-{{ ai_gen_id }} h2,
  .ai-feature-showcase-subheading-{{ ai_gen_id }} h3 {
    margin: 0;
    font-size: inherit;
    color: inherit;
    font-weight: inherit;
  }

  .ai-feature-showcase-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
    margin: 0;
  }

  .ai-feature-showcase-description-{{ ai_gen_id }} p {
    margin: 0 0 12px 0;
  }

  .ai-feature-showcase-description-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-feature-showcase-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 32px;
    background-color: {{ block.settings.cta_background }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-size: {{ block.settings.cta_font_size }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    width: fit-content;
  }

  .ai-feature-showcase-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_background }};
    transform: translateY(-2px);
  }

  .ai-feature-showcase-image-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    height: {{ block.settings.image_height }}px;
    overflow: visible;
  }

  .ai-feature-showcase-image-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
    {% if block.settings.image_border_width > 0 %}
      border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    {% endif %}
  }

  .ai-feature-showcase-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    {% if block.settings.image_border_width > 0 %}
      border: {{ block.settings.image_border_width }}px solid {{ block.settings.image_border_color }};
    {% endif %}
  }

  .ai-feature-showcase-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 300px;
    max-height: 300px;
  }

  .ai-feature-showcase-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-feature-showcase-overlay-image-{{ ai_gen_id }} {
    position: absolute;
    {% if block.settings.overlay_image_position == 'top' %}
      top: {{ block.settings.overlay_image_offset }}px;
    {% else %}
      bottom: {{ block.settings.overlay_image_offset }}px;
    {% endif %}
    left: {{ block.settings.overlay_image_left }}px;
    width: {{ block.settings.overlay_image_width }}px;
    height: {{ block.settings.overlay_image_height }}px;
    transform: rotate({{ block.settings.overlay_image_rotation }}deg);
    border-radius: {{ block.settings.overlay_image_border_radius }}px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    z-index: 2;
    overflow: hidden;
    {% if block.settings.overlay_image_border_width > 0 %}
      border: {{ block.settings.overlay_image_border_width }}px solid {{ block.settings.overlay_image_border_color }};
    {% endif %}
  }

  .ai-feature-showcase-overlay-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-feature-showcase-overlay-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e8e8e8;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-showcase-overlay-image-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-feature-card-{{ ai_gen_id }} {
    position: absolute;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 20px;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1);
    max-width: 90%;
    z-index: 1;
  }

  .ai-feature-card-title-{{ ai_gen_id }} {
    font-weight: 600;
    color: {{ block.settings.card_text_color }};
    margin: 0 0 8px 0;
    word-wrap: break-word;
  }

  .ai-feature-card-description-{{ ai_gen_id }} {
    color: {{ block.settings.card_text_color }};
    line-height: 1.4;
    margin: 0 0 12px 0;
    word-wrap: break-word;
  }

  .ai-feature-card-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 8px 16px;
    background-color: {{ block.settings.card_cta_background }};
    color: {{ block.settings.card_cta_text_color }};
