    border-radius: {{ block.settings.card_cta_border_radius }}px;
    font-weight: 600;
    transition: all 0.3s ease;
    word-wrap: break-word;
  }

  .ai-feature-card-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.card_cta_hover_background }};
    transform: translateY(-1px);
  }

  .ai-feature-card-{{ ai_gen_id }}-1 {
    top: {{ block.settings.card_1_y }}%;
    left: {{ block.settings.card_1_x }}%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.card_1_width }}px;
  }

  .ai-feature-card-{{ ai_gen_id }}-1 .ai-feature-card-title-{{ ai_gen_id }} {
