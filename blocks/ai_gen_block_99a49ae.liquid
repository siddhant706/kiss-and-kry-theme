<feature-showcase-{{ ai_gen_id }} class="ai-feature-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-showcase-container-{{ ai_gen_id }}">
    <div class="ai-feature-showcase-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-feature-showcase-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.title != blank %}
        <div class="ai-feature-showcase-title-{{ ai_gen_id }}">{{ block.settings.title }}</div>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-feature-showcase-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.description != blank %}
        <div class="ai-feature-showcase-description-{{ ai_gen_id }}">
          {{ block.settings.description }}
        </div>
      {% endif %}

      {% if block.settings.cta_text != blank and block.settings.cta_link != blank %}
        <a href="{{ block.settings.cta_link }}" class="ai-feature-showcase-cta-{{ ai_gen_id }}">
          {{ block.settings.cta_text }}
        </a>
      {% endif %}
    </div>

    <div class="ai-feature-showcase-image-section-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          loading="lazy"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          class="ai-feature-showcase-image-{{ ai_gen_id }}"
        >
      {% else %}
        <div class="ai-feature-showcase-image-placeholder-{{ ai_gen_id }}">
          {{ 'hero-apparel-1' | placeholder_svg_tag }}
          <div class="ai-feature-showcase-empty-state-{{ ai_gen_id }}">
            Add an image to showcase your product
          </div>
        </div>
      {% endif %}

      {% if block.settings.show_overlay_image %}
        <div class="ai-feature-showcase-overlay-image-{{ ai_gen_id }}">
          {% if block.settings.overlay_image %}
            <img
              src="{{ block.settings.overlay_image | image_url: width: 600 }}"
              alt="{{ block.settings.overlay_image.alt | escape }}"
              loading="lazy"
              width="{{ block.settings.overlay_image.width }}"
              height="{{ block.settings.overlay_image.height }}"
            >
          {% else %}
            <div class="ai-feature-showcase-overlay-image-placeholder-{{ ai_gen_id }}">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_1_enabled %}
        <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}-1">
          {% if block.settings.card_1_title != blank %}
            <h4 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_1_title }}</h4>
          {% endif %}
          {% if block.settings.card_1_description != blank %}
            <p class="ai-feature-card-description-{{ ai_gen_id }}">{{ block.settings.card_1_description }}</p>
          {% endif %}
          {% if block.settings.card_1_cta_text != blank and block.settings.card_1_cta_link != blank %}
            <a href="{{ block.settings.card_1_cta_link }}" class="ai-feature-card-cta-{{ ai_gen_id }}">
              {{ block.settings.card_1_cta_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_2_enabled %}
        <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}-2">
          {% if block.settings.card_2_title != blank %}
            <h4 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_2_title }}</h4>
          {% endif %}
          {% if block.settings.card_2_description != blank %}
            <p class="ai-feature-card-description-{{ ai_gen_id }}">{{ block.settings.card_2_description }}</p>
          {% endif %}
          {% if block.settings.card_2_cta_text != blank and block.settings.card_2_cta_link != blank %}
            <a href="{{ block.settings.card_2_cta_link }}" class="ai-feature-card-cta-{{ ai_gen_id }}">
              {{ block.settings.card_2_cta_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}

      {% if block.settings.card_3_enabled %}
        <div class="ai-feature-card-{{ ai_gen_id }} ai-feature-card-{{ ai_gen_id }}-3">
          {% if block.settings.card_3_title != blank %}
            <h4 class="ai-feature-card-title-{{ ai_gen_id }}">{{ block.settings.card_3_title }}</h4>
          {% endif %}
          {% if block.settings.card_3_description != blank %}
            <p class="ai-feature-card-description-{{ ai_gen_id }}">{{ block.settings.card_3_description }}</p>
          {% endif %}
          {% if block.settings.card_3_cta_text != blank and block.settings.card_3_cta_link != blank %}
            <a href="{{ block.settings.card_3_cta_link }}" class="ai-feature-card-cta-{{ ai_gen_id }}">
              {{ block.settings.card_3_cta_text }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</feature-showcase-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureShowcase{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupObserver();
      }

      setupObserver() {
        const cards = this.querySelectorAll('.ai-feature-card-{{ ai_gen_id }}');
        const overlayImage = this.querySelector('.ai-feature-showcase-overlay-image-{{ ai_gen_id }}');
        
        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.style.opacity = '1';
                entry.target.style.transform = entry.target.style.transform.replace('scale(0.9)', 'scale(1)');
              }
            });
          }, {
            threshold: 0.1
          });

          cards.forEach((card) => {
            card.style.opacity = '0';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            const currentTransform = card.style.transform || '';
            card.style.transform = currentTransform + ' scale(0.9)';
            observer.observe(card);
          });

          if (overlayImage) {
            overlayImage.style.opacity = '0';
            overlayImage.style.transition = 'opacity 0.8s ease 0.3s, transform 0.8s ease 0.3s';
            observer.observe(overlayImage);
          }
        }
      }
    }

    customElements.define('feature-showcase-{{ ai_gen_id }}', FeatureShowcase{{ ai_gen_id }});
  })();
</script>

