    left: {{ block.settings.card_2_x }}%;
    transform: translate(-50%, -50%);
    width: {{ block.settings.card_2_width }}px;
  }

  .ai-feature-card-{{ ai_gen_id }}-2 .ai-feature-card-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_2_title_size }}px;
