  }

  .ai-feature-card-{{ ai_gen_id }}-1 .ai-feature-card-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_1_description_size }}px;
  }

  .ai-feature-card-{{ ai_gen_id }}-1 .ai-feature-card-cta-{{ ai_gen_id }} {
    font-size: {{ block.settings.card_1_cta_size }}px;
  }

