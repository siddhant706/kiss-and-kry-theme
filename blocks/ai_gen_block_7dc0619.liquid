{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glass-hero-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
  }

  .ai-glass-hero__bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-glass-hero__bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-glass-hero__bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  }

  .ai-glass-hero__bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-glass-hero__overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-glass-hero__container-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px {{ block.settings.section_padding_horizontal }}px {{ block.settings.section_padding_bottom }}px;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    min-height: {{ block.settings.section_height }}px;
    gap: {{ block.settings.columns_gap }}px;
  }

  .ai-glass-hero__left-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.elements_spacing }}px;
  }

  .ai-glass-hero__right-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.event_card_width }}px;
  }

  .ai-glass-hero__eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-size: {{ block.settings.eyebrow_font_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: {{ block.settings.eyebrow_text_transform }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    margin: {{ block.settings.eyebrow_margin_top }}px 0 {{ block.settings.eyebrow_margin_bottom }}px 0;
  }

  .ai-glass-hero__title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_font_size }}px;
    color: {{ block.settings.title_color }};
    line-height: {{ block.settings.title_line_height }};
    margin: {{ block.settings.title_margin_top }}px 0 {{ block.settings.title_margin_bottom }}px 0;
  }

  .ai-glass-hero__subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_font_size }}px;
    color: {{ block.settings.subheading_color }};
    line-height: {{ block.settings.subheading_line_height }};
    margin: {{ block.settings.subheading_margin_top }}px 0 {{ block.settings.subheading_margin_bottom }}px 0;
  }

  .ai-glass-hero__context-{{ ai_gen_id }} {
    font-family: {{ block.settings.context_font.family }}, {{ block.settings.context_font.fallback_families }};
    font-weight: {{ block.settings.context_font.weight }};
    font-size: {{ block.settings.context_font_size }}px;
    color: {{ block.settings.context_color }};
    line-height: {{ block.settings.context_line_height }};
    margin: {{ block.settings.context_margin_top }}px 0 {{ block.settings.context_margin_bottom }}px 0;
  }

  .ai-glass-hero__cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background: {{ block.settings.cta_bg_color }};
    backdrop-filter: blur({{ block.settings.cta_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.cta_blur }}px);
    color: {{ block.settings.cta_text_color }};
    font-family: {{ block.settings.cta_font.family }}, {{ block.settings.cta_font.fallback_families }};
    font-weight: {{ block.settings.cta_font.weight }};
    font-size: {{ block.settings.cta_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    border: {{ block.settings.cta_border_width }}px solid {{ block.settings.cta_border_color }};
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
    align-self: flex-start;
    margin: {{ block.settings.cta_margin_top }}px 0 {{ block.settings.cta_margin_bottom }}px 0;
  }

  .ai-glass-hero__cta-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.cta_border_radius }}px;
    padding: 2px;
    background: linear-gradient(45deg, transparent, {{ block.settings.cta_glow_color }}, transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-glass-hero__cta-{{ ai_gen_id }}:hover::before {
    opacity: 1;
  }

  .ai-glass-hero__cta-{{ ai_gen_id }}:hover {
    background: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.2);
  }

  .ai-glass-hero__trust-indicators-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.trust_columns }}, 1fr);
    gap: {{ block.settings.trust_gap }}px;
    margin: {{ block.settings.trust_margin_top }}px 0 {{ block.settings.trust_margin_bottom }}px 0;
  }

  .ai-glass-hero__trust-item-{{ ai_gen_id }} {
    background: {{ block.settings.trust_bg_color }};
    backdrop-filter: blur({{ block.settings.trust_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.trust_blur }}px);
    border: {{ block.settings.trust_border_width }}px solid {{ block.settings.trust_border_color }};
    border-radius: {{ block.settings.trust_border_radius }}px;
    padding: {{ block.settings.trust_padding_vertical }}px {{ block.settings.trust_padding_horizontal }}px;
    display: flex;
    align-items: center;
    gap: {{ block.settings.trust_icon_gap }}px;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }

  .ai-glass-hero__trust-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.trust_border_radius }}px;
    padding: 2px;
    background: linear-gradient(45deg, transparent, {{ block.settings.trust_glow_color }}, transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-glass-hero__trust-item-{{ ai_gen_id }}:hover::before {
    opacity: 1;
  }

  .ai-glass-hero__trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.trust_icon_size }}px;
    height: {{ block.settings.trust_icon_size }}px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-glass-hero__trust-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-glass-hero__trust-icon-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    color: {{ block.settings.trust_icon_color }};
  }

  .ai-glass-hero__trust-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.trust_font.family }}, {{ block.settings.trust_font.fallback_families }};
    font-weight: {{ block.settings.trust_font.weight }};
    font-size: {{ block.settings.trust_font_size }}px;
    color: {{ block.settings.trust_text_color }};
    margin: 0;
  }

  .ai-glass-hero__event-card-{{ ai_gen_id }} {
    background: {{ block.settings.trust_bg_color }};
    backdrop-filter: blur({{ block.settings.trust_blur }}px);
    -webkit-backdrop-filter: blur({{ block.settings.trust_blur }}px);
    border: {{ block.settings.trust_border_width }}px solid transparent;
    border-radius: {{ block.settings.trust_border_radius }}px;
    padding: {{ block.settings.event_card_padding }}px;
    position: relative;
    overflow: visible;
  }

  .ai-glass-hero__event-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: -{{ block.settings.trust_border_width }}px;
    left: -{{ block.settings.trust_border_width }}px;
    right: -{{ block.settings.trust_border_width }}px;
    bottom: -{{ block.settings.trust_border_width }}px;
    background: linear-gradient(45deg, {{ block.settings.event_pulse_color_1 }}, {{ block.settings.event_pulse_color_2 }}, {{ block.settings.event_pulse_color_1 }});
    border-radius: {{ block.settings.trust_border_radius }}px;
    z-index: -1;
    animation: ai-glass-hero-pulse-{{ ai_gen_id }} 3s ease-in-out infinite;
    background-size: 200% 200%;
  }

  @keyframes ai-glass-hero-pulse-{{ ai_gen_id }} {
    0%, 100% {
      opacity: 0.6;
      background-position: 0% 50%;
    }
    50% {
      opacity: 1;
      background-position: 100% 50%;
    }
  }

  .ai-glass-hero__event-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.event_items_gap }}px;
  }

  .ai-glass-hero__event-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.event_font.family }}, {{ block.settings.event_font.fallback_families }};
    font-weight: {{ block.settings.event_font.weight }};
    font-size: {{ block.settings.event_title_font_size }}px;
    color: {{ block.settings.event_text_color }};
    margin: {{ block.settings.event_title_margin_top }}px 0 {{ block.settings.event_title_margin_bottom }}px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .ai-glass-hero__event-label-{{ ai_gen_id }} {
    font-family: {{ block.settings.event_font.family }}, {{ block.settings.event_font.fallback_families }};
    font-weight: {{ block.settings.event_font.weight }};
    font-size: {{ block.settings.event_label_font_size }}px;
    color: {{ block.settings.event_text_color }};
    margin: {{ block.settings.event_label_margin_top }}px 0 {{ block.settings.event_label_margin_bottom }}px 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.7;
  }

  .ai-glass-hero__event-value-{{ ai_gen_id }} {
    font-family: {{ block.settings.event_font.family }}, {{ block.settings.event_font.fallback_families }};
    font-weight: {{ block.settings.event_font.weight }};
    font-size: {{ block.settings.event_font_size }}px;
    color: {{ block.settings.event_text_color }};
    margin: {{ block.settings.event_value_margin_top }}px 0 {{ block.settings.event_value_margin_bottom }}px 0;
  }

  @media screen and (max-width: 749px) {
    .ai-glass-hero__container-{{ ai_gen_id }} {
      flex-direction: column;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-glass-hero__right-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-glass-hero__trust-indicators-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.trust_columns_mobile }}, 1fr);
    }

    .ai-glass-hero__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.7 }}px;
    }

    .ai-glass-hero__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<glass-hero-{{ ai_gen_id }} class="ai-glass-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-glass-hero__bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-glass-hero__bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-glass-hero__overlay-{{ ai_gen_id }}"></div>

  <div class="ai-glass-hero__container-{{ ai_gen_id }}">
    <div class="ai-glass-hero__left-{{ ai_gen_id }}">
      {% if block.settings.eyebrow_text != blank %}
        <div class="ai-glass-hero__eyebrow-{{ ai_gen_id }}">
          {{ block.settings.eyebrow_text }}
        </div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h1 class="ai-glass-hero__title-{{ ai_gen_id }}">
          {{ block.settings.title }}
        </h1>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-glass-hero__subheading-{{ ai_gen_id }}">
          {{ block.settings.subheading }}
        </div>
      {% endif %}

      {% if block.settings.context != blank %}
        <div class="ai-glass-hero__context-{{ ai_gen_id }}">
          {{ block.settings.context }}
        </div>
      {% endif %}

      {% if block.settings.cta_text != blank %}
        <a
          href="{{ block.settings.cta_link }}"
          class="ai-glass-hero__cta-{{ ai_gen_id }}"
        >
          {{ block.settings.cta_text }}
        </a>
      {% endif %}

      <div class="ai-glass-hero__trust-indicators-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign trust_text_key = 'trust_' | append: i | append: '_text'
            assign trust_icon_key = 'trust_' | append: i | append: '_icon'
            assign trust_text = block.settings[trust_text_key]
            assign trust_icon = block.settings[trust_icon_key]
          %}

          {% if trust_text != blank %}
            <div class="ai-glass-hero__trust-item-{{ ai_gen_id }}">
              <div class="ai-glass-hero__trust-icon-{{ ai_gen_id }}">
                {% if trust_icon %}
                  <img
                    src="{{ trust_icon | image_url: width: 100 }}"
                    alt=""
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                  </svg>
                {% endif %}
              </div>
              <div class="ai-glass-hero__trust-text-{{ ai_gen_id }}">
                {{ trust_text }}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-glass-hero__right-{{ ai_gen_id }}">
      <div class="ai-glass-hero__event-card-{{ ai_gen_id }}">
        <div class="ai-glass-hero__event-content-{{ ai_gen_id }}">
          {% if block.settings.event_title != blank %}
            <div class="ai-glass-hero__event-title-{{ ai_gen_id }}">
              {{ block.settings.event_title }}
            </div>
          {% endif %}

          {% if block.settings.event_name != blank %}
            <div>
              <div class="ai-glass-hero__event-label-{{ ai_gen_id }}">Event</div>
              <div class="ai-glass-hero__event-value-{{ ai_gen_id }}">{{ block.settings.event_name }}</div>
            </div>
          {% endif %}

          {% if block.settings.event_date != blank %}
            <div>
              <div class="ai-glass-hero__event-label-{{ ai_gen_id }}">Date</div>
              <div class="ai-glass-hero__event-value-{{ ai_gen_id }}">{{ block.settings.event_date }}</div>
            </div>
          {% endif %}

          {% if block.settings.event_location != blank %}
            <div>
              <div class="ai-glass-hero__event-label-{{ ai_gen_id }}">Location</div>
              <div class="ai-glass-hero__event-value-{{ ai_gen_id }}">{{ block.settings.event_location }}</div>
            </div>
          {% endif %}

          {% if block.settings.event_stall != blank %}
            <div>
              <div class="ai-glass-hero__event-label-{{ ai_gen_id }}">Stall</div>
              <div class="ai-glass-hero__event-value-{{ ai_gen_id }}">{{ block.settings.event_stall }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</glass-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class GlassHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupParallax();
      }

      setupParallax() {
        const bg = this.querySelector('.ai-glass-hero__bg-{{ ai_gen_id }}');
        if (!bg) return;

        window.addEventListener('scroll', () => {
          const scrolled = window.pageYOffset;
          const rate = scrolled * 0.5;
          bg.style.transform = `translate3d(0, ${rate}px, 0)`;
        });
      }
    }

    customElements.define('glass-hero-{{ ai_gen_id }}', GlassHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
