{% doc %}
  @prompt
    generate a full page width cover sized hero section with full size background image and all the text as eyebrow, heading, context on left top , align all the text in equal side spacing from left perfectly aligned to each other in verticle order, make all the font as montserrate and allow me to change as rich text , now on bottom left add three trust indicators in circle frame with a circular stroke and , the trust indicators should be in PNG only and also allow me change all the texts size as well, image for indicators are not appearing, circular strokee should be thick allow me change thickness as well, heading size should be increase if I increase, increase heading size by 40% more, add a indicator name tag just below each indicator in small size bold, indicator circular strokes should be in glassmorphic style, I want heading as 
    Softer Days (Bold)
    for a Brighter (Not bold)
    Tomorrow (Not bold), for a brighter tomorrow should be less thick by 30% more, Born From Bamboo.
    Made For Baby.
    
    I want heading this bamboo and baby should be extra bold only rest will be medium , bro i want as it aligned as all in two lines only as 
    Born From Bamboo.
    Made For Baby., just below the heading add a subheading as Ultra soft. Naturally breathable., subheaing should be same thick as context but a bit of big size to look different from context, now on right bottom add a subheading of different weights as line one normal and line two bold then a context below of 3 lines then a CTA button, allow me to change all the text colors in this section , now manager the background image opacity or layer on it so that every text is visible clearly , adjust the background image visibility so that one can all the text on this section clearly, make the button colored glassmorphic style
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-cover-{{ ai_gen_id }}{position:relative;display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;min-height:{{ block.settings.hero_height }}px;overflow:hidden;background:{{ block.settings.fallback_color }};font-family:Montserrat,var(--font-body-family,sans-serif)}
.ai-cover-{{ ai_gen_id }}__image,.ai-cover-{{ ai_gen_id }}__placeholder,.ai-cover-{{ ai_gen_id }}__shade{position:absolute;inset:0;width:100%;height:100%}.ai-cover-{{ ai_gen_id }}__image{object-fit:cover;object-position:{{ block.settings.image_position }}}.ai-cover-{{ ai_gen_id }}__placeholder{background:#e9e9e5}.ai-cover-{{ ai_gen_id }}__placeholder svg{width:100%;height:100%;object-fit:cover}.ai-cover-{{ ai_gen_id }}__shade{z-index:1;background:{{ block.settings.overlay_color | color_modify: 'alpha', block.settings.overlay_opacity | divided_by: 100.0 }}}
.ai-cover-{{ ai_gen_id }}__left{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;box-sizing:border-box;width:min(100%,{{ block.settings.content_width }}px);padding:{{ block.settings.content_padding }}px}.ai-cover-{{ ai_gen_id }}__eyebrow,.ai-cover-{{ ai_gen_id }}__heading,.ai-cover-{{ ai_gen_id }}__subheading,.ai-cover-{{ ai_gen_id }}__context,.ai-cover-{{ ai_gen_id }}__right-title,.ai-cover-{{ ai_gen_id }}__right-copy{margin:0;font-family:Montserrat,var(--font-body-family,sans-serif);text-align:left}.ai-cover-{{ ai_gen_id }}__eyebrow{margin-bottom:14px;color:{{ block.settings.eyebrow_color }};font-size:{{ block.settings.eyebrow_size }}px;font-weight:600;letter-spacing:.12em;text-transform:uppercase}.ai-cover-{{ ai_gen_id }}__heading{width:max-content;max-width:none;color:{{ block.settings.heading_color }};font-size:{{ block.settings.heading_size | times:1.4 }}px;line-height:1.05;font-weight:500}.ai-cover-{{ ai_gen_id }}__heading strong{font-weight:800}.ai-cover-{{ ai_gen_id }}__subheading{margin-top:14px;color:{{ block.settings.subheading_color }};font-size:{{ block.settings.context_size | plus:4 }}px;line-height:1.5;font-weight:400}.ai-cover-{{ ai_gen_id }}__context{max-width:48ch;margin-top:18px;color:{{ block.settings.context_color }};font-size:{{ block.settings.context_size }}px;line-height:1.6;font-weight:400}.ai-cover-{{ ai_gen_id }}__left p,.ai-cover-{{ ai_gen_id }}__left h2{margin:0}
.ai-cover-{{ ai_gen_id }}__trust{position:absolute;z-index:3;left:{{ block.settings.content_padding }}px;bottom:{{ block.settings.content_padding }}px;display:flex;gap:14px;align-items:flex-start;max-width:50%}.ai-cover-{{ ai_gen_id }}__trust-card{display:flex;flex-direction:column;align-items:center;gap:7px}.ai-cover-{{ ai_gen_id }}__circle{box-sizing:border-box;display:grid;place-items:center;width:{{ block.settings.trust_circle_size }}px;height:{{ block.settings.trust_circle_size }}px;padding:6px;border:{{ block.settings.trust_stroke_width }}px solid {{ block.settings.trust_stroke_color }};border-radius:50%;background:rgba(255,255,255,.14);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:inset 0 1px 1px rgba(255,255,255,.35),0 4px 16px rgba(0,0,0,.12);overflow:hidden}.ai-cover-{{ ai_gen_id }}__circle img{width:100%;height:100%;object-fit:contain;border-radius:50%}.ai-cover-{{ ai_gen_id }}__label{max-width:{{ block.settings.trust_circle_size | plus:24 }}px;color:{{ block.settings.trust_label_color }};font-size:{{ block.settings.trust_label_size }}px;font-weight:700;line-height:1.25;text-align:center}
.ai-cover-{{ ai_gen_id }}__right{position:absolute;z-index:3;right:{{ block.settings.content_padding }}px;bottom:{{ block.settings.content_padding }}px;box-sizing:border-box;width:min(42%,{{ block.settings.right_content_width }}px);display:flex;flex-direction:column;align-items:flex-start}.ai-cover-{{ ai_gen_id }}__right-title{margin-bottom:12px;color:{{ block.settings.right_heading_color }};font-size:{{ block.settings.right_heading_size }}px;line-height:1.35;font-weight:400}.ai-cover-{{ ai_gen_id }}__right-title strong{font-weight:700}.ai-cover-{{ ai_gen_id }}__right-copy{margin-bottom:22px;color:{{ block.settings.right_context_color }};font-size:{{ block.settings.right_context_size }}px;line-height:1.55}.ai-cover-{{ ai_gen_id }}__right p{margin:0}.ai-cover-{{ ai_gen_id }}__button{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 24px;border:1px solid {{ block.settings.button_border_color | color_modify: 'alpha', 0.8 }};border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_background | color_modify: 'alpha', 0.42 }};backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);box-shadow:inset 0 1px 1px rgba(255,255,255,.45),0 6px 18px rgba(0,0,0,.16);color:{{ block.settings.button_text_color }};font-size:16px;font-weight:600;text-decoration:none;transition:background-color .2s ease,transform .2s ease}.ai-cover-{{ ai_gen_id }}__button:hover{background:{{ block.settings.button_background | color_modify: 'alpha', 0.62 }};transform:translateY(-1px)}.ai-cover-{{ ai_gen_id }}__button:focus-visible{outline:3px solid currentColor;outline-offset:3px}
@media(max-width:749px){.ai-cover-{{ ai_gen_id }}{min-height:{{ block.settings.mobile_height }}px}.ai-cover-{{ ai_gen_id }}__left{padding:28px}.ai-cover-{{ ai_gen_id }}__heading{font-size:{{ block.settings.heading_size | times:1.05 }}px}.ai-cover-{{ ai_gen_id }}__trust{left:20px;bottom:20px;gap:8px;max-width:50%}.ai-cover-{{ ai_gen_id }}__circle{width:{{ block.settings.trust_circle_size | times:0.8 }}px;height:{{ block.settings.trust_circle_size | times:0.8 }}px}.ai-cover-{{ ai_gen_id }}__right{right:18px;bottom:20px;width:44%}.ai-cover-{{ ai_gen_id }}__right-title{font-size:{{ block.settings.right_heading_size | times:0.8 }}px}.ai-cover-{{ ai_gen_id }}__right-copy{font-size:{{ block.settings.right_context_size | times:0.9 }}px}.ai-cover-{{ ai_gen_id }}__button{min-height:42px;padding:10px 16px;font-size:14px}}
{% endstyle %}
<section class="ai-cover-{{ ai_gen_id }}" style="width:{{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
{% if block.settings.background_image != blank %}<img class="ai-cover-{{ ai_gen_id }}__image" src="{{ block.settings.background_image | image_url: width:2400 }}" alt="{{ block.settings.background_image.alt | escape }}" width="{{ block.settings.background_image.width }}" height="{{ block.settings.background_image.height }}" loading="lazy">{% else %}<div class="ai-cover-{{ ai_gen_id }}__placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<div class="ai-cover-{{ ai_gen_id }}__shade" aria-hidden="true"></div>
<div class="ai-cover-{{ ai_gen_id }}__left">{% if block.settings.eyebrow != blank %}<div class="ai-cover-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>{% endif %}{% if block.settings.heading != blank %}<div class="ai-cover-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>{% endif %}{% if block.settings.subheading != blank %}<div class="ai-cover-{{ ai_gen_id }}__subheading">{{ block.settings.subheading }}</div>{% endif %}{% if block.settings.context != blank %}<div class="ai-cover-{{ ai_gen_id }}__context">{{ block.settings.context }}</div>{% endif %}</div>
{% assign trust_one = block.settings.trust_image_one %}{% assign trust_two = block.settings.trust_image_two %}{% assign trust_three = block.settings.trust_image_three %}{% if trust_one != blank or trust_two != blank or trust_three != blank %}<div class="ai-cover-{{ ai_gen_id }}__trust" role="group" aria-label="Trust indicators">{% if trust_one != blank %}<div class="ai-cover-{{ ai_gen_id }}__trust-card"><div class="ai-cover-{{ ai_gen_id }}__circle"><img src="{{ trust_one | image_url: width:300 }}" alt="{{ trust_one.alt | escape }}" width="{{ trust_one.width }}" height="{{ trust_one.height }}" loading="lazy"></div><span class="ai-cover-{{ ai_gen_id }}__label">{{ block.settings.trust_label_one | escape }}</span></div>{% endif %}{% if trust_two != blank %}<div class="ai-cover-{{ ai_gen_id }}__trust-card"><div class="ai-cover-{{ ai_gen_id }}__circle"><img src="{{ trust_two | image_url: width:300 }}" alt="{{ trust_two.alt | escape }}" width="{{ trust_two.width }}" height="{{ trust_two.height }}" loading="lazy"></div><span class="ai-cover-{{ ai_gen_id }}__label">{{ block.settings.trust_label_two | escape }}</span></div>{% endif %}{% if trust_three != blank %}<div class="ai-cover-{{ ai_gen_id }}__trust-card"><div class="ai-cover-{{ ai_gen_id }}__circle"><img src="{{ trust_three | image_url: width:300 }}" alt="{{ trust_three.alt | escape }}" width="{{ trust_three.width }}" height="{{ trust_three.height }}" loading="lazy"></div><span class="ai-cover-{{ ai_gen_id }}__label">{{ block.settings.trust_label_three | escape }}</span></div>{% endif %}</div>{% endif %}
<div class="ai-cover-{{ ai_gen_id }}__right">{% if block.settings.right_heading != blank %}<div class="ai-cover-{{ ai_gen_id }}__right-title">{{ block.settings.right_heading }}</div>{% endif %}{% if block.settings.right_context != blank %}<div class="ai-cover-{{ ai_gen_id }}__right-copy">{{ block.settings.right_context }}</div>{% endif %}{% if block.settings.cta_label != blank %}<a class="ai-cover-{{ ai_gen_id }}__button" href="{{ block.settings.cta_link | default: routes.all_products_collection_url }}">{{ block.settings.cta_label | escape }}</a>{% endif %}</div>
</section>
{% schema %}
{"name":"Cover hero","settings":[{"type":"image_picker","id":"background_image","label":"Background image"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"hero_height","label":"Desktop height","min":400,"max":900,"step":50,"unit":"px","default":700},{"type":"range","id":"mobile_height","label":"Mobile height","min":300,"max":700,"step":50,"unit":"px","default":500},{"type":"select","id":"image_position","label":"Image focal point","options":[{"value":"center center","label":"Center"},{"value":"left center","label":"Left"},{"value":"right center","label":"Right"},{"value":"center top","label":"Top"},{"value":"center bottom","label":"Bottom"}],"default":"center center"},{"type":"richtext","id":"eyebrow","label":"Eyebrow","default":"<p>A thoughtful collection</p>"},{"type":"richtext","id":"heading","label":"Heading","default":"<h2>Born From <strong>Bamboo.</strong><br>Made For <strong>Baby.</strong></h2>"},{"type":"richtext","id":"subheading","label":"Subheading","default":"<p>Ultra soft. Naturally breathable.</p>"},{"type":"richtext","id":"context","label":"Context","default":"<p>Discover considered essentials, made to bring a little more meaning to every day.</p>"},{"type":"range","id":"eyebrow_size","label":"Eyebrow text size","min":10,"max":30,"step":2,"unit":"px","default":14},{"type":"range","id":"heading_size","label":"Heading text size","min":40,"max":88,"step":4,"unit":"px","default":64},{"type":"range","id":"context_size","label":"Context text size","min":12,"max":30,"step":2,"unit":"px","default":16},{"type":"range","id":"content_width","label":"Text width","min":320,"max":800,"step":40,"unit":"px","default":560},{"type":"range","id":"content_padding","label":"Content inset","min":24,"max":120,"step":8,"unit":"px","default":64},{"type":"color","id":"overlay_color","label":"Overlay color","default":"#000000"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":90,"step":5,"unit":"%","default":65},{"type":"color","id":"fallback_color","label":"Fallback background","default":"#5E6539"},{"type":"color","id":"eyebrow_color","label":"Eyebrow color","default":"#FFFFFF"},{"type":"color","id":"heading_color","label":"Heading color","default":"#FFFFFF"},{"type":"color","id":"subheading_color","label":"Subheading color","default":"#FFFFFF"},{"type":"color","id":"context_color","label":"Context color","default":"#FFFFFF"},{"type":"header","content":"Right-side content"},{"type":"richtext","id":"right_heading","label":"Two-line subheading","default":"<p>Thoughtfully made.<br><strong>For everyday comfort.</strong></p>"},{"type":"richtext","id":"right_context","label":"Supporting text","default":"<p>Soft essentials for little ones.<br>Made with care and comfort<br>for every day.</p>"},{"type":"range","id":"right_heading_size","label":"Subheading size","min":16,"max":40,"step":2,"unit":"px","default":24},{"type":"range","id":"right_context_size","label":"Supporting text size","min":12,"max":24,"step":2,"unit":"px","default":16},{"type":"range","id":"right_content_width","label":"Right content width","min":240,"max":600,"step":30,"unit":"px","default":420},{"type":"color","id":"right_heading_color","label":"Subheading color","default":"#FFFFFF"},{"type":"color","id":"right_context_color","label":"Supporting text color","default":"#FFFFFF"},{"type":"text","id":"cta_label","label":"Button label","default":"Shop the collection"},{"type":"url","id":"cta_link","label":"Button link"},{"type":"color","id":"button_background","label":"Button background","default":"#A9B883"},{"type":"color","id":"button_text_color","label":"Button text","default":"#17200F"},{"type":"color","id":"button_border_color","label":"Button border","default":"#FFFFFF"},{"type":"range","id":"button_radius","label":"Button corner radius","min":0,"max":30,"step":2,"unit":"px","default":4},{"type":"header","content":"Trust indicators"},{"type":"image_picker","id":"trust_image_one","label":"Trust image one"},{"type":"text","id":"trust_label_one","label":"Name tag one","default":"Indicator one"},{"type":"image_picker","id":"trust_image_two","label":"Trust image two"},{"type":"text","id":"trust_label_two","label":"Name tag two","default":"Indicator two"},{"type":"image_picker","id":"trust_image_three","label":"Trust image three"},{"type":"text","id":"trust_label_three","label":"Name tag three","default":"Indicator three"},{"type":"range","id":"trust_label_size","label":"Name tag size","min":10,"max":18,"step":2,"unit":"px","default":12},{"type":"color","id":"trust_label_color","label":"Name tag color","default":"#FFFFFF"},{"type":"range","id":"trust_circle_size","label":"Circle size","min":64,"max":144,"step":8,"unit":"px","default":96},{"type":"range","id":"trust_stroke_width","label":"Circle stroke thickness","min":2,"max":10,"step":2,"unit":"px","default":6},{"type":"color","id":"trust_stroke_color","label":"Circle stroke","default":"#FFFFFF"}],"presets":[{"name":"Cover hero"}],"tag":null,"class":"cover-hero-block"}
{% endschema %}