#destination-hero-{{ ai_gen_id }}{display:block;position:relative;width:100vw;height:100svh;min-height:640px;margin-left:calc(50% - 50vw);overflow:hidden;background:#111;color:#fff;isolation:isolate;font-family:{{ settings.type_body_font.family }},sans-serif}#destination-hero-{{ ai_gen_id }} *,#destination-hero-{{ ai_gen_id }} *:before,#destination-hero-{{ ai_gen_id }} *:after{box-sizing:border-box}#destination-hero-{{ ai_gen_id }} .dh-bg,#destination-hero-{{ ai_gen_id }} .dh-bg img{position:absolute;inset:0;width:100%;height:100%}#destination-hero-{{ ai_gen_id }} .dh-bg{display:none}#destination-hero-{{ ai_gen_id }} .dh-bg.is-active{display:block}#destination-hero-{{ ai_gen_id }} .dh-bg img{object-fit:cover}#destination-hero-{{ ai_gen_id }} .dh-placeholder{position:absolute;inset:0;background:#252525}#destination-hero-{{ ai_gen_id }} .dh-placeholder svg{width:100%;height:100%;object-fit:cover;color:#555}#destination-hero-{{ ai_gen_id }} .dh-overlay{position:absolute;inset:0;pointer-events:none;background:linear-gradient(rgba(0,0,0,.35),transparent 20%),linear-gradient(90deg,rgba(0,0,0,.4),transparent 55%),rgba(0,0,0,{{ block.settings.overlay_opacity | divided_by:100.0 }})}#destination-hero-{{ ai_gen_id }} .dh-topbar{position:absolute;z-index:5;top:0;left:0;width:100%;height:3px}#destination-hero-{{ ai_gen_id }} .dh-topbar span{display:block;width:0;height:100%;background:{{ block.settings.accent_color }}}#destination-hero-{{ ai_gen_id }} .dh-content{position:absolute;z-index:2;left:5vw;top:35%;max-width:42vw}#destination-hero-{{ ai_gen_id }} .dh-copy{display:none}#destination-hero-{{ ai_gen_id }} .dh-copy.is-active{display:block}#destination-hero-{{ ai_gen_id }} .dh-dash{display:block;width:20px;height:3px;margin:0 0 18px;background:#fff}#destination-hero-{{ ai_gen_id }} .dh-loc-mask{overflow:hidden;margin-bottom:14px}#destination-hero-{{ ai_gen_id }} .dh-location{font-size:clamp(15px,1.4vw,22px);font-weight:300;line-height:1.2}#destination-hero-{{ ai_gen_id }} .dh-title{margin:0;font-family:{{ display_font.family }},sans-serif;font-size:clamp(52px,7.2vw,112px);font-weight:700;line-height:1.02;text-transform:uppercase}#destination-hero-{{ ai_gen_id }} .dh-title-mask{display:block;overflow:hidden}#destination-hero-{{ ai_gen_id }} .dh-description{max-width:390px;margin:18px 0 28px;color:rgba(255,255,255,.75);font-size:14px;line-height:1.75}#destination-hero-{{ ai_gen_id }} .dh-actions{display:flex;align-items:center;gap:16px}#destination-hero-{{ ai_gen_id }} .dh-save{width:38px;height:38px;flex:0 0 38px;display:grid;place-items:center;border:0;border-radius:50%;background:{{ block.settings.accent_color }};color:#fff;cursor:pointer}#destination-hero-{{ ai_gen_id }} .dh-save svg{width:14px;height:14px}#destination-hero-{{ ai_gen_id }} .dh-link{height:40px;display:inline-flex;align-items:center;padding:0 28px;border:1px solid rgba(255,255,255,.55);border-radius:999px;color:#fff;text-decoration:none;font-size:11px;font-weight:500;letter-spacing:.12em;text-transform:uppercase}#destination-hero-{{ ai_gen_id }} .dh-link:hover{background:#fff;color:#111}#destination-hero-{{ ai_gen_id }} .dh-track{position:absolute;z-index:3;left:41%;top:42%;display:flex;gap:1.9vw}#destination-hero-{{ ai_gen_id }} .dh-card{position:relative;flex:0 0 clamp(170px,14.6vw,240px);aspect-ratio:13/20;padding:0;overflow:hidden;border:0;border-radius:10px;background:#222;color:#fff;text-align:left;cursor:pointer;box-shadow:0 22px 40px #0006;transition:transform 300ms,box-shadow 300ms}#destination-hero-{{ ai_gen_id }} .dh-card:hover{transform:translateY(-6px);box-shadow:0 28px 48px #0008}#destination-hero-{{ ai_gen_id }} .dh-card img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}#destination-hero-{{ ai_gen_id }} .dh-card:after{content:'';position:absolute;inset:35% 0 0;background:linear-gradient(transparent,rgba(0,0,0,.65) 55%)}#destination-hero-{{ ai_gen_id }} .dh-card-copy{position:absolute;z-index:1;left:16px;right:10px;bottom:20px}#destination-hero-{{ ai_gen_id }} .dh-card-dash{display:block;width:12px;height:2px;margin-bottom:10px;background:#fff}#destination-hero-{{ ai_gen_id }} .dh-card-loc{display:block;margin-bottom:7px;color:#fffd;font-size:12px}#destination-hero-{{ ai_gen_id }} .dh-card-title{display:block;font-family:{{ display_font.family }},sans-serif;font-size:21px;font-weight:700;line-height:1.05;text-transform:uppercase}#destination-hero-{{ ai_gen_id }} .dh-controls{position:absolute;z-index:4;left:41%;right:4vw;top:91%;transform:translateY(-50%);display:flex;align-items:center;gap:12px}#destination-hero-{{ ai_gen_id }} .dh-arrow{width:60px;height:60px;flex:0 0 60px;display:grid;place-items:center;border:1px solid #ffffff8c;border-radius:50%;background:transparent;color:#fff;cursor:pointer}#destination-hero-{{ ai_gen_id }} .dh-arrow:hover{background:#ffffff1a}#destination-hero-{{ ai_gen_id }} .dh-arrow svg{width:19px;height:19px}#destination-hero-{{ ai_gen_id }} .dh-progress{flex:1;height:1px;margin:0 12px;background:#ffffff59}#destination-hero-{{ ai_gen_id }} .dh-progress span{display:block;width:0;height:2px;margin-top:-.5px;background:{{ block.settings.accent_color }}}#destination-hero-{{ ai_gen_id }} .dh-counter{width:78px;flex:0 0 78px;overflow:hidden;font-family:{{ display_font.family }},sans-serif;font-size:clamp(36px,3.6vw,56px);font-weight:700;line-height:1.1;text-align:right}#destination-hero-{{ ai_gen_id }} button:focus-visible,#destination-hero-{{ ai_gen_id }} a:focus-visible{outline:2px solid #fff;outline-offset:4px}
@media(max-width:1024px){#destination-hero-{{ ai_gen_id }} .dh-track{left:46%}#destination-hero-{{ ai_gen_id }} .dh-card{flex-basis:clamp(150px,18vw,190px)}}@media(max-width:749px){#destination-hero-{{ ai_gen_id }} .dh-content{left:5vw;top:18%;max-width:90vw}#destination-hero-{{ ai_gen_id }} .dh-title{font-size:clamp(40px,11vw,56px)}#destination-hero-{{ ai_gen_id }} .dh-description{max-width:90%}#destination-hero-{{ ai_gen_id }} .dh-track{left:5vw;right:0;top:auto;bottom:120px;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding-right:5vw;scrollbar-width:none}#destination-hero-{{ ai_gen_id }} .dh-card{flex:0 0 132px;scroll-snap-align:start}#destination-hero-{{ ai_gen_id }} .dh-controls{left:5vw;right:5vw;top:auto;bottom:32px;transform:none;gap:8px}#destination-hero-{{ ai_gen_id }} .dh-arrow{width:48px;height:48px;flex-basis:48px}#destination-hero-{{ ai_gen_id }} .dh-progress{margin:0 8px}#destination-hero-{{ ai_gen_id }} .dh-counter{width:32px;flex-basis:32px;font-size:32px}}
