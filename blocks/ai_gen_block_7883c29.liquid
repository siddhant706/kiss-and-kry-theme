<destination-hero-{{ ai_gen_id }} id="destination-hero-{{ ai_gen_id }}" data-autoplay="{{ block.settings.autoplay }}" data-seconds="{{ block.settings.autoplay_seconds }}" data-pause="{{ block.settings.pause_on_hover }}" {{ block.shopify_attributes }}><div class="dh-topbar"><span></span></div><div class="dh-backgrounds">{% for i in (1..6) %}{% assign t1='slide_' | append:i | append:'_line_1' %}{% assign t2='slide_' | append:i | append:'_line_2' %}{% assign im='slide_' | append:i | append:'_image' %}{% assign image=block.settings[im] %}{% if block.settings[t1] != blank or block.settings[t2] != blank %}<div class="dh-bg{% if forloop.first %} is-active{% endif %}">{% if image %}{{ image | image_url: width: 2400 | image_tag: widths: '480, 750, 1100, 1500, 2000, 2400', sizes: '100vw', class: 'dh-bg-image', loading: forloop.first | default: false, fetchpriority: 'high' }}{% else %}<div class="dh-placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}</div>{% endif %}{% endfor %}</div><div class="dh-overlay"></div><div class="dh-content">{% for i in (1..6) %}{% assign loc='slide_' | append:i | append:'_location' %}{% assign t1='slide_' | append:i | append:'_line_1' %}{% assign t2='slide_' | append:i | append:'_line_2' %}{% assign de='slide_' | append:i | append:'_description' %}{% assign la='slide_' | append:i | append:'_label' %}{% assign li='slide_' | append:i | append:'_link' %}{% if block.settings[t1] != blank or block.settings[t2] != blank %}<article class="dh-copy{% if forloop.first %} is-active{% endif %}"><span class="dh-dash"></span><div class="dh-loc-mask"><div class="dh-location">{{ block.settings[loc] | escape }}</div></div><h1 class="dh-title"><span class="dh-title-mask">{{ block.settings[t1] | escape }}</span><span class="dh-title-mask">{{ block.settings[t2] | escape }}</span></h1><p class="dh-description">{{ block.settings[de] | escape }}</p><div class="dh-actions"><button class="dh-save" type="button" aria-label="Save destination" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3.75h12v17l-6-4-6 4v-17Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></button><a class="dh-link" href="{{ block.settings[li] | default:'#' }}">{{ block.settings[la] | escape }}</a></div></article>{% endif %}{% endfor %}</div><div class="dh-track">{% for i in (1..6) %}{% assign t1='slide_' | append:i | append:'_line_1' %}{% assign t2='slide_' | append:i | append:'_line_2' %}{% assign loc='slide_' | append:i | append:'_location' %}{% assign im='slide_' | append:i | append:'_image' %}{% assign image=block.settings[im] %}{% if block.settings[t1] != blank or block.settings[t2] != blank %}<button type="button" class="dh-card" data-card="{{ forloop.index0 }}" aria-label="Show {{ block.settings[loc] | escape }}">{% if image %}{{ image | image_url: width:600 | image_tag: widths:'132, 300, 450, 600', sizes:'(max-width: 749px) 132px, 18vw', loading:'lazy' }}{% else %}<div class="dh-placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag }}</div>{% endif %}<span class="dh-card-copy"><span class="dh-card-dash"></span><span class="dh-card-loc">{{ block.settings[loc] | escape }}</span><span class="dh-card-title">{{ block.settings[t1] | escape }}<br>{{ block.settings[t2] | escape }}</span></span></button>{% endif %}{% endfor %}</div><div class="dh-controls"><button class="dh-arrow dh-prev" type="button" aria-label="Previous slide"><svg viewBox="0 0 24 24" fill="none"><path d="m15 5-7 7 7 7" stroke="currentColor" stroke-width="1.2"/></svg></button><button class="dh-arrow dh-next" type="button" aria-label="Next slide"><svg viewBox="0 0 24 24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.2"/></svg></button><div class="dh-progress"><span></span></div><div class="dh-counter" aria-live="polite">01</div></div></destination-hero-{{ ai_gen_id }}>
<script>(function(){const tag='destination-hero-{{ ai_gen_id }}';if(customElements.get(tag))return;class Hero extends HTMLElement{connectedCallback(){this.bg=[...this.querySelectorAll('.dh-bg')];this.copy=[...this.querySelectorAll('.dh-copy')];this.cards=[...this.querySelectorAll('.dh-card')];this.index=0;this.fill=this.querySelector('.dh-progress span');this.bar=this.querySelector('.dh-topbar span');this.querySelector('.dh-prev').addEventListener('click',()=>this.show(this.index-1));this.querySelector('.dh-next').addEventListener('click',()=>this.show(this.index+1));this.cards.forEach((c,i)=>c.addEventListener('click',()=>this.show(i)));this.querySelectorAll('.dh-save').forEach(b=>b.addEventListener('click',()=>{let on=b.getAttribute('aria-pressed')==='true';b.setAttribute('aria-pressed',String(!on));b.querySelector('path').setAttribute('fill',on?'none':'currentColor')}));this.show(0);if(this.dataset.autoplay==='true'&&this.copy.length>1){this.timer=setInterval(()=>{if(this.dataset.pause==='true'&&this.matches(':hover'))return;this.show(this.index+1)},Number(this.dataset.seconds)*1000)}}show(n){const count=this.copy.length;this.index=(n+count)%count;this.copy.forEach((e,i)=>e.classList.toggle('is-active',i===this.index));this.bg.forEach((e,i)=>e.classList.toggle('is-active',i===this.index));const activeCard=this.cards[this.index];if(activeCard)this.cards.forEach((e,i)=>this.querySelector('.dh-track').appendChild(this.cards[(this.index+i+1)%this.cards.length]));this.fill.style.width=(this.index/count*100)+'%';this.bar.style.width='0%';this.querySelector('.dh-counter').textContent=String(this.index+1).padStart(2,'0')}}customElements.define(tag,Hero)})();</script>
