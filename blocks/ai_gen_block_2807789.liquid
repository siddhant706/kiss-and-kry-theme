{% doc %}
  @prompt
    generate a full page width section with background image eyebrow, title, subheading , context 5 trust indicators with PNG icons to change all equal size and text must be just below of icons not on any other sides then at the bottom a quote line with a PNG icon on left on glassmorphic style circle, WHY BAMBOO?
    Why Bamboo.
    Nature’s Softest Gift
    
    Bamboo is a naturally renewable resource that grows without harmful pesticides and uses 30% less water than cotton.
    
    It’s gentle on your baby’s skin and gentle on our planet.
    
    Ultra Soft
    
    Silky smooth fibers that feel like a gentle hug on delicate skin.
    
    Breathable
    
    Highly breathable fabric that keeps baby cool and comfortable.
    
    Thermoregulating
    
    Naturally adapts to your baby’s body temperature in every season.
    
    Hypoallergenic
    
    Naturally hypoallergenic and antibacterial, perfect for sensitive skin.
    
    Sustainable
    
    Eco-friendly and biodegradable.
    
    Better for your baby, better for our Earth.
    
    “From the forest to your baby, with love.”
    
    SUSTAINABLE BY NATURE. SAFE BY CHOICE. MADE FOR YOUR LITTLE ONE.
    
    add this content in this section accordingly, now make all the text is rich text in this section
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .shopify-block:has(> .ai-trust-section-{{ ai_gen_id }}) {
    width: 100%;
    align-self: stretch;
  }

  .ai-trust-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    display: block;
    overflow: hidden;
  }

  .ai-trust-section-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-trust-section-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-trust-section-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-section-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-trust-section-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity }};
    z-index: 1;
  }

  .ai-trust-section-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-trust-section-header-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin-bottom: {{ block.settings.header_spacing }}px;
  }

  .ai-trust-section-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: {{ block.settings.eyebrow_spacing }}px;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
  }

  .ai-trust-section-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px;
    line-height: 1.2;
    font-weight: 700;
  }

  .ai-trust-section-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin-bottom: {{ block.settings.subheading_spacing }}px;
    line-height: 1.5;
  }

  .ai-trust-section-context-{{ ai_gen_id }} {
    font-size: {{ block.settings.context_size }}px;
    color: {{ block.settings.context_color }};
    margin-bottom: {{ block.settings.context_spacing }}px;
    line-height: 1.6;
  }

  .ai-trust-indicators-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: {{ block.settings.indicators_gap }}px;
    margin-bottom: {{ block.settings.indicators_spacing }}px;
  }

  .ai-trust-indicator-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .ai-trust-indicator-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_text_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-indicator-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-trust-indicator-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-indicator-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.5;
  }

  .ai-trust-indicator-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.indicator_title_size }}px;
    color: {{ block.settings.indicator_title_color }};
    font-weight: 700;
    margin-bottom: {{ block.settings.indicator_title_spacing }}px;
    line-height: 1.3;
  }

  .ai-trust-indicator-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.indicator_text_size }}px;
    color: {{ block.settings.indicator_text_color }};
    line-height: 1.4;
  }

  .ai-trust-quote-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: {{ block.settings.quote_icon_spacing }}px;
    padding: {{ block.settings.quote_padding }}px;
    margin-bottom: {{ block.settings.quote_spacing }}px;
  }

  .ai-trust-quote-icon-{{ ai_gen_id }} {
    flex-shrink: 0;
    width: {{ block.settings.quote_icon_size }}px;
    height: {{ block.settings.quote_icon_size }}px;
    border-radius: 50%;
    background: {{ block.settings.glassmorphic_background }};
    backdrop-filter: blur({{ block.settings.glassmorphic_blur }}px);
    border: {{ block.settings.glassmorphic_border_width }}px solid {{ block.settings.glassmorphic_border_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.quote_icon_padding }}px;
  }

  .ai-trust-quote-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-trust-quote-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-trust-quote-icon-placeholder-{{ ai_gen_id }} svg {
    width: 70%;
    height: 70%;
    opacity: 0.6;
  }

  .ai-trust-quote-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_text_size }}px;
    color: {{ block.settings.quote_text_color }};
    line-height: 1.5;
    font-style: italic;
  }

  .ai-trust-footer-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.footer_text_size }}px;
    color: {{ block.settings.footer_text_color }};
    text-transform: uppercase;
    letter-spacing: 2px;
    font-weight: 600;
    line-height: 1.6;
  }

  @media screen and (max-width: 989px) {
    .ai-trust-indicators-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }

    .ai-trust-section-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.7);
    }

    .ai-trust-section-content-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.7 }}px 20px {{ block.settings.section_padding_bottom | times: 0.7 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-trust-indicators-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-trust-section-title-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.title_size }}px * 0.5);
    }

    .ai-trust-section-eyebrow-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.eyebrow_size }}px * 0.9);
    }

    .ai-trust-section-subheading-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.subheading_size }}px * 0.9);
    }

    .ai-trust-section-context-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.context_size }}px * 0.9);
    }

    .ai-trust-quote-{{ ai_gen_id }} {
      flex-direction: column;
      text-align: center;
    }

    .ai-trust-section-content-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_top | times: 0.5 }}px 15px {{ block.settings.section_padding_bottom | times: 0.5 }}px;
    }

    .ai-trust-footer-{{ ai_gen_id }} {
      font-size: calc({{ block.settings.footer_text_size }}px * 0.8);
    }
  }
{% endstyle %}

<trust-section-{{ ai_gen_id }} class="ai-trust-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-trust-section-bg-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-trust-section-bg-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-trust-section-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-trust-section-content-{{ ai_gen_id }}">
    <div class="ai-trust-section-header-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-trust-section-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.title != blank %}
        <h2 class="ai-trust-section-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-trust-section-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.context != blank %}
        <div class="ai-trust-section-context-{{ ai_gen_id }}">{{ block.settings.context }}</div>
      {% endif %}
    </div>

    <div class="ai-trust-indicators-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign icon_key = 'indicator_' | append: i | append: '_icon'
          assign title_key = 'indicator_' | append: i | append: '_title'
          assign text_key = 'indicator_' | append: i | append: '_text'
          assign icon = block.settings[icon_key]
          assign title = block.settings[title_key]
          assign text = block.settings[text_key]
        %}

        <div class="ai-trust-indicator-{{ ai_gen_id }}">
          <div class="ai-trust-indicator-icon-wrapper-{{ ai_gen_id }}">
            {% if icon %}
              <img
                src="{{ icon | image_url: width: 200 }}"
                alt="{{ title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <div class="ai-trust-indicator-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
          {% if title != blank %}
            <div class="ai-trust-indicator-title-{{ ai_gen_id }}">{{ title }}</div>
          {% endif %}
          {% if text != blank %}
            <div class="ai-trust-indicator-text-{{ ai_gen_id }}">{{ text }}</div>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="ai-trust-quote-{{ ai_gen_id }}">
      <div class="ai-trust-quote-icon-{{ ai_gen_id }}">
        {% if block.settings.quote_icon %}
          <img
            src="{{ block.settings.quote_icon | image_url: width: 100 }}"
            alt="Quote icon"
            loading="lazy"
            width="100"
            height="100"
          >
        {% else %}
          <div class="ai-trust-quote-icon-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
      {% if block.settings.quote_text != blank %}
        <div class="ai-trust-quote-text-{{ ai_gen_id }}">{{ block.settings.quote_text }}</div>
      {% endif %}
    </div>

    {% if block.settings.footer_text != blank %}
      <div class="ai-trust-footer-{{ ai_gen_id }}">{{ block.settings.footer_text }}</div>
    {% endif %}
  </div>
</trust-section-{{ ai_gen_id }}>

<script>
  (function() {
    class TrustSection{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('trust-section-{{ ai_gen_id }}', TrustSection{{ ai_gen_id }});
  })();
</script>

