{% doc %}
  @prompt
    generate a full page width section as :
    background image
    eyebrow
    title
    subheading
    context
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: {{ block.settings.vertical_alignment }};
    justify-content: {{ block.settings.horizontal_alignment }};
    overflow: hidden;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: {{ block.settings.image_position }};
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    max-width: {{ block.settings.content_width }}px;
    padding: {{ block.settings.content_padding }}px;
    text-align: {{ block.settings.text_alignment }};
    color: {{ block.settings.text_color }};
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.eyebrow_font }};
    font-size: {{ block.settings.eyebrow_size }}px;
    text-transform: {{ block.settings.eyebrow_transform }};
    letter-spacing: {{ block.settings.eyebrow_spacing }}px;
    margin-bottom: {{ block.settings.eyebrow_margin }}px;
    color: {{ block.settings.eyebrow_color }};
  }

  .ai-hero-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.1;
    margin: 0 0 {{ block.settings.title_margin }}px;
    color: {{ block.settings.title_color }};
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font }};
    font-size: {{ block.settings.subheading_size }}px;
    line-height: 1.4;
    margin: 0 0 {{ block.settings.subheading_margin }}px;
    color: {{ block.settings.subheading_color }};
  }

  .ai-hero-context-{{ ai_gen_id }} {
    font-family: {{ block.settings.context_font }};
    font-size: {{ block.settings.context_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.context_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-section-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_mobile }}px;
    }

    .ai-hero-content-{{ ai_gen_id }} {
      max-width: 100%;
      padding: {{ block.settings.content_padding_mobile }}px;
    }

    .ai-hero-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_size | times: 0.85 }}px;
    }

    .ai-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.6 }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }

    .ai-hero-context-{{ ai_gen_id }} {
      font-size: {{ block.settings.context_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        srcset="{{ block.settings.background_image | image_url: width: 750 }} 750w,
                {{ block.settings.background_image | image_url: width: 1500 }} 1500w,
                {{ block.settings.background_image | image_url: width: 2000 }} 2000w"
        sizes="100vw"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  {% if block.settings.show_overlay %}
    <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>
  {% endif %}

  <div class="ai-hero-content-{{ ai_gen_id }}">
    {% if block.settings.eyebrow != blank %}
      <div class="ai-hero-eyebrow-{{ ai_gen_id }}">
        {{ block.settings.eyebrow }}
      </div>
    {% endif %}

    {% if block.settings.title != blank %}
      <h1 class="ai-hero-title-{{ ai_gen_id }}">
        {{ block.settings.title }}
      </h1>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <div class="ai-hero-subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </div>
    {% endif %}

    {% if block.settings.context != blank %}
      <div class="ai-hero-context-{{ ai_gen_id }}">
        {{ block.settings.context }}
      </div>
    {% endif %}
  </div>
</div>

