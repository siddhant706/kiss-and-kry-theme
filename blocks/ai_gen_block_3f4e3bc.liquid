    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay .ai-bento-{{ ai_gen_id }}__product-eyebrow {
      font-size: 6px;
    }

    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay > span:not(.ai-bento-{{ ai_gen_id }}__product-eyebrow) {
      font-size: 11px;
