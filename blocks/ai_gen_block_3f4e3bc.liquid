      font-size: 10px;
    }

    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 4px 5px;
      padding: 7px 0 2px;
    }

    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__overlay h3 {
      font-size: clamp(10px, 3.1vw, 13px);
      line-height: 1.2;
      overflow-wrap: anywhere;
