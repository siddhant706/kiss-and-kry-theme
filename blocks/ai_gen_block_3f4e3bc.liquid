{% endstyle %}

<product-bento-{{ ai_gen_id }} class="ai-bento-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bento-{{ ai_gen_id }}__inner">
    <div class="ai-bento-{{ ai_gen_id }}__header">
      <div class="ai-bento-{{ ai_gen_id }}__header-text">
        {% if block.settings.eyebrow != blank %}
          <div class="ai-bento-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>
        {% endif %}
        {% if block.settings.heading != blank %}
          <div class="ai-bento-{{ ai_gen_id }}__heading-mask">
            <div class="ai-bento-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>
          </div>
        {% endif %}
      </div>

      <div class="ai-bento-{{ ai_gen_id }}__filters" role="tablist" aria-label="Filter products by category">
        <button
          type="button"
          class="ai-bento-{{ ai_gen_id }}__filter-btn is-active"
          data-filter="all"
          role="tab"
          aria-selected="true"
          style="--f-idx: 0;"
        >
          All
        </button>
        <button
          type="button"
          class="ai-bento-{{ ai_gen_id }}__filter-btn"
          data-filter="bedding"
          role="tab"
          aria-selected="false"
          style="--f-idx: 1;"
        >
          Bedding
        </button>
        <button
          type="button"
          class="ai-bento-{{ ai_gen_id }}__filter-btn"
          data-filter="bodysuits"
          role="tab"
          aria-selected="false"
          style="--f-idx: 2;"
        >
          Bodysuits
        </button>
        <button
          type="button"
          class="ai-bento-{{ ai_gen_id }}__filter-btn"
          data-filter="rompers"
          role="tab"
          aria-selected="false"
          style="--f-idx: 3;"
        >
          Rompers & Footies
        </button>
      </div>
    </div>

    <div class="ai-bento-{{ ai_gen_id }}__grid">
      {% for i in (1..5) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign item = block.settings[product_key]
          assign card_idx = forloop.index0
          assign card_category = 'bamboo'
          if i == 1
            assign card_category = 'bedding'
          elsif i == 2 or i == 3
            assign card_category = 'rompers'
          elsif i == 4 or i == 5
            assign card_category = 'bodysuits'
          endif
        %}
        <article
          class="ai-bento-{{ ai_gen_id }}__card{% if i == 1 %} ai-bento-{{ ai_gen_id }}__card--featured{% endif %}"
          data-category="{{ card_category }}"
          style="--card-idx: {{ card_idx }};"
        >
          {% if i == 1 %}
            <span class="ai-bento-{{ ai_gen_id }}__trust" aria-label="Trust indicator">
              {% if block.settings.trust_image %}
                <img
                  src="{{ block.settings.trust_image | image_url: width: 300 }}"
                  alt="{{ block.settings.trust_image.alt | default: 'Trust indicator' | escape }}"
                  loading="lazy"
                  width="300"
                  height="300"
                >
              {% else %}
                TRUST<br>BADGE
              {% endif %}
            </span>
            <span class="ai-bento-{{ ai_gen_id }}__label">BEDDING</span>
          {% else %}
            <span class="ai-bento-{{ ai_gen_id }}__label">BAMBOO</span>
            <button
              class="ai-bento-{{ ai_gen_id }}__wishlist"
              type="button"
              aria-label="Add product to wishlist"
              aria-pressed="false"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M20.8 8.6c0 4.3-8.8 10-8.8 10s-8.8-5.7-8.8-10a4.6 4.6 0 0 1 8.8-1.8 4.6 4.6 0 0 1 8.8 1.8Z"/>
              </svg>
            </button>
          {% endif %}

          {% if item != blank and item.featured_image %}
            {% if i == 1 %}
              <div class="ai-bento-{{ ai_gen_id }}__media-wrap--featured">
                <img
                  class="ai-bento-{{ ai_gen_id }}__image ai-bento-{{ ai_gen_id }}__image--featured"
                  src="{{ item.featured_image | image_url: width: 1200 }}"
                  alt="{{ item.featured_image.alt | default: item.title | escape }}"
                  loading="lazy"
                  width="{{ item.featured_image.width }}"
                  height="{{ item.featured_image.height }}"
                >
              </div>
            {% else %}
              <img
                class="ai-bento-{{ ai_gen_id }}__image"
                src="{{ item.featured_image | image_url: width: 1000 }}"
                alt="{{ item.featured_image.alt | default: item.title | escape }}"
                loading="lazy"
                width="{{ item.featured_image.width }}"
                height="{{ item.featured_image.height }}"
              >
            {% endif %}
          {% else %}
            <div class="ai-bento-{{ ai_gen_id }}__placeholder">
              {{ 'product-apparel-1' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="ai-bento-{{ ai_gen_id }}__overlay">
            {% if i > 1 %}
              <span class="ai-bento-{{ ai_gen_id }}__product-eyebrow">
                {% if i == 2 or i == 3 %}
                  {% if i == 2 %}ROMPERS{% else %}FOOTIES{% endif %}
                {% else %}
                  BODYSUITS
                {% endif %}
              </span>
            {% endif %}

            <h3>
              {% if item != blank %}
                {{ item.title | escape }}
              {% else %}
                Choose product {{ i }}
              {% endif %}
            </h3>

            {% if i == 1 and block.settings.product_one_description != blank %}
              <div class="ai-bento-{{ ai_gen_id }}__description">
                {{ block.settings.product_one_description }}
              </div>
            {% endif %}

            {% if item != blank and i == 1 %}
              <div class="ai-bento-{{ ai_gen_id }}__product-one-actions">
                <span class="ai-bento-{{ ai_gen_id }}__product-one-price">{{ item.price | money }}</span>
                {% form 'product', item %}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ item.selected_or_first_available_variant.id }}"
                  >
                  <button
                    type="submit"
                    class="ai-bento-{{ ai_gen_id }}__cart-button ai-bento-{{ ai_gen_id }}__product-one-button"
                    {% unless item.available %}disabled{% endunless %}
                  >
                    {% if item.available %}
                      Add to cart
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 1.9-1.4L21 8H6"/>
                        <circle cx="10" cy="20" r="1"/>
                        <circle cx="18" cy="20" r="1"/>
                      </svg>
                    {% else %}
                      Sold out
                    {% endif %}
                  </button>
                {% endform %}
                <a class="ai-bento-{{ ai_gen_id }}__product-one-details" href="{{ item.url }}">
                  View product details
                </a>
              </div>
            {% elsif item != blank %}
              <span>{{ item.price | money }}</span>
              {% if i > 1 %}
                {% form 'product', item %}
                  <input
                    type="hidden"
                    name="id"
                    value="{{ item.selected_or_first_available_variant.id }}"
                  >
                  <button
                    type="submit"
                    class="ai-bento-{{ ai_gen_id }}__cart-button"
                    aria-label="{% if item.available %}Add {{ item.title | escape }} to cart{% else %}Sold out{% endif %}"
                    {% unless item.available %}disabled{% endunless %}
                  >
                    {% if item.available %}
                      Add
                      <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3 4h2l2.2 10.2a2 2 0 0 0 2 1.6h8.4a2 2 0 0 0 1.9-1.4L21 8H6"/>
                        <circle cx="10" cy="20" r="1"/>
                        <circle cx="18" cy="20" r="1"/>
                      </svg>
                    {% else %}
                      Sold out
                    {% endif %}
                  </button>
                {% endform %}
              {% endif %}
            {% else %}
              <span>Add a product in block settings</span>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</product-bento-{{ ai_gen_id }}>

<script>
  (() => {
    const tag = 'product-bento-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;

    class Bento extends HTMLElement {
      connectedCallback() {
        // 1. Wishlist toggle
        this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__wishlist').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            e.stopPropagation();
            const isPressed = btn.getAttribute('aria-pressed') === 'true';
            btn.setAttribute('aria-pressed', String(!isPressed));
            btn.setAttribute('aria-label', isPressed ? 'Add product to wishlist' : 'Remove product from wishlist');
          });
        });

        // 2. Category filters
        const filterBtns = this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__filter-btn');
        const cards = this.querySelectorAll('.ai-bento-{{ ai_gen_id }}__card');

        filterBtns.forEach((btn) => {
          btn.addEventListener('click', () => {
            const filter = btn.dataset.filter;
            filterBtns.forEach((b) => {
              const active = b === btn;
              b.classList.toggle('is-active', active);
              b.setAttribute('aria-selected', String(active));
            });

            cards.forEach((card) => {
              const cat = card.dataset.category || '';
              const matches = filter === 'all' || cat.includes(filter);
              card.classList.toggle('is-filtered-out', !matches);
              card.classList.toggle('is-filtered-match', matches && filter !== 'all');
            });
          });
        });

        // 3. Section entrance animation observer
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.classList.add('is-visible');
        } else if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  this.classList.add('is-visible');
                  this.observer?.disconnect();
                }
              });
            },
            { threshold: 0.1 }
          );
          this.observer.observe(this);
        } else {
          this.classList.add('is-visible');
        }

        // 4. Subtle parallax effect on featured collection image
        this.initParallax();
      }

      initParallax() {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const featuredImg = this.querySelector('.ai-bento-{{ ai_gen_id }}__image--featured');
        if (!featuredImg) return;

        let ticking = false;
        const maxParallax = 16; // gentle movement approx 15-20px

        const updateParallax = () => {
          const rect = this.getBoundingClientRect();
          const winH = window.innerHeight;
          if (rect.bottom > 0 && rect.top < winH) {
            const progress = (winH - rect.top) / (winH + rect.height);
            const clamped = Math.max(0, Math.min(1, progress));
            const translateY = (clamped - 0.5) * maxParallax * 2;
            featuredImg.style.setProperty('--bento-parallax-y', `${translateY.toFixed(1)}px`);
          }
          ticking = false;
        };

        this.onScroll = () => {
          if (!ticking) {
            requestAnimationFrame(updateParallax);
            ticking = true;
          }
        };

        const pageWrapper = document.querySelector('.page-wrapper');
        if (pageWrapper) {
          pageWrapper.addEventListener('scroll', this.onScroll, { passive: true });
        }
        window.addEventListener('scroll', this.onScroll, { passive: true });
        updateParallax();
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
        if (this.onScroll) {
          const pageWrapper = document.querySelector('.page-wrapper');
          if (pageWrapper) {
            pageWrapper.removeEventListener('scroll', this.onScroll);
          }
          window.removeEventListener('scroll', this.onScroll);
        }
      }
    }

    customElements.define(tag, Bento);
  })();
</script>

