    .ai-bento-{{ ai_gen_id }}__card:nth-child(n+2) .ai-bento-{{ ai_gen_id }}__cart-button svg {
      width: 12px;
      height: 12px;
    }
  }

  @media (max-width: 360px) {
    .ai-bento-{{ ai_gen_id }} {
      padding-left: 10px;
      padding-right: 10px;
    }

    .ai-bento-{{ ai_gen_id }}__grid {
      gap: 12px 7px;
    }

    .ai-bento-{{ ai_gen_id }}__card:nth-child(1) {
      min-height: 280px;
    }

    .ai-bento-{{ ai_gen_id }}__product-one-actions {
      gap: 5px;
    }

    .ai-bento-{{ ai_gen_id }}__product-one-details {
      font-size: 9px;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .ai-bento-{{ ai_gen_id }}__eyebrow,
    .ai-bento-{{ ai_gen_id }}__heading,
    .ai-bento-{{ ai_gen_id }}__filter-btn,
    .ai-bento-{{ ai_gen_id }}__card,
    .ai-bento-{{ ai_gen_id }}__media-wrap--featured,
    .ai-bento-{{ ai_gen_id }}__image,
    .ai-bento-{{ ai_gen_id }}__wishlist,
    .ai-bento-{{ ai_gen_id }}__label,
    .ai-bento-{{ ai_gen_id }}__cart-button {
      opacity: 1 !important;
      transform: none !important;
