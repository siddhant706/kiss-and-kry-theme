<story-brand-{{ ai_gen_id }} class="ai-story-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-story-{{ ai_gen_id }}__inner">
    <div class="ai-story-{{ ai_gen_id }}__copy">
      <div class="ai-story-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</div>
      <div class="ai-story-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</div>
      <div class="ai-story-{{ ai_gen_id }}__paragraph" style="--p-idx: 0;">{{ block.settings.paragraph_one }}</div>
      <div class="ai-story-{{ ai_gen_id }}__paragraph" style="--p-idx: 1;">{{ block.settings.paragraph_two }}</div>
      <div class="ai-story-{{ ai_gen_id }}__signature">
        <div class="ai-story-{{ ai_gen_id }}__signoff">{{ block.settings.signature }}</div>
        <div class="ai-story-{{ ai_gen_id }}__tagline">{{ block.settings.tagline }}</div>
      </div>
      <div class="ai-story-{{ ai_gen_id }}__badges">
        {% for i in (1..3) %}
          {% assign label_key = 'badge_' | append: i %}
          {% assign icon_key = 'badge_' | append: i | append: '_icon' %}
          {% assign badge_idx = forloop.index0 %}
          <span class="ai-story-{{ ai_gen_id }}__badge" style="--badge-idx: {{ badge_idx }};">
            <span class="ai-story-{{ ai_gen_id }}__icon" aria-hidden="true">
              {% case block.settings[icon_key] %}
                {% when 'leaf' %}
                  <svg viewBox="0 0 16 16" fill="none"><path d="M14 2C7 2 3 4 3 8c0 2 1.5 3.5 3.5 3.5C11 11.5 14 7 14 2ZM2 14c2-4 5-6 9-8" stroke="currentColor" stroke-width="1.3"/></svg>
                {% when 'heart' %}
                  <svg viewBox="0 0 16 16" fill="none"><path d="m8 14-5-5C0 6 4 2 7 5l1 1 1-1c3-3 7 1 4 4l-5 5Z" stroke="currentColor" stroke-width="1.3"/></svg>
                {% else %}
                  <svg viewBox="0 0 16 16" fill="none"><path d="m8 1 1.3 4L13 7l-3.7 1.4L8 12 6.7 8.4 3 7l3.7-2L8 1Z" stroke="currentColor" stroke-width="1.1"/></svg>
              {% endcase %}
            </span>
            <span class="ai-story-{{ ai_gen_id }}__badge-label">{{ block.settings[label_key] }}</span>
          </span>
        {% endfor %}
      </div>
    </div>

    <div class="ai-story-{{ ai_gen_id }}__visual">
      <div class="ai-story-{{ ai_gen_id }}__collage">
        {% if block.settings.story_image %}
          <div class="ai-story-{{ ai_gen_id }}__photo-wrap">
            <img
              class="ai-story-{{ ai_gen_id }}__photo"
              src="{{ block.settings.story_image | image_url: width: 1400 }}"
              alt="{{ block.settings.story_image.alt | default: 'Baby wearing yellow bamboo babywear' | escape }}"
              loading="lazy"
              width="{{ block.settings.story_image.width }}"
              height="{{ block.settings.story_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-story-{{ ai_gen_id }}__photo-wrap ai-story-{{ ai_gen_id }}__placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-story-{{ ai_gen_id }}__empty">Add the main baby image</span>
          </div>
        {% endif %}

        {% if block.settings.detail_image %}
          <div class="ai-story-{{ ai_gen_id }}__photo-small-wrap">
            <img
              class="ai-story-{{ ai_gen_id }}__photo-small"
              src="{{ block.settings.detail_image | image_url: width: 900 }}"
              alt="{{ block.settings.detail_image.alt | default: 'Baby resting comfortably on blanket' | escape }}"
              loading="lazy"
              width="{{ block.settings.detail_image.width }}"
              height="{{ block.settings.detail_image.height }}"
            >
          </div>
        {% else %}
          <div class="ai-story-{{ ai_gen_id }}__photo-small-wrap ai-story-{{ ai_gen_id }}__small-placeholder">
            {{ 'image' | placeholder_svg_tag }}
            <span class="ai-story-{{ ai_gen_id }}__empty">Add the secondary baby image</span>
          </div>
        {% endif %}

        <div class="ai-story-{{ ai_gen_id }}__quote">
          <p class="ai-story-{{ ai_gen_id }}__quote-mark" aria-hidden="true">“</p>
          <div class="ai-story-{{ ai_gen_id }}__quote-text">{{ block.settings.quote }}</div>
          <div class="ai-story-{{ ai_gen_id }}__attribution">{{ block.settings.attribution }}</div>
        </div>
      </div>
    </div>
  </div>
</story-brand-{{ ai_gen_id }}>

<script>
  (() => {
    const tag = 'story-brand-{{ ai_gen_id }}';
    if (customElements.get(tag)) return;

    class StoryBrand extends HTMLElement {
      connectedCallback() {
        this.initHeadingLines();

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          this.classList.add('is-visible');
        } else if ('IntersectionObserver' in window) {
          this.observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  this.classList.add('is-visible');
                  this.observer?.disconnect();
                }
              });
            },
            { threshold: 0.15 }
          );
          this.observer.observe(this);
        } else {
          this.classList.add('is-visible');
        }
      }

      initHeadingLines() {
        const heading = this.querySelector('.ai-story-{{ ai_gen_id }}__heading');
        if (!heading || heading.dataset.linesPrepared) return;
        heading.dataset.linesPrepared = 'true';

        const target = heading.querySelector('h1, h2, h3, h4, h5, h6, p') || heading;
        const rawHtml = target.innerHTML;
        if (/<br\s*\/?>/i.test(rawHtml)) {
          const rawParts = rawHtml.split(/<br\s*\/?>/i);
          target.innerHTML = rawParts
            .map((part, idx) => {
              const cleaned = part.replace(/<\/?strong>/gi, '').trim();
              return `<span class="ai-story-{{ ai_gen_id }}__heading-line" style="--line-idx: ${idx};"><span class="ai-story-{{ ai_gen_id }}__heading-line-inner">${cleaned}</span></span>`;
            })
            .join('');
        } else {
          const cleaned = rawHtml.replace(/<\/?strong>/gi, '').trim();
          target.innerHTML = `<span class="ai-story-{{ ai_gen_id }}__heading-line" style="--line-idx: 0;"><span class="ai-story-{{ ai_gen_id }}__heading-line-inner">${cleaned}</span></span>`;
        }
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }
    }

    customElements.define(tag, StoryBrand);
  })();
</script>
