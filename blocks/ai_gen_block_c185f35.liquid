{% doc %}
  @prompt
    Generate a full page width section with a background image 
    Left Align : 
    Eyebrow 
    title
    subheading
    content
    CTA button glassmorphic style
    4 trust indicators with png icons so that I can change
    Right Align :
    an event card event name , date and day , location and stall no. in glassmorphic style , NATURE’S SOFTEST GIFT
    Born From Bamboo.
    Made For Baby.
    
    Ultra soft. Naturally breathable.
    Thoughtfully made for your little one.
    
    CTA Button:
    SHOP COLLECTION →
    
    Trust Indicators
    
    BAMBOO VISCOSE
    
    ULTRA SOFT
    
    BREATHABLE & GENTLE
    
    HYPOALLERGENIC & SAFE
    
    Event Card
    
    VISIT US AT
    
    Udaan 2.0
    
    1–2 AUGUST 2026
    
    EPICENTRE, APPAREL HOUSE,
    SECTOR 44, GURUGRAM
    
    STALL G86
    
    add this content in this section accordingly, Make all this text in this section rich text  also , allow me to change CTA Button size as width and height , allow me change all text color in this section as well
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .ai-hero-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-hero-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-hero-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_vertical }}px {{ block.settings.section_padding_horizontal }}px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }

  .ai-hero-left-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .ai-hero-eyebrow-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    line-height: 1.2;
  }

  .ai-hero-title-{{ ai_gen_id }} p,
  .ai-hero-title-{{ ai_gen_id }} h1,
  .ai-hero-title-{{ ai_gen_id }} h2,
  .ai-hero-title-{{ ai_gen_id }} h3,
  .ai-hero-title-{{ ai_gen_id }} h4,
  .ai-hero-title-{{ ai_gen_id }} h5,
  .ai-hero-title-{{ ai_gen_id }} h6 {
    margin: 0;
  }

  .ai-hero-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    line-height: 1.4;
  }

  .ai-hero-subheading-{{ ai_gen_id }} p,
  .ai-hero-subheading-{{ ai_gen_id }} h1,
  .ai-hero-subheading-{{ ai_gen_id }} h2,
  .ai-hero-subheading-{{ ai_gen_id }} h3,
  .ai-hero-subheading-{{ ai_gen_id }} h4,
  .ai-hero-subheading-{{ ai_gen_id }} h5,
  .ai-hero-subheading-{{ ai_gen_id }} h6 {
    margin: 0;
  }

  .ai-hero-content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_size }}px;
    color: {{ block.settings.content_color }};
    line-height: 1.6;
  }

  .ai-hero-content-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: {{ block.settings.button_width }}px;
    height: {{ block.settings.button_height }}px;
    font-size: {{ block.settings.button_size }}px;
    color: {{ block.settings.button_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    background: {{ block.settings.button_background }};
    backdrop-filter: blur({{ block.settings.button_blur }}px);
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
  }

  .ai-hero-cta-{{ ai_gen_id }}:hover {
    background: {{ block.settings.button_hover_background }};
    transform: translateY(-2px);
  }

  .ai-hero-trust-indicators-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    margin-top: 20px;
  }

  .ai-hero-trust-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    text-align: center;
  }

  .ai-hero-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.trust_icon_size }}px;
    height: {{ block.settings.trust_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-trust-icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-hero-trust-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-hero-trust-icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
  }

  .ai-hero-trust-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.trust_text_size }}px;
    color: {{ block.settings.trust_text_color }};
  }

  .ai-hero-trust-text-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-right-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
  }

  .ai-hero-event-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    backdrop-filter: blur({{ block.settings.card_blur }}px);
    border: {{ block.settings.card_border_width }}px solid {{ block.settings.card_border_color }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: 32px;
    max-width: 400px;
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-hero-event-label-{{ ai_gen_id }} {
    font-size: {{ block.settings.event_label_size }}px;
    color: {{ block.settings.event_label_color }};
    text-transform: uppercase;
    letter-spacing: 1px;
    opacity: 0.8;
  }

  .ai-hero-event-label-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-event-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.event_name_size }}px;
    color: {{ block.settings.event_name_color }};
    font-weight: 600;
  }

  .ai-hero-event-name-{{ ai_gen_id }} p,
  .ai-hero-event-name-{{ ai_gen_id }} h1,
  .ai-hero-event-name-{{ ai_gen_id }} h2,
  .ai-hero-event-name-{{ ai_gen_id }} h3,
  .ai-hero-event-name-{{ ai_gen_id }} h4,
  .ai-hero-event-name-{{ ai_gen_id }} h5,
  .ai-hero-event-name-{{ ai_gen_id }} h6 {
    margin: 0;
  }

  .ai-hero-event-date-{{ ai_gen_id }} {
    font-size: {{ block.settings.event_date_size }}px;
    color: {{ block.settings.event_date_color }};
  }

  .ai-hero-event-date-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-event-location-{{ ai_gen_id }} {
    font-size: {{ block.settings.event_location_size }}px;
    color: {{ block.settings.event_location_color }};
    line-height: 1.5;
  }

  .ai-hero-event-location-{{ ai_gen_id }} p {
    margin: 0;
  }

  .ai-hero-event-stall-{{ ai_gen_id }} {
    font-size: {{ block.settings.event_stall_size }}px;
    color: {{ block.settings.event_stall_color }};
    padding-top: 12px;
    border-top: 1px solid {{ block.settings.card_border_color }};
    font-weight: 600;
  }

  .ai-hero-event-stall-{{ ai_gen_id }} p {
    margin: 0;
  }

  @media screen and (max-width: 989px) {
    .ai-hero-container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 30px;
    }

    .ai-hero-right-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-hero-trust-indicators-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }

    .ai-hero-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.7 }}px;
    }

    .ai-hero-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.85 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-hero-section-{{ ai_gen_id }} {
      min-height: auto;
    }

    .ai-hero-container-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_vertical | times: 0.6 }}px {{ block.settings.section_padding_horizontal | times: 0.6 }}px;
    }

    .ai-hero-event-card-{{ ai_gen_id }} {
      padding: 24px;
    }
  }
{% endstyle %}

<div class="ai-hero-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-hero-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-container-{{ ai_gen_id }}">
    <div class="ai-hero-left-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="ai-hero-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}

      {% if block.settings.title != blank %}
        <div class="ai-hero-title-{{ ai_gen_id }}">{{ block.settings.title }}</div>
      {% endif %}

      {% if block.settings.subheading != blank %}
        <div class="ai-hero-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}

      {% if block.settings.content != blank %}
        <div class="ai-hero-content-{{ ai_gen_id }}">{{ block.settings.content }}</div>
      {% endif %}

      {% if block.settings.button_text != blank %}
        <a href="{{ block.settings.button_link }}" class="ai-hero-cta-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      {% endif %}

      <div class="ai-hero-trust-indicators-{{ ai_gen_id }}">
        {% for i in (1..4) %}
          {% liquid
            assign icon_key = 'trust_icon_' | append: i
            assign text_key = 'trust_text_' | append: i
            assign icon = block.settings[icon_key]
            assign text = block.settings[text_key]
          %}

          <div class="ai-hero-trust-item-{{ ai_gen_id }}">
            <div class="ai-hero-trust-icon-{{ ai_gen_id }}">
              {% if icon %}
                <img src="{{ icon | image_url: width: 200 }}" alt="{{ text | escape }}" loading="lazy">
              {% else %}
                <div class="ai-hero-trust-icon-placeholder-{{ ai_gen_id }}">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>
            {% if text != blank %}
              <div class="ai-hero-trust-text-{{ ai_gen_id }}">{{ text }}</div>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>

    <div class="ai-hero-right-{{ ai_gen_id }}">
      <div class="ai-hero-event-card-{{ ai_gen_id }}">
        {% if block.settings.event_label != blank %}
          <div class="ai-hero-event-label-{{ ai_gen_id }}">{{ block.settings.event_label }}</div>
        {% endif %}

        {% if block.settings.event_name != blank %}
          <div class="ai-hero-event-name-{{ ai_gen_id }}">{{ block.settings.event_name }}</div>
        {% endif %}

        {% if block.settings.event_date != blank %}
          <div class="ai-hero-event-date-{{ ai_gen_id }}">{{ block.settings.event_date }}</div>
        {% endif %}

        {% if block.settings.event_location != blank %}
          <div class="ai-hero-event-location-{{ ai_gen_id }}">{{ block.settings.event_location }}</div>
        {% endif %}

        {% if block.settings.event_stall != blank %}
          <div class="ai-hero-event-stall-{{ ai_gen_id }}">{{ block.settings.event_stall }}</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

