{% doc %}
  @prompt
    generate a full page width section with a background image, on which add eyebrow text, title, subheading, context , CTA Button, 4 trust indicators with icons, then on right bottom an event card as event name , date, location and stall no. follow glassmorphism for each element., remove glassmorph from title , eyebrow, sub heading , context and CTA Buttons as well then align all this elements in this section on left and event card on right , now allow me change size , corners, font size, color , font of every element in this section also align all this elements perfectly in this section., fix the position of each element correctly in this section every element must be aligned perfectly , paralelled, align event card paralally with trust indicators also add pulse glow on boarder of event card to highlight it also allow me to manager spacing between each and every element in this section also add hover to glow corners of every eleemnt in this section as CTA , trust indicators., make all this text as rich text in this section.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-hero-glassmorphism-{{ ai_gen_id }} {
    display: block;
    position: relative;
    width: 100%;
    min-height: {{ block.settings.section_height }}px;
    overflow: hidden;
  }

  .ai-hero-glassmorphism-background-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }

  .ai-hero-glassmorphism-background-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-hero-glassmorphism-background-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-hero-glassmorphism-background-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .ai-hero-glassmorphism-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-hero-glassmorphism-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 2;
  }

  .ai-hero-glassmorphism-content-{{ ai_gen_id }} {
    position: relative;
    z-index: 3;
    padding: {{ block.settings.section_padding }}px 40px;
    max-width: 1400px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: {{ block.settings.content_gap }}px;
    align-items: {{ block.settings.vertical_alignment }};
    min-height: {{ block.settings.section_height }}px;
  }

  .ai-hero-glassmorphism-main-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0;
  }

  .ai-hero-glassmorphism-text-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.text_max_width }}px;
  }

  .ai-hero-glassmorphism-eyebrow-{{ ai_gen_id }} {
    font-family: {{ block.settings.eyebrow_font.family }}, {{ block.settings.eyebrow_font.fallback_families }};
    font-weight: {{ block.settings.eyebrow_font.weight }};
    font-size: {{ block.settings.eyebrow_size }}px;
    color: {{ block.settings.eyebrow_color }};
    margin: 0 0 {{ block.settings.eyebrow_spacing }}px 0;
    text-transform: uppercase;
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    line-height: {{ block.settings.eyebrow_line_height }};
  }

  .ai-hero-glassmorphism-title-{{ ai_gen_id }} {
    font-family: {{ block.settings.title_font.family }}, {{ block.settings.title_font.fallback_families }};
    font-weight: {{ block.settings.title_font.weight }};
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: {{ block.settings.title_line_height }};
    letter-spacing: {{ block.settings.title_letter_spacing }}px;
  }

  .ai-hero-glassmorphism-subheading-{{ ai_gen_id }} {
    font-family: {{ block.settings.subheading_font.family }}, {{ block.settings.subheading_font.fallback_families }};
    font-weight: {{ block.settings.subheading_font.weight }};
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0 0 {{ block.settings.subheading_spacing }}px 0;
    line-height: {{ block.settings.subheading_line_height }};
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
  }

  .ai-hero-glassmorphism-context-{{ ai_gen_id }} {
    font-family: {{ block.settings.context_font.family }}, {{ block.settings.context_font.fallback_families }};
    font-weight: {{ block.settings.context_font.weight }};
    font-size: {{ block.settings.context_size }}px;
    color: {{ block.settings.context_color }};
    line-height: {{ block.settings.context_line_height }};
    letter-spacing: {{ block.settings.context_letter_spacing }}px;
    margin: 0 0 {{ block.settings.context_spacing }}px 0;
  }

  .ai-hero-glassmorphism-cta-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.cta_spacing }}px;
  }

  .ai-hero-glassmorphism-cta-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.cta_padding_vertical }}px {{ block.settings.cta_padding_horizontal }}px;
    background-color: {{ block.settings.cta_bg_color }};
    color: {{ block.settings.cta_text_color }};
    text-decoration: none;
    border-radius: {{ block.settings.cta_border_radius }}px;
    font-family: {{ block.settings.cta_font.family }}, {{ block.settings.cta_font.fallback_families }};
    font-weight: {{ block.settings.cta_font.weight }};
    font-size: {{ block.settings.cta_font_size }}px;
    letter-spacing: {{ block.settings.cta_letter_spacing }}px;
    transition: all 0.3s ease;
    border: {{ block.settings.cta_border_width }}px solid {{ block.settings.cta_border_color }};
    position: relative;
    overflow: hidden;
  }

  .ai-hero-glassmorphism-cta-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.cta_border_radius }}px;
    padding: {{ block.settings.cta_glow_width }}px;
    background: linear-gradient(45deg, {{ block.settings.cta_glow_color }}, transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-hero-glassmorphism-cta-{{ ai_gen_id }}:hover::before {
    opacity: {{ block.settings.cta_glow_opacity | divided_by: 100.0 }};
  }

  .ai-hero-glassmorphism-cta-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.cta_hover_bg_color }};
    color: {{ block.settings.cta_hover_text_color }};
    transform: translateY(-2px);
  }

  .ai-hero-glassmorphism-trust-indicators-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.trust_columns }}, 1fr);
    gap: {{ block.settings.trust_gap }}px;
    max-width: {{ block.settings.text_max_width }}px;
    margin-top: {{ block.settings.trust_spacing }}px;
  }

  .ai-hero-glassmorphism-trust-item-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, {{ block.settings.glass_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ block.settings.glass_blur }}px);
    border: {{ block.settings.trust_border_width }}px solid rgba(255, 255, 255, {{ block.settings.glass_border_opacity | divided_by: 100.0 }});
    border-radius: {{ block.settings.trust_border_radius }}px;
    padding: {{ block.settings.trust_padding }}px;
    display: flex;
    align-items: center;
    gap: {{ block.settings.trust_icon_gap }}px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.trust_border_radius }}px;
    padding: {{ block.settings.trust_glow_width }}px;
    background: linear-gradient(45deg, {{ block.settings.trust_glow_color }}, transparent);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}:hover::before {
    opacity: {{ block.settings.trust_glow_opacity | divided_by: 100.0 }};
  }

  .ai-hero-glassmorphism-trust-icon-{{ ai_gen_id }} {
    width: {{ block.settings.trust_icon_size }}px;
    height: {{ block.settings.trust_icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.trust_icon_color }};
  }

  .ai-hero-glassmorphism-trust-text-{{ ai_gen_id }} {
    font-family: {{ block.settings.trust_font.family }}, {{ block.settings.trust_font.fallback_families }};
    font-weight: {{ block.settings.trust_font.weight }};
    font-size: {{ block.settings.trust_text_size }}px;
    color: {{ block.settings.trust_text_color }};
    line-height: {{ block.settings.trust_line_height }};
    letter-spacing: {{ block.settings.trust_letter_spacing }}px;
  }

  .ai-hero-glassmorphism-right-section-{{ ai_gen_id }} {
    display: flex;
    align-items: {{ block.settings.event_vertical_position }};
    justify-content: {{ block.settings.event_horizontal_position }};
  }

  .ai-hero-glassmorphism-event-card-{{ ai_gen_id }} {
    background: rgba(255, 255, 255, {{ block.settings.event_glass_opacity | divided_by: 100.0 }});
    backdrop-filter: blur({{ block.settings.event_glass_blur }}px);
    border: {{ block.settings.event_border_width }}px solid rgba(255, 255, 255, {{ block.settings.event_glass_border_opacity | divided_by: 100.0 }});
    border-radius: {{ block.settings.event_border_radius }}px;
    padding: {{ block.settings.event_padding }}px;
    width: {{ block.settings.event_card_width }}px;
    position: relative;
    overflow: hidden;
  }

  {% if block.settings.event_pulse_enabled %}
  .ai-hero-glassmorphism-event-card-{{ ai_gen_id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    border-radius: {{ block.settings.event_border_radius }}px;
    padding: {{ block.settings.event_pulse_width }}px;
    background: linear-gradient(45deg, {{ block.settings.event_pulse_color }}, transparent, {{ block.settings.event_pulse_color }});
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: ai-pulse-glow-{{ ai_gen_id }} {{ block.settings.event_pulse_speed }}s ease-in-out infinite;
  }

  @keyframes ai-pulse-glow-{{ ai_gen_id }} {
    0%, 100% {
      opacity: {{ block.settings.event_pulse_opacity_min | divided_by: 100.0 }};
    }
    50% {
      opacity: {{ block.settings.event_pulse_opacity_max | divided_by: 100.0 }};
    }
  }
  {% endif %}

  .ai-hero-glassmorphism-event-name-{{ ai_gen_id }} {
    font-family: {{ block.settings.event_name_font.family }}, {{ block.settings.event_name_font.fallback_families }};
    font-weight: {{ block.settings.event_name_font.weight }};
    font-size: {{ block.settings.event_name_size }}px;
    color: {{ block.settings.event_name_color }};
    margin: 0 0 {{ block.settings.event_name_spacing }}px 0;
    line-height: {{ block.settings.event_name_line_height }};
    letter-spacing: {{ block.settings.event_name_letter_spacing }}px;
  }

  .ai-hero-glassmorphism-event-detail-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.event_icon_gap }}px;
    margin: 0 0 {{ block.settings.event_detail_spacing }}px 0;
    font-family: {{ block.settings.event_detail_font.family }}, {{ block.settings.event_detail_font.fallback_families }};
    font-weight: {{ block.settings.event_detail_font.weight }};
    font-size: {{ block.settings.event_detail_size }}px;
    color: {{ block.settings.event_detail_color }};
    line-height: {{ block.settings.event_detail_line_height }};
    letter-spacing: {{ block.settings.event_detail_letter_spacing }}px;
  }

  .ai-hero-glassmorphism-event-detail-{{ ai_gen_id }}:last-child {
    margin-bottom: 0;
  }

  .ai-hero-glassmorphism-event-icon-{{ ai_gen_id }} {
    width: {{ block.settings.event_icon_size }}px;
    height: {{ block.settings.event_icon_size }}px;
    flex-shrink: 0;
    color: {{ block.settings.event_icon_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-hero-glassmorphism-{{ ai_gen_id }} {
      min-height: {{ block.settings.section_height_mobile }}px;
    }

    .ai-hero-glassmorphism-content-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      min-height: {{ block.settings.section_height_mobile }}px;
      gap: 40px;
      padding: {{ block.settings.section_padding }}px 20px;
    }

    .ai-hero-glassmorphism-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
    }

    .ai-hero-glassmorphism-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size_mobile }}px;
    }

    .ai-hero-glassmorphism-trust-indicators-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.trust_columns_mobile }}, 1fr);
    }

    .ai-hero-glassmorphism-right-section-{{ ai_gen_id }} {
      justify-content: center;
    }

    .ai-hero-glassmorphism-event-card-{{ ai_gen_id }} {
      width: 100%;
      max-width: 400px;
    }
  }
{% endstyle %}

<glassmorphism-hero-{{ ai_gen_id }} class="ai-hero-glassmorphism-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-hero-glassmorphism-background-{{ ai_gen_id }}">
    {% if block.settings.background_image %}
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    {% else %}
      <div class="ai-hero-glassmorphism-background-placeholder-{{ ai_gen_id }}">
        {{ 'hero-apparel-1' | placeholder_svg_tag }}
        <div class="ai-hero-glassmorphism-empty-state-{{ ai_gen_id }}">
          Add a background image to get started
        </div>
      </div>
    {% endif %}
  </div>

  <div class="ai-hero-glassmorphism-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-hero-glassmorphism-content-{{ ai_gen_id }}">
    <div class="ai-hero-glassmorphism-main-content-{{ ai_gen_id }}">
      <div class="ai-hero-glassmorphism-text-wrapper-{{ ai_gen_id }}">
        {% if block.settings.eyebrow_text != blank %}
          <div class="ai-hero-glassmorphism-eyebrow-{{ ai_gen_id }}">
            {{ block.settings.eyebrow_text }}
          </div>
        {% endif %}

        {% if block.settings.title != blank %}
          <div class="ai-hero-glassmorphism-title-{{ ai_gen_id }}">
            {{ block.settings.title }}
          </div>
        {% endif %}

        {% if block.settings.subheading != blank %}
          <div class="ai-hero-glassmorphism-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}

        {% if block.settings.context != blank %}
          <div class="ai-hero-glassmorphism-context-{{ ai_gen_id }}">
            {{ block.settings.context }}
          </div>
        {% endif %}
      </div>

      {% if block.settings.cta_text != blank %}
        <div class="ai-hero-glassmorphism-cta-wrapper-{{ ai_gen_id }}">
          <a href="{{ block.settings.cta_link }}" class="ai-hero-glassmorphism-cta-{{ ai_gen_id }}">
            {{ block.settings.cta_text }}
          </a>
        </div>
      {% endif %}

      <div class="ai-hero-glassmorphism-trust-indicators-{{ ai_gen_id }}">
        {% if block.settings.trust_1_text != blank %}
          <div class="ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-trust-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
              </svg>
            </div>
            <div class="ai-hero-glassmorphism-trust-text-{{ ai_gen_id }}">
              {{ block.settings.trust_1_text }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.trust_2_text != blank %}
          <div class="ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-trust-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
            </div>
            <div class="ai-hero-glassmorphism-trust-text-{{ ai_gen_id }}">
              {{ block.settings.trust_2_text }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.trust_3_text != blank %}
          <div class="ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-trust-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
              </svg>
            </div>
            <div class="ai-hero-glassmorphism-trust-text-{{ ai_gen_id }}">
              {{ block.settings.trust_3_text }}
            </div>
          </div>
        {% endif %}

        {% if block.settings.trust_4_text != blank %}
          <div class="ai-hero-glassmorphism-trust-item-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-trust-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2L2 7l10 5 10-5-10-5z"></path>
                <path d="M2 17l10 5 10-5M2 12l10 5 10-5"></path>
              </svg>
            </div>
            <div class="ai-hero-glassmorphism-trust-text-{{ ai_gen_id }}">
              {{ block.settings.trust_4_text }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="ai-hero-glassmorphism-right-section-{{ ai_gen_id }}">
      <div class="ai-hero-glassmorphism-event-card-{{ ai_gen_id }}">
        {% if block.settings.event_name != blank %}
          <div class="ai-hero-glassmorphism-event-name-{{ ai_gen_id }}">
            {{ block.settings.event_name }}
          </div>
        {% endif %}

        {% if block.settings.event_date != blank %}
          <div class="ai-hero-glassmorphism-event-detail-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-event-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <line x1="16" y1="2" x2="16" y2="6"></line>
                <line x1="8" y1="2" x2="8" y2="6"></line>
                <line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
            </div>
            <span>{{ block.settings.event_date }}</span>
          </div>
        {% endif %}

        {% if block.settings.event_location != blank %}
          <div class="ai-hero-glassmorphism-event-detail-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-event-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <span>{{ block.settings.event_location }}</span>
          </div>
        {% endif %}

        {% if block.settings.event_stall != blank %}
          <div class="ai-hero-glassmorphism-event-detail-{{ ai_gen_id }}">
            <div class="ai-hero-glassmorphism-event-icon-{{ ai_gen_id }}">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
            </div>
            <span>{{ block.settings.event_stall }}</span>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</glassmorphism-hero-{{ ai_gen_id }}>

<script>
  (function() {
    class GlassmorphismHero{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('glassmorphism-hero-{{ ai_gen_id }}', GlassmorphismHero{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Glassmorphism hero",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Desktop height",
      "min": 400,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 700
    },
    {
      "type": "range",
      "id": "section_height_mobile",
      "label": "Mobile height",
      "min": 400,
      "max": 800,
      "step": 50,
      "unit": "px",
      "default": 600
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 20,
      "max": 100,
      "step": 10,
      "unit": "px",
      "default": 60
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
